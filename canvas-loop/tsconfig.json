{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*", "examples/**/*", "gallery/**/*", "test/**/*"],
  "exclude": ["node_modules", "out", "gallery/out", "src/react", "**/*.tsx", "test/mount.test.ts", "test/figure-hardening.test.ts", "test/mount-failure-paths.test.ts", "test/fake-dom.ts"]
}
