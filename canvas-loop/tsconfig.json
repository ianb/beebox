{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["eslint.config.ts", "src/**/*", "test/**/*"],
  "exclude": ["node_modules", "out", "src/gallery/out", "src/react", "src/exports", "src/browser", "src/dev-demo", "**/*.tsx", "test/browser/mount.test.ts", "test/react/SketchFigure.hardening.test.ts", "test/browser/mount.failure-paths.test.ts", "test/browser/fake-dom.ts"]
}
