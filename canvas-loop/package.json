{
  "name": "@ianbicking/canvas-loop",
  "version": "0.1.0",
  "description": "Deterministic, browser-less, frame-stepped Canvas2D sandbox for agent programming",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/exports/core.ts",
      "default": "./src/exports/core.ts"
    },
    "./headless": {
      "types": "./src/exports/headless.ts",
      "default": "./src/exports/headless.ts"
    },
    "./react": {
      "types": "./src/exports/react.ts",
      "default": "./src/exports/react.ts"
    },
    "./browser": {
      "types": "./src/browser/mount.ts",
      "default": "./src/browser/mount.ts"
    },
    "./browser/figure.css": "./src/browser/figure.css",
    "./eslint": {
      "types": "./src/eslint/plugin.ts",
      "default": "./src/eslint/plugin.ts"
    }
  },
  "scripts": {
    "cli": "node --import tsx src/headless/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/browser/tsconfig.json && tsc --noEmit -p src/react/tsconfig.json && tsc --noEmit -p src/dev-demo/tsconfig.json && tsc --noEmit -p src/exports/tsconfig.json",
    "lint": "eslint .",
    "test": "TSX_TSCONFIG_PATH=src/react/tsconfig.json node --import tsx --test",
    "build:playground": "node --import tsx src/browser/build.ts",
    "build:dev-demo": "node --import tsx src/dev-demo/build.ts",
    "gallery:check": "node --import tsx src/headless/cli.ts gallery check"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.2",
    "yaml": "^2.7.0"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ianbicking/personal-vibe-check": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.2",
    "linkedom": "^0.18.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
