{
  "name": "browse",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Worktree-aware browser CLI for this monorepo. Wraps agent-browser with URL translation, screenshot metadata, and a typed sub-package for the upstream CLI surface. Access point: bin/browse at the monorepo root.",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "verify-help": "tsx packages/agent-browser-typed/src/scripts/verify-help.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tap"
  },
  "dependencies": {
    "agent-browser-typed": "workspace:*"
  },
  "devDependencies": {
    "@ianbicking/personal-vibe-check": "workspace:*",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@ianbicking/tap-check": "workspace:*",
    "eslint": "^9.39.2",
    "tap": "^21.0.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
