plugin:
  - "!@tapjs/typescript"
node-arg:
  - --import=tsx
  - --import=@ianbicking/tap-check/tap
include:
  # t.check tests only, `browse`'s own and its `agent-browser-typed` sub-package's:
  # that package has no test/typecheck/lint scripts of its own
  # (bin/workspace-packages.ts), so `browse`'s whole-tree checks are what cover
  # it, exactly like its `tsc --noEmit` and `eslint .` already do.
  - test/**/*.test.ts
  - packages/*/test/**/*.test.ts
reporter: tap
color: false
disable-coverage: true
