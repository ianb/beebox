# Docker build context is the MONOREPO ROOT (beebox/docker/Dockerfile
# needs the whole workspace to build the release tarball). Keep the context
# small: node_modules and build outputs are regenerated inside the image, and
# .git / boxes / scratch are never needed at build time.

# Dependencies — reinstalled in the build stage.
**/node_modules

# Git metadata.
.git
.gitignore
**/.gitignore

# Build outputs — regenerated by the release build.
dist
beebox/dist
beebox/dist-release
beebox/src/frontend/dist

# Boxes of any kind must never enter the image (they carry a box's own
# CLAUDE.md and private content). None live under the repo, but guard anyway.
**/boxes
box-worktrees
callback-worktrees

# The docker/ dir itself is never needed inside the image EXCEPT entrypoint.sh
# (which is COPYed in). Excluding the rest keeps Dockerfile/compose/doc edits
# from invalidating the slow build stage's `COPY . .`.
beebox/docker/*
!beebox/docker/entrypoint.sh

# Deploy checkout + lock state.
.deploy-checkout
.deploy-requested
.deploy-checkout.lock

# Editor / OS / logs / scratch.
scratch
**/*.log
**/.DS_Store
.claude/projects
ios-app/build
