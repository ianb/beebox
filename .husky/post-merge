#!/usr/bin/env bash
# Monorepo post-merge hook.
#
# Auto-deploys to prod when a merge updates main — fast-forward OR
# merge-commit. post-commit alone misses fast-forwards (they move HEAD
# without creating a commit object, so post-commit never fires). Both
# hooks coordinate via the merge-commit check: post-commit skips merge
# commits, post-merge handles them, so non-FF merges don't double-deploy.

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BRANCH=$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

if [ "$BRANCH" = "main" ]; then
  echo "[post-merge] Deploying to server (branch: main)..."
  "$REPO_DIR/callback-box/deploy/deploy.sh" &>"$REPO_DIR/callback-box/deploy/.last-deploy.log" &
  disown
  echo "[post-merge] Deploy started in background (log: callback-box/deploy/.last-deploy.log)"

  # Rebuild the clerk extension if its sources changed in this merge.
  "$REPO_DIR/callback-clerk/build/auto-build.sh" ORIG_HEAD HEAD || true
else
  echo "[post-merge] Skip deploy: branch is '$BRANCH' (deploys only run from 'main')"
fi

# Rebuild cardworks if its sources changed in this merge. Dependents
# (callback-box tests, the dev server, typecheck) import cardworks via its
# gitignored dist/, so merging main into a worktree refreshes cardworks/src
# without rebuilding dist — leaving everything on stale behavior, which shows
# up as confusing "flaky"-looking test failures. Runs on every branch (a
# worktree is exactly where this bites, and worktrees aren't 'main'), and
# rebuilds in the worktree the merge happened in (GIT_WORK_TREE via
# --show-toplevel), not $REPO_DIR — which always points at the main checkout.
if git diff --name-only ORIG_HEAD HEAD -- cardworks/src 2>/dev/null | grep -q .; then
  TOPLEVEL="$(git rev-parse --show-toplevel)"
  echo "[post-merge] cardworks sources changed; rebuilding dist..."
  ( cd "$TOPLEVEL" && pnpm --filter cardworks run build ) \
    || echo "[post-merge] cardworks rebuild failed — run 'pnpm --filter cardworks build' manually"
fi

# Let git-lfs do its post-merge work.
command -v git-lfs >/dev/null 2>&1 && git lfs post-merge "$@" || true
