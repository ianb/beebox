#!/usr/bin/env bash
# Monorepo post-merge hook.
#
# Auto-deploys to prod when a merge updates main — fast-forward OR
# merge-commit. post-commit alone misses fast-forwards (they move HEAD
# without creating a commit object, so post-commit never fires). Both
# hooks coordinate via the merge-commit check: post-commit skips merge
# commits, post-merge handles them, so non-FF merges don't double-deploy.

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BRANCH=$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

# A merged lockfile can make the existing node_modules unusable immediately:
# bin/cb rebuilds its externalized CLI bundle against the new dependency graph,
# then Node cannot resolve packages that the old install never contained. Do
# this for every checkout, before deploy/build work. The hook cannot change a
# completed merge's outcome, so a failure warns on stderr and deploy continues.
if [ "${1:-0}" = "1" ]; then
  # A squash merge changes the index/worktree without moving HEAD.
  "$REPO_DIR/bin/post-merge-install.sh" "$REPO_DIR" HEAD WORKTREE || true
else
  "$REPO_DIR/bin/post-merge-install.sh" "$REPO_DIR" ORIG_HEAD HEAD || true
fi

# Rebuild this checkout's CLI bundle if the merge moved a bundle input. Every
# checkout, not just main: the bundle is per-checkout dev state, and until this
# ran on its own a merged fix kept being served by a box child still on the old
# bundle. After post-merge-install.sh, which may have changed the dep graph the
# bundle externalizes.
if [ "${1:-0}" = "1" ]; then
  "$REPO_DIR/callback-box/scripts/auto-build-cli.sh" HEAD WORKTREE || true
else
  "$REPO_DIR/callback-box/scripts/auto-build-cli.sh" ORIG_HEAD HEAD || true
fi

if [ "$BRANCH" = "main" ]; then
  # Only deploy when the merge actually changed something deploy.sh ships (see
  # post-commit / callback-box/deploy/deploy.sh): callback-box, agent-doctest,
  # personal-vibe-check, patches/, root pnpm files. A merge confined to issues/,
  # callback-clerk/, ios-app/, research/, bin/, root docs, etc. ships nothing.
  # Fail OPEN: if the merge's file list can't be computed, deploy rather than
  # risk silently skipping a real ship (the failure mode we're guarding against).
  merge_changed=$(git -C "$REPO_DIR" diff --name-only ORIG_HEAD HEAD 2>/dev/null || echo "callback-box/__diff_failed__")
  if ! printf '%s\n' "$merge_changed" | grep -qE '^(callback-box|agent-doctest|personal-vibe-check|patches)/|^(package\.json|pnpm-workspace\.yaml|\.npmrc|pnpm-lock\.yaml)$'; then
    echo "[post-merge] Skip deploy: merge touches no deployed path (callback-box/, agent-doctest/, personal-vibe-check/, patches/, root pnpm files)"
  elif [ ! -s "$REPO_DIR/callback-box/deploy/server-ip" ]; then
    echo "[post-merge] ⚠ NOT deploying — callback-box/deploy/server-ip is missing" >&2
    echo "[post-merge]   (gitignored; lost in a repo move?). Nothing shipped — restore it." >&2
  else
    # Capture the post-merge HEAD and deploy exactly that sha, so a commit landed
    # while the (backgrounded) deploy runs can't change what ships.
    SHA=$(git -C "$REPO_DIR" rev-parse HEAD)
    # Per-run log: a shared .last-deploy.log gets truncated by the next deploy
    # while the first is still writing (a real observability bug). Write each run
    # to its own timestamped file and repoint .last-deploy.log at it as a RELATIVE
    # symlink, so the documented `tail .last-deploy.log` poll keeps working. Prune
    # to the newest 20 logs.
    LOG_DIR="$REPO_DIR/callback-box/deploy/.deploy-logs"
    mkdir -p "$LOG_DIR"
    LOG_FILE="$LOG_DIR/$(date -u +%Y%m%dT%H%M%SZ)-${SHA:0:8}.log"
    ln -sfn ".deploy-logs/$(basename "$LOG_FILE")" "$REPO_DIR/callback-box/deploy/.last-deploy.log"
    ls -1t "$LOG_DIR"/*.log 2>/dev/null | tail -n +21 | while IFS= read -r old; do rm -f "$old"; done
    echo "[post-merge] Deploying to server (branch: main, ref: ${SHA:0:8})..."
    "$REPO_DIR/callback-box/deploy/deploy.sh" --ref "$SHA" &>"$LOG_FILE" &
    disown
    echo "[post-merge] Deploy started in background — notifies on failure (log: callback-box/deploy/.last-deploy.log)"
  fi

  # Rebuild the clerk extension if its sources changed in this merge.
  "$REPO_DIR/callback-clerk/build/auto-build.sh" ORIG_HEAD HEAD || true

  # NOTE: worktree auto-sweep deliberately does NOT run here. It calls
  # `git worktree prune`, which is not concurrency-safe against the deploy we
  # just backgrounded above — it corrupts the deploy's `.deploy-checkout`
  # registration mid-creation and fails the prod deploy. Worktree cleanup runs
  # on SessionStart instead (see .claude/hooks/auto-sweep.sh). Re-adding a
  # post-merge sweep needs a shared lock serializing it against the deploy's
  # git-worktree ops first.
else
  echo "[post-merge] Skip deploy: branch is '$BRANCH' (deploys only run from 'main')"
fi

# Let git-lfs do its post-merge work.
if command -v git-lfs >/dev/null 2>&1; then
  git lfs post-merge "$@" || true
else
  echo "warning: git-lfs not found — media files will not be handled (see callback-box/docs/developer-install.md)" >&2
fi
