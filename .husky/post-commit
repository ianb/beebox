#!/usr/bin/env bash
# Monorepo post-commit hook.
#
# 1. Auto-deploy to prod server — ONLY from main. Worktrees on other
#    branches skip the deploy (they commit safely without shipping).
# 2. Clean up architecture-doc PNG backup files for images that were
#    just committed (callback-box-specific, kept here so a single root
#    post-commit handles everything).
#
# Lives at the monorepo root for the same reason as pre-commit (one
# husky setup at root, hooks fire from any worktree via shared
# core.hooksPath).

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BRANCH=$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

# 1. Auto-deploy (callback-box ships to prod) — only from main.
# Skip merge commits: post-merge handles all merges (including fast-forwards
# which don't fire post-commit at all). Letting post-commit also deploy on
# merge commits would double-fire for non-FF merges.
if [ "$BRANCH" = "main" ]; then
  if git -C "$REPO_DIR" rev-parse --verify --quiet HEAD^2 >/dev/null; then
    echo "[post-commit] Skip deploy: merge commit (post-merge handles it)"
  # Only deploy when the commit actually touched something deploy.sh ships (see
  # callback-box/deploy/deploy.sh): the synced workspace members
  # (callback-box, agent-doctest, personal-vibe-check), patches/, and the root
  # pnpm files. A commit confined to issues/, callback-clerk/, ios-app/,
  # research/, bin/, root docs, etc. changes nothing on the server — skip it.
  elif ! git -C "$REPO_DIR" diff-tree --no-commit-id --name-only -r HEAD \
      | grep -qE '^(callback-box|agent-doctest|personal-vibe-check|patches)/|^(package\.json|pnpm-workspace\.yaml|\.npmrc|pnpm-lock\.yaml)$'; then
    echo "[post-commit] Skip deploy: commit touches no deployed path (callback-box/, agent-doctest/, personal-vibe-check/, patches/, root pnpm files)"
    # The clerk extension still self-gates on its own sources below.
    "$REPO_DIR/callback-clerk/build/auto-build.sh" || true
  else
    if [ ! -s "$REPO_DIR/callback-box/deploy/server-ip" ]; then
      # Pre-flight the one prerequisite that silently killed a whole run of
      # deploys after a repo move. Fail visibly here (in the commit output),
      # rather than backgrounding a deploy that dies on line 1 into a log
      # nobody reads. deploy.sh also guards this, but this surfaces it now.
      echo "[post-commit] ⚠ NOT deploying — callback-box/deploy/server-ip is missing" >&2
      echo "[post-commit]   (gitignored; lost in a repo move?). Nothing shipped — restore it." >&2
    else
      # Capture the trigger-time HEAD and deploy exactly that sha, so a commit
      # landed while the (backgrounded) deploy runs can't change what ships.
      SHA=$(git -C "$REPO_DIR" rev-parse HEAD)
      # Per-run log: a shared .last-deploy.log gets truncated by the next deploy
      # while the first is still writing (a real observability bug). Write each
      # run to its own timestamped file and repoint .last-deploy.log at it as a
      # RELATIVE symlink, so the documented `tail .last-deploy.log` poll keeps
      # working. Prune to the newest 20 logs.
      LOG_DIR="$REPO_DIR/callback-box/deploy/.deploy-logs"
      mkdir -p "$LOG_DIR"
      LOG_FILE="$LOG_DIR/$(date -u +%Y%m%dT%H%M%SZ)-${SHA:0:8}.log"
      ln -sfn ".deploy-logs/$(basename "$LOG_FILE")" "$REPO_DIR/callback-box/deploy/.last-deploy.log"
      ls -1t "$LOG_DIR"/*.log 2>/dev/null | tail -n +21 | while IFS= read -r old; do rm -f "$old"; done
      echo "[post-commit] Deploying to server (branch: main, ref: ${SHA:0:8})..."
      "$REPO_DIR/callback-box/deploy/deploy.sh" --ref "$SHA" &>"$LOG_FILE" &
      disown
      echo "[post-commit] Deploy started in background — notifies on failure (log: callback-box/deploy/.last-deploy.log)"
    fi

    # Rebuild the clerk extension if its sources changed in this commit.
    "$REPO_DIR/callback-clerk/build/auto-build.sh" || true
  fi
else
  echo "[post-commit] Skip deploy: branch is '$BRANCH' (deploys only run from 'main')"
fi

# 2. Clean up .bak.png files for architecture-doc images that were just committed.
committed_images=$(git -C "$REPO_DIR" diff-tree --no-commit-id --name-only -r HEAD -- 'callback-box/docs/architecture/images/*.png' | grep -v '\.bak\.png$' || true)
if [ -n "$committed_images" ]; then
  for img in $committed_images; do
    base="${img%.png}"
    for bak in "$REPO_DIR"/"${base}".*.bak.png; do
      [ -f "$bak" ] && rm "$bak" && echo "[post-commit] Cleaned up $(basename "$bak")"
    done
    mermaid_bak="$REPO_DIR/${base}.mermaid.bak.png"
    [ -f "$mermaid_bak" ] && rm "$mermaid_bak" && echo "[post-commit] Cleaned up $(basename "$mermaid_bak")"
  done
fi

# 3. Let git-lfs do its post-commit work (cleans up pointer-tracking state).
if command -v git-lfs >/dev/null 2>&1; then
  git lfs post-commit "$@" || true
else
  echo "warning: git-lfs not found — media files will not be handled (see callback-box/docs/developer-install.md)" >&2
fi
