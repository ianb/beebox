#!/usr/bin/env bash
# Monorepo pre-commit dispatcher.
#
# Each subproject used to have its own .husky/pre-commit (lint-staged +
# typecheck). After the monorepo migration each subproject lost its own
# .git, so those individual husky setups silently stopped working. This
# dispatcher restores the same checks, scoped to whichever subprojects
# have staged changes.
#
# Lives at the monorepo root because core.hooksPath in .git/config (set
# to .husky/_/ by `pnpm install` in the root) is shared across all
# worktrees via git's common dir.

set -e

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# The commit index: what this commit records. git hands a plain commit a
# relative `.git/index`, and the checks below change directory.
case "${GIT_INDEX_FILE:-}" in
  "") GIT_INDEX_FILE="$(git -C "$REPO_DIR" rev-parse --path-format=absolute --git-path index)" ;;
  /*) ;;
  *) GIT_INDEX_FILE="$REPO_DIR/$GIT_INDEX_FILE" ;;
esac
export GIT_INDEX_FILE

# Every check below runs in the staged snapshot (bin/staged-snapshot.ts): the
# commit index's files and nothing else from the working tree but node_modules,
# so another agent's unstaged deletion, rename, half-written file, or new doc
# neither fails nor passes this commit. The EXIT trap fails a passing hook if the
# commit index or the snapshot changed while the checks ran. Every staged-path
# decision reads the snapshot index, so it matches the captured tree.
CHECKOUT_DIR="$REPO_DIR"
COMMIT_INDEX="$GIT_INDEX_FILE"
snapshot="$(cd "$CHECKOUT_DIR" && node --import tsx bin/staged-snapshot.ts sync --owner $$)"
IFS=$'\t' read -r SNAPSHOT_TREE SNAPSHOT_INDEX CAPTURED_TREE <<<"$snapshot"
finish_snapshot() {
  local rc=$?
  (cd "$CHECKOUT_DIR" && GIT_INDEX_FILE="$COMMIT_INDEX" node --import tsx bin/staged-snapshot.ts finish \
    --owner $$ --tree "$CAPTURED_TREE" --index "$COMMIT_INDEX" --status "$rc") || rc=1
  exit "$rc"
}
trap finish_snapshot EXIT
export GIT_INDEX_FILE="$SNAPSHOT_INDEX" GIT_OPTIONAL_LOCKS=0
unset GIT_DIR GIT_WORK_TREE
REPO_DIR="$SNAPSHOT_TREE"
echo "[pre-commit] checking the staged snapshot at $REPO_DIR"
staged="$(git -C "$REPO_DIR" diff --cached --name-only --diff-filter=ACMR)"

# The personal commit-blocklist guard reads the gitignored .commit-blocklist,
# so it runs from the checkout (the snapshot's copy of the script, against the
# snapshot index); it reads only staged additions. A no-op unless the committer
# has that file. Blocks staged additions that re-introduce purged strings (a
# domain, an IP, names).
echo "[pre-commit] .: commit-blocklist-check"
(cd "$CHECKOUT_DIR" && node --import tsx "$REPO_DIR/bin/commit-blocklist-check.ts")

# Block retired product vocabulary outside the exact historical and migration
# allowlist. The checker is silent when the baseline is clean.
(cd "$REPO_DIR" && pnpm --silent retired-product-name-check)

# Fast, offline security guards over staged content: private keys, unresolved
# merge markers, and shellcheck for staged hook/bin shell files only.
echo "[pre-commit] .: staged security checks"
(cd "$REPO_DIR" && node --import tsx bin/precommit-security.ts)

run_in() {
  local dir="$1"; shift
  echo "[pre-commit] $dir: $*"
  (cd "$REPO_DIR/$dir" && "$@")
}

# lint-staged and typecheck are independent and each ~2.5s of program load;
# running them together takes a warm code commit from ~7s to ~5s. Output is
# captured per command and replayed in order so failures read the same as
# before; the exit status is non-zero if either failed.
run_pair() {
  local dir="$1" a="$2" b="$3" out_a out_b rc_a rc_b pid_a pid_b
  out_a="$(mktemp)"; out_b="$(mktemp)"
  echo "[pre-commit] $dir: $a  ||  $b"
  (cd "$REPO_DIR/$dir" && eval "$a") >"$out_a" 2>&1 & pid_a=$!
  (cd "$REPO_DIR/$dir" && eval "$b") >"$out_b" 2>&1 & pid_b=$!
  # `|| rc=$?` keeps `set -e` from aborting before the captured output prints.
  rc_a=0; wait "$pid_a" || rc_a=$?
  rc_b=0; wait "$pid_b" || rc_b=$?
  cat "$out_a" "$out_b"; rm -f "$out_a" "$out_b"
  [ "$rc_a" -eq 0 ] && [ "$rc_b" -eq 0 ]
}

# Every commit runs the home-directory leak guard (fast, full-tree git grep).
# Before the docs-only early-exit below: docs are the main leak surface.
echo "[pre-commit] .: pnpm path-leak-check"
(cd "$REPO_DIR" && pnpm path-leak-check)

# Mobile-contract tripwire (pre-commit half): records a pending violation when a
# contract-surface anchor file is staged without a docs/mobile-contract.md
# update, so the commit-msg hook can enforce the Contract-Unchanged: override.
# Fast (plain git + fs); never blocks here — the block lives in commit-msg.
echo "[pre-commit] .: pnpm mobile-contract-check"
(cd "$REPO_DIR" && pnpm --silent mobile-contract-check)

# Validate the complete candidate index, rather than the working tree, so a
# partially staged plan move cannot land a status/directory mismatch.
echo "[pre-commit] .: document lifecycle check"
(cd "$REPO_DIR" && node --import tsx bin/doc-lifecycle-check.ts --index)

# A schedule that fails lint is a schedule that fails at 03:00 on a Sunday with
# nobody watching, so the check happens at commit time. Silent on success; one
# line per finding otherwise. schedules/ is outside every package's lint, so
# nothing else covers it (scheduled-workstreams.md, Track E).
#
# Placed BEFORE the docs-only exit and computed from its own staged list: a
# commit that only edits schedules/<name>/prompt.md is all-Markdown but is a
# schedule change (the prompt carries the reporting contract), and a commit that
# only DELETES a schedule's `run` is exactly the breakage the lint catches —
# neither reaches the ACMR list this hook otherwise works from.
staged_schedules="$(git -C "$REPO_DIR" diff --cached --name-only -- schedules)"
if [ -n "$staged_schedules" ]; then
  echo "[pre-commit] .: bin/schedules lint"
  (cd "$REPO_DIR" && bin/schedules lint)
fi

# Skills and subagents: frontmatter, size, sigils, and backticked paths
# (bin/skill-lint.ts). Before the docs-only exit, since a SKILL.md edit is
# all-Markdown; deletions count, since removing a reference file can strand a path.
# --quiet keeps informational findings out of the hook.
staged_claude="$(git -C "$REPO_DIR" diff --cached --name-only -- .claude)"
if [ -n "$staged_claude" ]; then
  echo "[pre-commit] .: bin/skill-lint"
  (cd "$REPO_DIR" && node --import tsx bin/skill-lint.ts --quiet)
fi

# Any commit touching markdown runs the fast doc reference/orphan check.
if echo "$staged" | grep -q '\.md$'; then
  run_in beebox pnpm doc-check
# An engine change with no doc staged can still break site/docs/ links: moving
# a card type into a plugin deletes its generated reference page. Deletions
# count, so this reads its own staged list.
elif git -C "$REPO_DIR" diff --cached --name-only -- beebox/src | grep -q .; then
  run_in beebox pnpm --silent doc-check --site-reference
fi

# Source file layout (beebox/docs/plans/file-layout.md): every package root
# must stay at zero findings. The whole repo scans in a few seconds; there is no
# changed-files mode, since a change in one directory can create a finding in
# another. Also runs on deletions: removing a file can leave a registry stale.
layout_staged="$(git -C "$REPO_DIR" diff --cached --name-only --diff-filter=ACMRD)"
if echo "$layout_staged" | grep -qE '\.(ts|tsx|mts|cts|js|mjs|cjs)$|(^|/)package\.json$'; then
  run_in beebox pnpm --silent layout-check
fi

# Docs-only commits need nothing further — typecheck/lint add nothing.
if [ -n "$staged" ] && ! echo "$staged" | grep -qv '\.md$'; then
  exit 0
fi

# Clerk contract staleness gate. The dispatcher runs the per-subtree checks
# below independently, so a beebox-only change to the clerk wire shape
# never exercises the clerk side — this branch closes that gap. It fires when
# the staged set touches the leaf schema, the generator, the generated
# snapshot, or this hook itself; it regenerates and diffs ONLY the generated
# path (a bare `git diff` would trip over sibling agents' unrelated edits in a
# shared checkout). Recorded accepted misses: a zod or TS version bump can
# alter emission — mitigated by the deterministic-generator test and the
# printer's whitelist-throw, plus a full regenerate whenever the contract is
# touched. Scope caveat: this whole subtree ships across a store release, so a
# store-version skew gate is deliberately out of scope (runtime validation in
# clerk-api.ts handles deployed skew by degradation).
if echo "$staged" | grep -qE '^(beebox/src/webapp/trpc/clerk-contract\.ts|bin/snapshot-clerk-contract\.ts|beebox-clerk/src/contract/clerk-contract\.generated\.ts|\.husky/pre-commit)$'; then
  echo "[pre-commit] .: pnpm snapshot:clerk-contract (clerk contract staleness gate)"
  (cd "$REPO_DIR" && pnpm --silent snapshot:clerk-contract)
  if ! git -C "$REPO_DIR" diff --exit-code -- beebox-clerk/src/contract/clerk-contract.generated.ts; then
    echo "[pre-commit] clerk contract is stale — regenerate and stage it:" >&2
    echo "[pre-commit]   pnpm snapshot:clerk-contract && git add beebox-clerk/src/contract/clerk-contract.generated.ts" >&2
    exit 1
  fi
fi

# --no-stash and --no-hide-partially-staged: the snapshot has no unstaged
# hunks, so lint-staged has nothing to hide or stash; its stash path also does
# `git reset --hard HEAD` on failure. Both configs are check-only eslint (no
# --fix). --quiet: suppress lint-staged's own progress/warning chatter; task
# output (eslint errors) still prints on failure.
#
# Generated inputs come from the snapshot: type-aware eslint resolves
# `beebox/plugins/*` through dist/ declarations (beebox/package.json exports),
# which `pnpm typecheck` builds, so beebox lints after its typecheck rather than
# beside it; the clerk tsconfig extends .wxt/tsconfig.json.
if echo "$staged" | grep -q '^beebox/'; then
  run_in beebox pnpm typecheck
  run_in beebox pnpm exec lint-staged --no-stash --no-hide-partially-staged --quiet
fi

if echo "$staged" | grep -q '^beebox-clerk/'; then
  # wxt prints progress on success; show it only when it fails.
  echo "[pre-commit] beebox-clerk: wxt prepare"
  wxt_out="$(cd "$REPO_DIR/beebox-clerk" && pnpm exec wxt prepare 2>&1)" || { echo "$wxt_out"; exit 1; }
  run_pair beebox-clerk "pnpm exec lint-staged --no-stash --no-hide-partially-staged --quiet" "pnpm typecheck"
fi

# The generated site is a top-level package invisible to the beebox/clerk
# branches above. No lint-staged here (small package, no config) — lint + type
# the whole thing. A content-only (.md) commit exits early above, so this only
# fires when TS/config under site/ changed.
if echo "$staged" | grep -q '^site/'; then
  run_in site pnpm lint
  run_in site pnpm typecheck
fi

if echo "$staged" | grep -q '^workstreams-app/'; then
  run_in workstreams-app pnpm lint
  run_in workstreams-app pnpm typecheck
  ws_app_typechecked=1
fi

# The shared lint preset lints and type-checks itself
# (issues/code-quality/2026-07-29-personal-vibe-check-no-self-lint.md).
if echo "$staged" | grep -q '^personal-vibe-check/'; then
  run_pair personal-vibe-check "pnpm --silent lint" "pnpm --silent typecheck"
fi

# Cross-package imports escape the per-subproject gating above. `workstreams-app`
# imports beebox SOURCE directly — the router takes `webapp/auth.ts`,
# `webapp/box-access.ts`, `core/mobile/request-auth.ts` and `webapp/base-prefix.ts`;
# the issue index takes `services/openai-embeddings.ts` — so a beebox-only commit
# that renames an export passes beebox's own typecheck, lands, and breaks
# workstreams-app silently. That happened on 2026-09-06: the OpenRouter landing
# renamed `createOpenAIEmbeddingsService`, and `bin/issues` plus the hourly
# deferred-issues schedule were down until someone decoded the alert.
#
# So typecheck the importers whenever the imported package's source is staged.
# `bin/` imports beebox source too (`deferred-issues.ts`, `commit-provenance.ts`,
# `base-prefix-injection.test.ts`) and is NOT a workspace package, so only the
# root tsconfig covers it. Both run in ~2.7s and only on a beebox/src commit.
if echo "$staged" | grep -q '^beebox/src/'; then
  if [ -z "${ws_app_typechecked:-}" ]; then
    echo "[pre-commit] workstreams-app: typecheck (imports beebox source)"
    run_in workstreams-app pnpm typecheck
  fi
  echo "[pre-commit] .: pnpm typecheck (bin/ imports beebox source)"
  (cd "$REPO_DIR" && pnpm --silent typecheck)
  root_typechecked=1
fi

# The root program (tsconfig.json `include`) is the only typecheck of bin/ and
# schedules/ TypeScript. tap strips types, so a type error there otherwise
# passes its own tests too
# (issues/code-quality/2026-10-18-bin-typescript-is-not-typechecked-at-commit.md).
if [ -z "${root_typechecked:-}" ] && echo "$staged" | grep -qE '^(bin|schedules)/.*\.(ts|tsx)$'; then
  echo "[pre-commit] .: pnpm typecheck (bin/ or schedules/ TypeScript)"
  (cd "$REPO_DIR" && pnpm --silent typecheck)
fi

# bin/ is not a workspace package, so none of the branches above reach it — and
# the root typecheck alone used to be the whole gate on the dev router, the
# worktree tooling and the test selector. The root eslint config lints it now;
# this is what runs that at commit time
# (issues/code-quality/2026-08-26-bin-typescript-is-not-linted.md). Cached, so a
# commit that changed one file re-lints one file.
if echo "$staged" | grep -qE '^bin/.*\.(ts|tsx|js|jsx|cjs)$'; then
  echo "[pre-commit] .: pnpm lint:bin"
  (cd "$REPO_DIR" && pnpm --silent lint:bin)
fi

# Committed exhibit apps (dev/apps/) are deliberately outside every package's
# lint — casual by design — but they merge to main and live forever, so staged
# app SOURCE gets one bare this-will-build check: tsc with the same settings
# the exhibits container serves with (dev/apps/tsconfig.json). index.html-tier
# apps never trigger it.
if echo "$staged" | grep -qE '^dev/apps/.*\.(ts|tsx)$'; then
  echo "[pre-commit] .: pnpm dev-apps-typecheck"
  (cd "$REPO_DIR" && pnpm --silent dev-apps-typecheck)
fi
