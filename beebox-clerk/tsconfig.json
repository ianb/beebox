{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["eslint.config.ts", ".wxt/wxt.d.ts", "src/**/*", "test/**/*"],
  "exclude": ["node_modules", ".output"]
}
