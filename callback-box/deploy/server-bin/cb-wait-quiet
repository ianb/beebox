#!/usr/bin/env bash
# Wait, bounded and best-effort, for every box to be at rest — no running
# script or procedure, no active chat turn — before the caller restarts the
# services. Always exits 0: the wait is advisory, never a hard block.
#
# This is prevention for a specific failure. Restarting on top of a box that is
# mid-`git commit` risks leaving a `.git/index.lock` that nothing owns, which
# blocks every writer in that box until it is removed (see
# callback-box/src/lib/git-stale-lock.ts). The in-process drains and the hub's
# kill grace cover a restart that lands mid-write; this keeps the restart from
# landing there in the first place.
#
# Installed by deploy.sh on every deploy and by setup-server.sh at provision
# time. Shared by both, plus the quiet-hour recycle timer.
set -u
CB_USER="${CB_USER:-callback}"
DEADLINE=$(( $(date +%s) + 180 ))
while true; do
  if su - "$CB_USER" -c 'CB_CLI_PREBUILT=1 /usr/local/bin/cb activity' >/tmp/cb-activity.out 2>&1; then
    echo "cb-wait-quiet: at rest"; exit 0
  fi
  if [ "$(date +%s)" -ge "$DEADLINE" ]; then
    echo "cb-wait-quiet: still busy after wait cap, proceeding:"
    sed 's/^/  /' /tmp/cb-activity.out
    exit 0
  fi
  sleep 10
done
