{
  "description": "Validate Callback Box files after Codex edits them.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cb agent-context --hook",
            "statusMessage": "Loading Callback Box context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cb validate --hook",
            "statusMessage": "Validating box files"
          }
        ]
      }
    ]
  }
}
