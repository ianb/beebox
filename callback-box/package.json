{
  "name": "callback-box",
  "version": "0.1.0",
  "description": "A Claude Code wrapper system for file-based processing",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "cb": "./bin/cb"
  },
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd src/frontend && npm run build",
    "build:all": "npm run build && npm run build:frontend",
    "dev": "tsc --watch",
    "dev:frontend": "cd src/frontend && npm run dev",
    "dev:server": "npm run build && node dist/cli/index.js serve",
    "cb": "node --import ./tsx-preload.mjs --require ./node_modules/tsx/dist/preflight.cjs --import ./node_modules/tsx/dist/loader.mjs ./src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "cd src/frontend && npm run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:frontend",
    "lint": "tsc --noEmit",
    "start": "node dist/webapp/server.js",
    "cli": "node dist/cli/index.js",
    "test": "tap",
    "knowledge-audit": "tsx src/dev/knowledge-audit.ts",
    "test:watch": "tap --watch",
    "lint:oxlint": "oxlint -A no-unused-vars",
    "lint:knip": "knip",
    "lint:circular": "madge --circular --extensions ts,tsx src/",
    "prepare": "husky"
  },
  "keywords": [
    "claude",
    "automation",
    "inbox",
    "procedure"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@ianbicking/personal-vibe-check": "file:../../personal-vibe-check",
    "@types/chokidar": "^1.7.5",
    "@types/node": "^22.0.0",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "husky": "^9.1.7",
    "knip": "^5.83.1",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "oxlint": "^1.47.0",
    "tap": "^21.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@parcel/markdown-ansi": "^2.16.3",
    "@types/mailparser": "^3.4.6",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "ansi-to-html": "^0.7.2",
    "callback-dropbox": "file:../callback-dropbox",
    "cardworks": "file:../cardworks",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^13.0.0",
    "cron-parser": "^5.5.0",
    "fastify": "^5.7.2",
    "google-auth-library": "^10.5.0",
    "grammy": "^1.40.1",
    "ical.js": "^2.2.1",
    "imapflow": "^1.2.9",
    "mailparser": "^3.9.3",
    "open": "^11.0.0",
    "rrule": "^2.8.1",
    "turndown": "^7.2.2",
    "xml2js": "^0.6.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint"
    ]
  }
}
