{
  "name": "callback-box",
  "version": "0.1.0",
  "description": "A Claude Code wrapper system for file-based processing",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "cb": "./bin/cb"
  },
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd src/frontend && npm run build",
    "build:all": "npm run build && npm run build:frontend",
    "dev": "tsc --watch",
    "dev:frontend": "cd src/frontend && npm run dev",
    "dev:server": "npm run build && node dist/cli/index.js serve",
    "cb": "node --import ./tsx-preload.mjs --require ./node_modules/tsx/dist/preflight.cjs --import ./node_modules/tsx/dist/loader.mjs ./src/cli/index.ts",
    "typecheck": "tsc --noEmit && cd src/frontend && npx tsc --noEmit",
    "typecheck:frontend": "cd src/frontend && npm run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:frontend",
    "lint": "eslint src/ && cd src/frontend && npx eslint src/",
    "start": "node dist/webapp/server.js",
    "cli": "node dist/cli/index.js",
    "test": "tap",
    "knowledge-audit": "tsx src/dev/knowledge-audit.ts",
    "prompt-report": "tsx src/dev/prompt-report.ts",
    "generate:doc-images": "tsx src/dev/generate-doc-images.ts",
    "doc-graph": "tsx src/dev/doc-graph.ts > docs/doc-graph.md",
    "test:watch": "tap --watch",
    "lint:oxlint": "oxlint -A no-unused-vars",
    "lint:knip": "knip",
    "lint:circular": "madge --circular --extensions ts,tsx src/",
    "prepare": "husky"
  },
  "keywords": [
    "claude",
    "automation",
    "inbox",
    "procedure"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@ianbicking/personal-vibe-check": "file:../../personal-vibe-check",
    "@types/chokidar": "^1.7.5",
    "@types/node": "^22.0.0",
    "@types/xml2js": "^0.4.14",
    "agent-doctest": "file:../agent-doctest",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "husky": "^9.1.7",
    "knip": "^5.83.1",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "oxlint": "^1.47.0",
    "tap": "^21.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.128",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@google/genai": "^1.44.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@parcel/markdown-ansi": "^2.16.3",
    "@trpc/server": "^11.11.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "ansi-to-html": "^0.7.2",
    "better-sqlite3": "^12.6.2",
    "cardworks": "file:../cardworks",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "commander": "^13.0.0",
    "cron-parser": "^5.5.0",
    "esbuild": "^0.25.0",
    "execa": "^9.6.1",
    "exifr": "^7.1.3",
    "fastify": "^5.7.2",
    "glob": "^11.0.0",
    "google-auth-library": "^10.5.0",
    "grammy": "^1.40.1",
    "html-entities": "^2.6.0",
    "ical.js": "^2.2.1",
    "ky": "^1.14.3",
    "open": "^11.0.0",
    "react-virtuoso": "^4.18.6",
    "rrule": "^2.8.1",
    "sanitize-filename": "^1.6.3",
    "simple-git": "^3.32.3",
    "turndown": "^7.2.2",
    "xml2js": "^0.6.2",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "lint-staged": {
    "src/frontend/src/**/*.{ts,tsx,js}": [
      "eslint --config src/frontend/eslint.config.mjs"
    ],
    "src/!(frontend)/**/*.ts": [
      "eslint"
    ]
  }
}
