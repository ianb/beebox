{
  "name": "callback-box",
  "version": "0.1.0",
  "description": "A Claude Code wrapper system for file-based processing",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "cb": "./bin/cb"
  },
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd src/frontend && npm run build",
    "build:all": "npm run build && npm run build:frontend",
    "dev": "tsc --watch",
    "dev:frontend": "cd src/frontend && npm run dev",
    "dev:server": "npm run build && node dist/cli/index.js serve",
    "cb": "node --import ./tsx-preload.mjs --require ./node_modules/tsx/dist/preflight.cjs --import ./node_modules/tsx/dist/loader.mjs ./src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "cd src/frontend && npm run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:frontend",
    "lint": "tsc --noEmit",
    "start": "node dist/webapp/server.js",
    "cli": "node dist/cli/index.js",
    "test": "tap",
    "test:watch": "tap --watch"
  },
  "keywords": [
    "claude",
    "automation",
    "inbox",
    "workflow"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chokidar": "^1.7.5",
    "@types/node": "^22.0.0",
    "@types/xml2js": "^0.4.14",
    "tap": "^21.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@parcel/markdown-ansi": "^2.16.3",
    "@types/turndown": "^5.0.6",
    "ansi-to-html": "^0.7.2",
    "callback-dropbox": "file:../callback-dropbox",
    "cardworks": "file:../cardworks",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^13.0.0",
    "fastify": "^5.7.2",
    "turndown": "^7.2.2",
    "xml2js": "^0.6.2",
    "zod": "^3.24.0"
  }
}
