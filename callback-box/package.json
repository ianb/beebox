{
  "name": "callback-box",
  "version": "0.1.0",
  "description": "A Claude Code wrapper system for file-based processing",
  "type": "module",
  "exports": {
    "./cards": {
      "types": "./dist/cards/index.d.ts",
      "default": "./dist/cards/index.js"
    },
    "./schema": {
      "types": "./dist/exports/schema.d.ts",
      "default": "./dist/exports/schema.js"
    },
    "./server": "./dist/exports/server.js",
    "./view-widgets": {
      "types": "./dist/view-widgets/index.d.ts",
      "default": "./dist/view-widgets/index.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "bin": {
    "cb": "./bin/cb"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "src/frontend/dist",
    "src/frontend/package.json",
    "src/types",
    "tsconfig.json",
    "tsconfig.base.json"
  ],
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd src/frontend && pnpm build",
    "build:all": "pnpm build && pnpm build:frontend",
    "build:cli": "node scripts/build-cli.mjs && tsc -p tsconfig.declarations.json",
    "release": "tsx scripts/release.ts",
    "smoke": "tsx scripts/smoke-external-box.ts",
    "smoke:upgrade": "tsx scripts/smoke-upgrade.ts",
    "dev": "echo 'The dev server is the monorepo router. Run \\`pnpm dev\\` from the monorepo root.' && exit 1",
    "cb": "./bin/cb",
    "typecheck": "tsc --noEmit && cd src/frontend && pnpm exec tsc --noEmit",
    "typecheck:frontend": "cd src/frontend && pnpm typecheck",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:frontend",
    "lint": "eslint src/ scripts/ && cd src/frontend && pnpm exec eslint src/",
    "start": "node dist/webapp/server.js",
    "cli": "node dist/cli/index.js",
    "pretest": "node scripts/build-cli.mjs",
    "test": "tap",
    "test:manual": "tap 'test/manual/**/*.doctest.md' 'test/manual/**/*.test.ts'",
    "knowledge-audit": "tsx src/dev/knowledge-audit.ts",
    "template-stock:update": "tsx scripts/update-template-stock-hashes.ts",
    "csp-digest": "tsx src/dev/csp-digest.ts",
    "csp-report": "tsx src/dev/csp-report.ts",
    "prompt-report": "tsx src/dev/prompt-report.ts",
    "prompt-viewer": "tsx src/dev/prompt-viewer.ts",
    "agent-context": "tsx src/dev/agent-context.ts",
    "generate:doc-images": "tsx src/dev/generate-doc-images.ts",
    "doc-graph": "tsx src/dev/doc-graph.ts > docs/doc-graph.md",
    "doc-check": "tsx src/dev/doc-check.ts",
    "doc-graph-html": "tsx src/dev/doc-graph-html.ts",
    "test:watch": "tap --watch",
    "lint:oxlint": "oxlint -A no-unused-vars",
    "lint:knip": "knip",
    "lint:circular": "madge --circular --extensions ts,tsx src/"
  },
  "keywords": [
    "claude",
    "automation",
    "inbox",
    "procedure"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@ianbicking/personal-vibe-check": "workspace:*",
    "@types/chokidar": "^1.7.5",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "agent-doctest": "workspace:*",
    "axe-core": "^4.11.4",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "husky": "^9.1.7",
    "knip": "^5.83.1",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "oxlint": "^1.47.0",
    "tap": "^21.0.0",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.207",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@google/genai": "^1.44.0",
    "@markdoc/markdoc": "^0.5.7",
    "@orama/orama": "3.1.18",
    "@orama/plugin-data-persistence": "3.1.18",
    "@parcel/markdown-ansi": "^2.16.3",
    "@trpc/server": "^11.11.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ws": "^8.18.1",
    "ansi-to-html": "^0.7.2",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "commander": "^13.0.0",
    "cron-parser": "^5.5.0",
    "esbuild": "^0.25.0",
    "execa": "^9.6.1",
    "fastify": "^5.7.2",
    "get-port": "^7.2.0",
    "glob": "^13.0.0",
    "google-auth-library": "^10.5.0",
    "grammy": "^1.40.1",
    "http-proxy-3": "^1.23.2",
    "ical.js": "^2.2.1",
    "ignore": "^5.3.2",
    "ky": "^1.14.3",
    "markdownlint": "^0.40.0",
    "open": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrule": "^2.8.1",
    "sanitize-filename": "^1.6.3",
    "simple-git": "^3.32.3",
    "typescript": "^5.7.0",
    "web-push": "^3.6.7",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "lint-staged": {
    "src/frontend/src/**/*.{ts,tsx,js}": [
      "eslint --config src/frontend/eslint.config.mjs"
    ],
    "src/!(frontend)/**/*.ts": [
      "eslint"
    ]
  }
}
