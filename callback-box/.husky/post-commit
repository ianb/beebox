#!/usr/bin/env bash
# Auto-deploy to server after each commit — ONLY from the `main` branch.
# Worktrees on other branches skip the deploy.
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

BRANCH=$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$BRANCH" = "main" ]; then
  echo "[post-commit] Deploying to server (branch: main)..."
  "$REPO_DIR/deploy/deploy.sh" &>"$REPO_DIR/deploy/.last-deploy.log" &
  disown
  echo "[post-commit] Deploy started in background (log: deploy/.last-deploy.log)"
else
  echo "[post-commit] Skip deploy: branch is '$BRANCH' (deploys only run from 'main')"
fi

# Clean up .bak.png files for images that were just committed
committed_images=$(git diff-tree --no-commit-id --name-only -r HEAD -- 'docs/architecture/images/*.png' | grep -v '\.bak\.png$' || true)
if [ -n "$committed_images" ]; then
  for img in $committed_images; do
    base="${img%.png}"
    # Remove numbered backups (e.g. card-anatomy-diagram.1.bak.png)
    for bak in "$REPO_DIR"/"${base}".*.bak.png; do
      [ -f "$bak" ] && rm "$bak" && echo "[post-commit] Cleaned up $(basename "$bak")"
    done
    # Remove mermaid backup
    mermaid_bak="$REPO_DIR/${base}.mermaid.bak.png"
    [ -f "$mermaid_bak" ] && rm "$mermaid_bak" && echo "[post-commit] Cleaned up $(basename "$mermaid_bak")"
  done
fi
