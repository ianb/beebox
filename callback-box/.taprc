plugin:
  - "!@tapjs/typescript"
node-arg:
  # Node's bundled `punycode` (DEP0040) is hit by transitive deps; the warning
  # fires per subprocess and otherwise spams test output dozens of times.
  - --disable-warning=DEP0040
  - --import=tsx
  - --import=agent-doctest/tap
  - --import=agent-doctest/loader
include:
  - test/**/*.test.ts
  - test/**/*.doctest.md
exclude:
  - test/manual/**
# Default 30s per-file is too tight for reactor-integration.doctest.md, which
# exercises 10 full reactor cycles (~25s in isolation, longer under parallel
# load). Bumping to 60s gives headroom without masking real hangs.
timeout: 60
reporter: min
