plugin:
  - "!@tapjs/typescript"
node-arg:
  # Node's bundled `punycode` (DEP0040) is hit by transitive deps; the warning
  # fires per subprocess and otherwise spams test output dozens of times.
  - --disable-warning=DEP0040
  - --import=tsx
  - --import=agent-doctest/tap
  - --import=agent-doctest/loader
include:
  - test/**/*.test.ts
  - test/**/*.doctest.md
exclude:
  - test/manual/**
# Cap parallel test files. tap defaults to one job per core (12 here), but each
# route doctest's makeTestServer() boots a full Fastify app + two synchronous
# `git` spawns, and files call it dozens of times (routes-api alone ~80s). At
# full core-count parallelism that thundering herd of git/app boots thrashes the
# machine, inflating per-file wall time until heavy files blow the timeout and
# get SIGALRM'd — non-deterministically, which file losing the race each run.
# Half the cores bounds the contention while keeping the suite reasonably fast.
jobs: 6
# Per-file timeout. The suite has grown (a single route file is ~80s solo now),
# so the old 60s was too tight even before parallel load slowed files further.
# 5 minutes gives heavy files headroom under the capped contention above without
# masking a genuine hang (a wedged test still surfaces, just later).
timeout: 300
reporter: min
