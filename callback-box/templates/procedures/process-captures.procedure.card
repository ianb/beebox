<procedure name="process-captures">
  <description>
    Process capture sessions through intake: transcribe audio, describe images,
    summarize audio, assemble timeline, rename, extract records, and archive.
  </description>

  <step id="transcribe">
    <description>Transcribe all audio clips with word-level timestamps</description>

    <precheck>
      <shell>
        found=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          for card in "$dir"*.audio.card; do
            [ -f "$card" ] || continue
            if grep -q 'status="new"' "$card"; then
              found=$((found + 1))
            fi
          done
        done
        if [ "$found" -eq 0 ]; then
          exit $CHECK_SKIP
        fi
        echo "Found $found audio clip(s) to transcribe"
      </shell>
      <why>No untranscribed audio clips in capture sessions</why>
    </precheck>

    <run>
      <shell>cb transcribe-captures</shell>
    </run>

    <validate severity="warn">
      <shell>
        remaining=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          for card in "$dir"*.audio.card; do
            [ -f "$card" ] || continue
            if grep -q 'status="new"' "$card"; then
              remaining=$((remaining + 1))
            fi
          done
        done
        echo "Untranscribed audio remaining: $remaining"
        [ "$remaining" -eq 0 ]
      </shell>
      <instruction>All audio cards should have status="transcribed" after this step.</instruction>
      <why>Later steps depend on all audio being transcribed with timing data.</why>
    </validate>
  </step>

  <step id="describe-images">
    <description>Analyze images with Gemini Flash (OCR, descriptions, EXIF, renaming)</description>

    <precheck>
      <shell>
        found=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          for card in "$dir"*.image.card; do
            [ -f "$card" ] || continue
            if grep -q 'status="new"' "$card"; then
              found=$((found + 1))
            fi
          done
        done
        if [ "$found" -eq 0 ]; then
          exit $CHECK_SKIP
        fi
        echo "Found $found image(s) to describe"
      </shell>
      <why>No images need description</why>
    </precheck>

    <run>
      <shell>
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          cards=""
          for card in "$dir"*.image.card; do
            [ -f "$card" ] || continue
            if grep -q 'status="new"' "$card"; then
              cards="$cards $card"
            fi
          done
          if [ -n "$cards" ]; then
            cb describe-images $cards
          fi
        done
        git add box/inbox/ &amp;&amp; git commit -m "Describe images via Gemini Flash

Triggered-By: cb procedure
Phase: describe-images"
      </shell>
    </run>

    <validate severity="warn">
      <shell>
        remaining=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          for card in "$dir"*.image.card; do
            [ -f "$card" ] || continue
            if grep -q 'status="new"' "$card"; then
              remaining=$((remaining + 1))
            fi
          done
        done
        echo "Unprocessed images remaining: $remaining"
        [ "$remaining" -eq 0 ]
      </shell>
      <instruction>All image cards should have status="analyzed" or "invalid".</instruction>
      <why>The timeline assembly step needs all images processed.</why>
    </validate>
  </step>

  <step id="summarize">
    <description>Write one-sentence summaries for each audio clip</description>

    <precheck>
      <shell pass-output="true">
        found=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          for card in "$dir"*.audio.card; do
            [ -f "$card" ] || continue
            if grep -q 'status="transcribed"' "$card" &amp;&amp; ! grep -qE '&lt;summary&gt;.+&lt;/summary&gt;' "$card"; then
              echo "  Needs summary: $card"
              found=$((found + 1))
            fi
          done
        done
        if [ "$found" -eq 0 ]; then
          exit $CHECK_SKIP
        fi
        echo "Found $found audio clip(s) needing summaries"
      </shell>
      <why>No audio clips need summaries</why>
    </precheck>

    <run>
      <agent model="haiku" max-turns="10">
        You are summarizing audio transcripts in capture sessions.

        YOUR TASK:
        For each audio card listed in the precheck output, read it and write a one-sentence summary
        focused on what the user is trying to do or communicate. The summary should help a future
        agent understand the purpose and content of this audio clip.

        STEP 1 - READ ALL AUDIO CARDS:
        Read each audio card listed above. They contain &lt;transcript&gt; elements with the transcribed text.

        STEP 2 - WRITE SUMMARIES:
        For each card, edit it to fill in the &lt;summary&gt; element with one sentence.
        Focus on user intent: what are they trying to accomplish, explain, or capture?

        COMMIT (REQUIRED — do not skip):
        ```bash
        git add -A &amp;&amp; git commit -m "$(cat &lt;&lt;'EOF'
        Summarize audio clips

        Triggered-By: cb procedure
        Phase: summarize
        EOF
        )"
        ```

        GIT: Do NOT add Co-Authored-By to commits. The system adds appropriate trailers automatically.
      </agent>
    </run>
  </step>

  <step id="assemble">
    <description>Assemble structured timeline from timing data and images</description>

    <precheck>
      <shell>
        found=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          session=$(ls "$dir"*.capture-session.card 2>/dev/null | head -1)
          [ -f "$session" ] || continue
          # Check all audio transcribed
          audio_ready=1
          for card in "$dir"*.audio.card; do
            [ -f "$card" ] || continue
            if ! grep -q 'status="transcribed"' "$card"; then
              audio_ready=0
              break
            fi
          done
          # Check all images analyzed/invalid
          images_ready=1
          for card in "$dir"*.image.card; do
            [ -f "$card" ] || continue
            if grep -q 'status="new"' "$card"; then
              images_ready=0
              break
            fi
          done
          if [ "$audio_ready" -eq 1 ] &amp;&amp; [ "$images_ready" -eq 1 ]; then
            # Check transcript not already assembled (has children)
            if grep -q '&lt;transcript/&gt;\|&lt;transcript&gt;&lt;/transcript&gt;' "$session"; then
              found=$((found + 1))
            fi
          fi
        done
        if [ "$found" -eq 0 ]; then
          exit $CHECK_SKIP
        fi
        echo "Found $found session(s) ready for timeline assembly"
      </shell>
      <why>No sessions are ready for assembly (need all audio transcribed and all images analyzed)</why>
    </precheck>

    <run>
      <shell>cb assemble-timeline</shell>
    </run>
  </step>

  <step id="plan-extraction">
    <description>Rename the session directory, decide what records to extract and where they should be filed, write an extraction spec</description>

    <precheck>
      <shell pass-output="true">
        found=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          session=$(ls "$dir"*.capture-session.card 2>/dev/null | head -1)
          [ -f "$session" ] || continue
          # Check transcript has children (assemble ran)
          has_transcript=0
          if grep -q '&lt;text&gt;\|&lt;silence \|&lt;image ' "$session"; then
            has_transcript=1
          fi
          status=$(grep -oE 'status="[^"]*"' "$session" | head -1 | grep -oE '"[^"]*"' | tr -d '"')
          if [ "$has_transcript" -eq 1 ] &amp;&amp; [ "$status" != "intake-complete" ] &amp;&amp; [ "$status" != "extracted" ]; then
            echo "  Ready: $dir"
            echo "  Session: $session"
            found=$((found + 1))
          fi
        done
        if [ "$found" -eq 0 ]; then
          exit $CHECK_SKIP
        fi
        echo "Found $found session(s) ready for planning"
      </shell>
      <why>No sessions with an assembled transcript are waiting to be planned</why>
    </precheck>

    <run>
      <agent model="opus" max-turns="20">
        You are taking an assembled capture session from raw intake to a plan: picking a
        descriptive name for the session directory, deciding what records are worth extracting,
        and deciding where each one should be filed.

        YOUR TASK:
        For each session listed in the precheck output:

        STEP 1 — READ THE SESSION:
        1. Read the session card (the .capture-session.card file) — look at &lt;transcript&gt; and &lt;time start="..."&gt;
        2. Read the image cards in the same directory to understand what was captured
        3. Consider the transcript content together with the image descriptions

        STEP 2 — READ FILING RULES (if the box has them):
        If `config/intake.guide.card` exists in this box, read it. It contains the user's rules
        for where different kinds of content should be filed, with confidence levels:
        - `source="user-stated"` with `confidence="high"` are the user's own rules and should be
          followed unless there's a clear reason not to.
        - `source="default"` with `confidence="low"` are starting-point defaults; feel free to
          override or ignore if the user-stated rules are more specific.
        You'll use these rules in STEP 4 to pick a destination path for each record. If no intake
        guide exists, skip this step and fall through to the default of store/catalogs/.

        STEP 3 — RENAME THE DIRECTORY:
        Pick a short descriptive name based on what was captured (2-4 words, underscores for
        spaces, retaining capitals). The date part stays the same — it comes from the session's
        start time. Example: `capture-20260211T1951-f26ffa35` → `capture-20260211T1951-Whiteboard_Planning`.

        Use `cb mv` to rename:
        ```
        cb mv box/inbox/capture-20260211T1951-f26ffa35 box/inbox/capture-20260211T1951-Whiteboard_Planning
        ```

        After the rename, the new path is where you'll reference image cards from in the spec
        and write the extraction-spec.md file. The image cards themselves keep their own
        basenames (photo-NNN-Descriptive_Title.image.card) — only the parent directory changes.

        STEP 4 — WRITE THE EXTRACTION SPEC:
        Write `extraction-spec.md` inside the (now renamed) session directory. The spec tells
        the next step (a haiku agent) exactly what records to create, how to shape them, and
        where to file them.

        IF extraction is appropriate (the session contains identifiable, discrete things to catalog):

        ```markdown
        # Extraction Spec

        ## Description
        Brief description of what kind of records to create (e.g., "Home inventory items from living room walkthrough")

        ## Format Guidance
        Which record fields to use for this domain. For example:
        - Use: name, description, location, measure, sources
        - Skip: content, person, language, triage

        ## Example Record
        ```xml
        &lt;record status="draft"&gt;
          &lt;name&gt;Example Item Name&lt;/name&gt;
          &lt;description&gt;What this item is and its condition&lt;/description&gt;
          &lt;sources&gt;
            &lt;source ref="/box/inbox/capture-YYYYMMDDTHHMM-Descriptive_Name/photo-003-detail.image.card"&gt;
              Photo of the item showing its condition and markings
            &lt;/source&gt;
            &lt;source ref="/box/inbox/capture-YYYYMMDDTHHMM-Descriptive_Name/photo-004-label.image.card"&gt;
              Close-up of label/serial number
            &lt;/source&gt;
          &lt;/sources&gt;
          &lt;location&gt;Living room, near the window&lt;/location&gt;
          &lt;measure value="500 USD"&gt;Estimated value&lt;/measure&gt;
        &lt;/record&gt;
        ```

        IMPORTANT: Sources must reference the specific IMAGE CARDS (photo-NNN-name.image.card)
        that depict this record, not the session card. Each record should link to exactly the
        photos that show it. If audio context is relevant, include a source ref to the session
        card with a time= attribute. Use the RENAMED directory in all refs.

        ## Records to Extract
        Each bullet is one record. Include a destination path when a filing rule applies;
        otherwise omit the path and the extract step will default to `store/catalogs/Descriptive_Name/`.

        - **Record Name** → `Slugified_Filename.record.card` @ `store/documents/tax/2024/income/`
        - **Another Record** → `Another_Record.record.card`

        The `@ path/` suffix tells the extract step where to write the card. Use it when the
        intake guide has a high-confidence user-stated rule that matches the record. Trailing
        slash on the destination means "write the record into this directory".
        ```

        IF extraction is NOT appropriate (session is too vague, incomplete, or doesn't contain
        discrete extractable things):

        ```markdown
        skip: true

        Reason: Brief explanation of why extraction doesn't apply.
        ```

        IMPORTANT:
        - Filenames should be slugified with underscores, retaining capitals (e.g., `Brown_Leather_Couch.record.card`)
        - The example XML should match the specific domain (home inventory, document archive, tax records, etc.)
        - Be selective about which fields to recommend — don't suggest using every field
        - Each record in the list should have a clear, specific name
        - When you emit a destination path, explain in the Description section which guide rule
          matched so the user can audit the decision later.

        STEP 5 — UPDATE SESSION STATUS:
        Edit the session card to set `status="intake-complete"` once the rename, guide-reading,
        and spec-writing are all done for that session.

        COMMIT (REQUIRED — do not skip):
        ```bash
        git add -A &amp;&amp; git commit -m "$(cat &lt;&lt;'EOF'
        Plan extraction for capture sessions

        Triggered-By: cb procedure
        Phase: plan-extraction
        EOF
        )"
        ```

        GIT: Do NOT add Co-Authored-By to commits. The system adds appropriate trailers automatically.
      </agent>
    </run>

    <validate severity="warn">
      <shell>
        missing=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          session=$(ls "$dir"*.capture-session.card 2>/dev/null | head -1)
          [ -f "$session" ] || continue
          if grep -q 'status="intake-complete"' "$session"; then
            if [ ! -f "${dir}extraction-spec.md" ]; then
              echo "Missing extraction-spec.md: $dir"
              missing=$((missing + 1))
            fi
          fi
        done
        echo "Sessions missing extraction spec: $missing"
        [ "$missing" -eq 0 ]
      </shell>
      <instruction>Each intake-complete session should have an extraction-spec.md file.</instruction>
      <why>The extract step needs a spec to follow.</why>
    </validate>
  </step>

  <step id="extract">
    <description>Extract records from sessions following the extraction spec</description>

    <precheck>
      <shell pass-output="true">
        found=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          spec="${dir}extraction-spec.md"
          [ -f "$spec" ] || continue
          # Skip if spec says to skip
          if grep -q '^skip: true' "$spec"; then
            continue
          fi
          session=$(ls "$dir"*.capture-session.card 2>/dev/null | head -1)
          [ -f "$session" ] || continue
          if grep -q 'status="intake-complete"' "$session"; then
            echo "  Session: $session"
            echo "  Spec: $spec"
            found=$((found + 1))
          fi
        done
        if [ "$found" -eq 0 ]; then
          exit $CHECK_SKIP
        fi
        echo "Found $found session(s) ready for extraction"
      </shell>
      <why>No sessions have non-skip extraction specs ready</why>
    </precheck>

    <run>
      <agent model="haiku" max-turns="30">
        You are extracting records from capture sessions following extraction specs.

        YOUR TASK:
        For each session listed in the precheck output, read the extraction spec and create
        record cards accordingly.

        STEP 1 - READ THE SPEC:
        For each session, read the extraction-spec.md file. It contains:
        - What kind of records to create
        - Which fields to use
        - An example record in XML
        - A list of records to extract with suggested filenames, optionally with a destination
          path like `**Record Name** → `Filename.record.card` @ `store/documents/tax/2024/income/``

        STEP 2 - READ THE SESSION:
        Read the session card and its image cards to gather the actual content for each record.

        STEP 3 - CREATE RECORDS:
        For each record listed in the spec, pick its destination directory:

        - **If the bullet has an `@ path/` suffix**, that's the destination directory. Create
          the directory if needed (`mkdir -p &lt;path&gt;`) and write the record there.
        - **If no `@ path/` suffix is given**, default to `store/catalogs/Descriptive_Name/`
          (one shared catalog directory per session, named after the session's descriptive name).

        Create each record with `cb create` at the chosen path:
        ```bash
        cb create store/documents/tax/2024/income/Fidelity_1099_DIV.record.card
        # or for the default catalog path:
        cb create store/catalogs/Descriptive_Name/Slugified_Name.record.card
        ```

        Then edit the created card to fill in the record following the spec's format guidance
        and example. Key rules:
        - Always include &lt;sources&gt; with refs to the specific IMAGE CARDS that depict this
          record (e.g. photo-003-descriptive-name.image.card), NOT the session card.
          Each record should link to exactly the photos that show it.
          Only reference the session card if audio/transcript context is relevant (with time=).
        - Source body text must explain WHY that source is relevant
        - Use absolute paths for refs: /box/inbox/capture-YYYYMMDDTHHMM-Name/photo-NNN-name.image.card
        - &lt;measure value="..."&gt; uses natural language: "2 pages", "7 feet", "1200 USD"
        - Only use fields the spec recommends
        - &lt;name&gt; is always required

        STEP 4 - UPDATE SESSION STATUS:
        After creating all records, edit the session card to set status="extracted".

        COMMIT (REQUIRED — do not skip):
        ```bash
        git add -A &amp;&amp; git commit -m "$(cat &lt;&lt;'EOF'
        Extract records from capture sessions

        Triggered-By: cb procedure
        Phase: extract
        EOF
        )"
        ```

        GIT: Do NOT add Co-Authored-By to commits. The system adds appropriate trailers automatically.
      </agent>
    </run>

    <validate severity="warn">
      <shell>
        extracted=0
        remaining=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          spec="${dir}extraction-spec.md"
          [ -f "$spec" ] || continue
          if grep -q '^skip: true' "$spec"; then
            continue
          fi
          session=$(ls "$dir"*.capture-session.card 2>/dev/null | head -1)
          [ -f "$session" ] || continue
          if grep -q 'status="extracted"' "$session"; then
            extracted=$((extracted + 1))
          elif grep -q 'status="intake-complete"' "$session"; then
            remaining=$((remaining + 1))
          fi
        done
        echo "Extracted: $extracted, remaining: $remaining"
      </shell>
      <instruction>Partial progress is OK — extracted sessions proceed to archive, remaining ones are picked up on the next run.</instruction>
      <why>The archive step only moves extracted sessions, and re-triggers process-captures if anything is left.</why>
    </validate>
  </step>

  <step id="archive">
    <description>Archive fully-processed capture sessions out of inbox</description>

    <precheck>
      <shell>
        found=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          session=$(ls "$dir"*.capture-session.card 2>/dev/null | head -1)
          [ -f "$session" ] || continue
          status=$(grep -oE 'status="[^"]*"' "$session" | head -1 | grep -oE '"[^"]*"' | tr -d '"')
          if [ "$status" = "extracted" ]; then
            found=$((found + 1))
          fi
          # Also archive sessions whose extraction-spec says skip
          spec="${dir}extraction-spec.md"
          if [ -f "$spec" ] &amp;&amp; grep -q '^skip: true' "$spec" &amp;&amp; [ "$status" = "intake-complete" ]; then
            found=$((found + 1))
          fi
        done
        if [ "$found" -eq 0 ]; then
          exit $CHECK_SKIP
        fi
        echo "Found $found session(s) to archive"
      </shell>
      <why>No sessions ready for archiving</why>
    </precheck>

    <run>
      <shell>
        mkdir -p store/archive/captures
        moved=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          session=$(ls "$dir"*.capture-session.card 2>/dev/null | head -1)
          [ -f "$session" ] || continue
          status=$(grep -oE 'status="[^"]*"' "$session" | head -1 | grep -oE '"[^"]*"' | tr -d '"')
          archive=0
          if [ "$status" = "extracted" ]; then
            archive=1
          fi
          spec="${dir}extraction-spec.md"
          if [ -f "$spec" ] &amp;&amp; grep -q '^skip: true' "$spec" &amp;&amp; [ "$status" = "intake-complete" ]; then
            archive=1
          fi
          if [ "$archive" -eq 1 ]; then
            dirname=$(basename "$dir")
            cb mv "$dir" "store/archive/captures/$dirname"
            moved=$((moved + 1))
          fi
        done
        echo "Archived $moved capture session(s)"
        git add -A &amp;&amp; git commit -m "Archive $moved processed capture session(s)

Triggered-By: cb procedure
Phase: archive"

        # Check if there are still unprocessed captures — re-trigger if so
        remaining=0
        for dir in box/inbox/capture-*/; do
          [ -d "$dir" ] || continue
          remaining=$((remaining + 1))
        done
        if [ "$remaining" -gt 0 ]; then
          echo "Still $remaining capture session(s) in inbox — re-creating trigger"
          trigger="config/schedules/process-captures.scheduled-script.card"
          if [ ! -f "$trigger" ]; then
            cat > "$trigger" &lt;&lt;'TRIGGER'
&lt;scheduled-script on-wakeup="true" once="true" lock-group="captures"&gt;
&lt;description&gt;Process remaining capture sessions (auto re-triggered)&lt;/description&gt;
&lt;runs&gt;cb procedure run process-captures&lt;/runs&gt;
&lt;/scheduled-script&gt;
TRIGGER
            git add -A &amp;&amp; git commit -m "Re-trigger process-captures for remaining sessions

Triggered-By: cb procedure
Phase: archive"
          fi
        fi
      </shell>
    </run>
  </step>
</procedure>
