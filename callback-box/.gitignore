node_modules/
dist/
dist-release/
src/frontend/dist/
*.log
# Per-run deploy logs + the .last-deploy.log symlink (see deploy/deploy.sh).
# The .log files are already covered by *.log above; this ignores the directory
# explicitly so a non-.log entry can never sneak in.
deploy/.deploy-logs/
# Sha of the last FULLY successful deploy (written past the healthcheck, see
# deploy.sh). Machine-local state, like server-ip — never committed.
deploy/.last-deployed-sha
.DS_Store
.env
.claude/session-*
.thinking/
.thinking/local/
.tap/
deploy-info.json
scripts/*.wav
scripts/.voxtral-sample.wav
src/dev/reports/
# Architecture doc image generation artifacts
*.bak.png
*.mermaid.bak.png
docs/architecture/images/*-prompt.json
docs/prompts.md

# Scratch work area — gitignored except its README (see scratch/README.md)
scratch/*
!scratch/README.md

# slopo near-duplicate detector — index + report are generated; only the
# config and the reviewed ignore list are committed (see tools/slopo/).
tools/slopo/slopo.db
tools/slopo/slopo-report/
