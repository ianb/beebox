# Per-worktree dev config. Copy to `.env` and adjust.
# `overmind start` auto-loads .env from this directory.
#
# Defaults (when .env is absent) match what the main worktree expects:
#   FRONTEND_PORT=3210
#   BACKEND_PORT=3211
#   BOXES=~/src/boxes/hearthside ~/src/boxes/test1 ~/src/boxes/hearth-test ~/src/boxes/studio
#
# Use scripts/new-worktree.sh to set up a parallel worktree — it generates this
# file with offset ports and a single cloned test box.

FRONTEND_PORT=3220
BACKEND_PORT=3221
BOXES=~/src/boxes/test1-experiment
