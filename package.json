{
  "name": "beebox",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Monorepo root. Holds shared dev infrastructure and husky hooks. Individual packages live in beebox/, workstreams-app/, personal-vibe-check/, tap-check/, beebox-clerk/, browse/.",
  "type": "module",
  "scripts": {
    "bbx": "pnpm --dir beebox bbx",
    "comments": "node --import tsx bin/comments.ts",
    "commit-blocklist-check": "node --import tsx bin/commit-blocklist-check.ts",
    "commit-provenance": "node --import tsx bin/commit-provenance.ts",
    "dev": "bin/workstreams serve",
    "dev-apps-typecheck": "bash bin/dev-apps-typecheck",
    "doctor": "node --import tsx bin/doctor.ts",
    "issues": "node --import tsx bin/issues.ts",
    "lint": "pnpm lint:bin && pnpm --filter '!beebox-frontend' -r lint",
    "lint:bin": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/bin bin/",
    "lint:changed": "node --import tsx bin/lint-changed.ts --root",
    "lint:knip": "knip",
    "mobile-contract-check": "node --import tsx bin/mobile-contract-check.ts",
    "path-leak-check": "node --import tsx bin/path-leak-check.ts",
    "postinstall": "pnpm --dir beebox exec tap build",
    "prepare": "husky",
    "project-size": "node --import tsx bin/project-size.ts",
    "retired-product-name-check": "node --import tsx bin/retired-product-name-check.ts",
    "security:opengrep": "bash security/opengrep/run.sh",
    "snapshot:clerk-contract": "node --import tsx bin/snapshot-clerk-contract.ts",
    "test": "node --import tsx --test bin/*.test.ts schedules/*/*.test.ts",
    "typecheck": "tsc --noEmit",
    "update-agent-sdk": "node --import tsx bin/update-agent-sdk.ts"
  },
  "dependencies": {
    "execa": "^9.6.1",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.0.2",
    "@ianbicking/personal-vibe-check": "workspace:*",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@ianbicking/tap-check": "workspace:*",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "pnpm": {
    "overrides": {
      "whatwg-url": "^14",
      "wxt>vite": "^8.0.16",
      "@wxt-dev/module-react>@vitejs/plugin-react": "^6.0.2",
      "undici": "^7.28.0",
      "js-yaml": "^4.3.0",
      "tmp": "^0.2.7",
      "hono": "^4.12.27"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@typescript-eslint/parser": "8",
        "eslint-plugin-react-hooks": "7"
      }
    }
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@10.26.2"
}
