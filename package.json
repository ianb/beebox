{
  "name": "callback-mono",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root. Holds shared dev infrastructure (husky hooks, the dev router). Individual packages live in callback-box/, cardworks/, personal-vibe-check/, agent-doctest/, callback-clerk/.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "postinstall": "patch-package",
    "dev": "bin/worktrees serve"
  },
  "dependencies": {
    "execa": "^9.6.1",
    "get-port": "^7.1.0",
    "http-proxy-3": "^1.23.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "agent-browser": "^0.27.0",
    "husky": "^9.1.7",
    "patch-package": "^8.0.0",
    "tsx": "^4.22.3"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "pnpm": {
    "overrides": {
      "whatwg-url": "^14",
      "wxt>vite": "^8.0.16",
      "@wxt-dev/module-react>@vitejs/plugin-react": "^6.0.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@typescript-eslint/parser": "8",
        "eslint-plugin-react-hooks": "7"
      }
    }
  }
}
