{
  "name": "callback-box",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Monorepo root. Holds shared dev infrastructure (husky hooks, the dev router). Individual packages live in callback-box/, personal-vibe-check/, agent-doctest/, callback-clerk/, browse/.",
  "type": "module",
  "scripts": {
    "cb": "pnpm --dir callback-box cb",
    "comments": "node --import tsx bin/comments.ts",
    "commit-blocklist-check": "node --import tsx bin/commit-blocklist-check.ts",
    "commit-provenance": "node --import tsx bin/commit-provenance.ts",
    "dev": "bin/workstreams serve",
    "dev-apps-typecheck": "bash bin/dev-apps-typecheck",
    "doctor": "node --import tsx bin/doctor.ts",
    "issues": "node --import tsx bin/issues.ts",
    "lint": "pnpm --filter '!callback-box-frontend' -r lint",
    "lint:knip": "knip",
    "mobile-contract-check": "node --import tsx bin/mobile-contract-check.ts",
    "path-leak-check": "node --import tsx bin/path-leak-check.ts",
    "postinstall": "patch-package",
    "prepare": "husky",
    "security:opengrep": "bash security/opengrep/run.sh",
    "snapshot:clerk-contract": "node --import tsx bin/snapshot-clerk-contract.ts",
    "test": "node --import tsx --test bin/*.test.ts",
    "typecheck": "tsc --noEmit",
    "update-agent-sdk": "node --import tsx bin/update-agent-sdk.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "execa": "^9.6.1",
    "get-port": "^7.1.0",
    "highlight.js": "^11.11.1",
    "http-proxy-3": "^1.23.2",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.0.2",
    "@ianbicking/personal-vibe-check": "workspace:*",
    "@markdoc/markdoc": "^0.5.7",
    "@types/node": "^24.0.0",
    "agent-browser": "^0.27.0",
    "better-sqlite3": "^12.10.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "knip": "^5.83.1",
    "patch-package": "^8.0.0",
    "shellcheck": "4.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "pnpm": {
    "overrides": {
      "whatwg-url": "^14",
      "wxt>vite": "^8.0.16",
      "@wxt-dev/module-react>@vitejs/plugin-react": "^6.0.2",
      "undici": "^7.28.0",
      "js-yaml": "^4.3.0",
      "tmp": "^0.2.7",
      "hono": "^4.12.27"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@typescript-eslint/parser": "8",
        "eslint-plugin-react-hooks": "7"
      }
    }
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@10.26.2"
}
