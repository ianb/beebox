<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleDisplayName</key>
	<string>Bee Box</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.beebox.ios.pairing</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>beebox</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Bee Box uses the microphone for voice input and capture recordings you choose to send.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Bee Box shares your location with your paired box only when you request it.</string>
	<key>NSCameraUsageDescription</key>
	<string>Bee Box uses the camera to scan pairing QR codes and take photos you choose to send.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock boxes you choose to lock in Bee Box.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Bee Box uses speech recognition to turn dictated input into chat messages.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
