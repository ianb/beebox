{
  "name": "workstreams-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx src/server/main.ts",
    "dev:frontend": "vite --config src/frontend/vite.config.ts",
    "build:frontend": "vite build --config src/frontend/vite.config.ts",
    "typecheck:frontend": "tsc --noEmit -p src/frontend/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:frontend": "eslint --config eslint.frontend.config.mjs src/frontend/",
    "test": "tap"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.227",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.3",
    "@trpc/client": "^11.11.0",
    "@trpc/react-query": "^11.11.0",
    "@trpc/server": "^11.11.0",
    "execa": "^9.6.1",
    "fastify": "^5.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ianbicking/personal-vibe-check": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "agent-doctest": "workspace:*",
    "eslint": "^9.39.2",
    "tap": "^21.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  },
  "license": "GPL-3.0-or-later"
}
