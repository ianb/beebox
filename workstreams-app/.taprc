plugin:
  - "!@tapjs/typescript"
node-arg:
  - --import=tsx
  - --import=agent-doctest/tap
  - --import=agent-doctest/loader
include:
  # Doctests only. The router's `node:test` files are NOT listed here: tap does
  # not run that runner's files, and listing them made it report "no tests
  # found" per file and pass — 15 files and 129 assertions that looked covered
  # and were never executed. `test:router` runs them; `test` runs both.
  - test/**/*.doctest.md
reporter: tap
color: false
disable-coverage: true
# Per-file timeout. recency.doctest.md spins up several throwaway git repos
# and scans them across ~7 headings; solo it finishes in ~30s, but under a
# loaded machine (see beebox/.taprc for the same phenomenon measured
# there) that inflated past the previous 60s default and intermittently timed
# out even though every assertion passed. 180s preserves headroom without
# masking a genuine hang indefinitely.
timeout: 180
