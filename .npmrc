# npm-recognized settings only. pnpm's own settings (nodeLinker,
# packageImportMethod, minimumReleaseAge, minimumReleaseAgeExclude) live in
# pnpm-workspace.yaml: npm reads this file too, and warned about each of them as
# an unknown config key on every `npx` run inside the checkout.

# Silence the punycode deprecation warning (DEP0040). Comes from transitive
# deps we don't control (ajv@6 -> uri-js, node-fetch 2 -> whatwg-url@5) and
# fires on every node invocation. Surgical — only this warning is suppressed.
node-options=--disable-warning=DEP0040
engine-strict=true
