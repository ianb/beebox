# Workspace-wide pnpm config. In a pnpm workspace only the root .npmrc is read,
# so all the settings that used to live in each subpackage's .npmrc are
# consolidated here (node-linker is necessarily workspace-wide — you can't mix
# linkers per package).
node-linker=hoisted
# Import packages from the store as APFS copy-on-write clones instead of
# copies. With hoisted linking pnpm's default import made every worktree's
# node_modules a full ~2 GB copy; a clone costs ~25 MB of real disk per
# worktree (measured 2026-09-04) while `du` still reports the full size.
# `hardlink` is a little smaller still but lets a package that rewrites its
# own files corrupt the shared store copy; clone cannot. `clone-or-copy`, not
# `clone`: the production server's ext4 cannot clone and a bare `clone` fails
# there with ERR_PNPM_ENOTSUP (probed 2026-09-04); the fallback copies as
# before on that one machine and clones everywhere APFS is.
package-import-method=clone-or-copy
minimum-release-age=10080
# The agent SDK (and its version-locked platform-binary subpackages) tracks a
# FASTER lane than the 7-day gate above: bin/update-agent-sdk.ts enforces its
# own 2-day age for this family, so this exclusion hands the gating to that
# script rather than removing it. Everything else stays on 7 days.
minimum-release-age-exclude[]=@anthropic-ai/claude-agent-sdk*
# Codex rides the same 2-day lane, for the same reason: the pinned
# `@openai/codex` is the binary the box's Codex chats and the production
# server's `codex` symlink run, and a model or protocol change lands there
# within days. Both `@openai/codex` and `@openai/codex-sdk` (pinned together).
minimum-release-age-exclude[]=@openai/codex*

# Silence the punycode deprecation warning (DEP0040). Comes from transitive
# deps we don't control (ajv@6 -> uri-js, node-fetch 2 -> whatwg-url@5) and
# fires on every node invocation. Surgical — only this warning is suppressed.
node-options=--disable-warning=DEP0040
engine-strict=true
