# Workspace-wide pnpm config. In a pnpm workspace only the root .npmrc is read,
# so all the settings that used to live in each subpackage's .npmrc are
# consolidated here (node-linker is necessarily workspace-wide — you can't mix
# linkers per package).
node-linker=hoisted
minimum-release-age=10080
# The agent SDK (and its version-locked platform-binary subpackages) tracks a
# FASTER lane than the 7-day gate above: bin/update-agent-sdk.ts enforces its
# own 2-day age for this family, so this exclusion hands the gating to that
# script rather than removing it. Everything else stays on 7 days.
minimum-release-age-exclude[]=@anthropic-ai/claude-agent-sdk*

# Silence the punycode deprecation warning (DEP0040). Comes from transitive
# deps we don't control (ajv@6 -> uri-js, node-fetch 2 -> whatwg-url@5) and
# fires on every node invocation. Surgical — only this warning is suppressed.
node-options=--disable-warning=DEP0040
engine-strict=true
