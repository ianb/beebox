node_modules/
dist/
*.log

# Machine-local scheduled-maintenance output. Individual logs are ignored by
# the rule above; ignore the directory too so symlinks such as latest.log can
# never become repository state.
/logs/

# Deploy build checkout + latest-wins lock state (see callback-box/deploy/deploy.sh).
# The checkout is a disposable detached git worktree; the other two are runtime
# lock/coordination files. All live at the main repo root.
/.deploy-checkout/
/.deploy-requested
/.deploy-checkout.lock

# Per-worktree dev config
.env
.overmind.sock

# Personal commit blocklist (the guard's strings live here, never in git).
# The tracked .commit-blocklist.example documents the format.
.commit-blocklist

# Codex mirrors: AGENTS.md files and .agents/skills symlinks are GENERATED from
# CLAUDE.md, .claude/rules, and .claude/skills at worktree spin-up
# (bin/generate-agents-md.ts, called by the WorktreeCreate hook) and must never
# be committed — a committed mirror is exactly the drift-to-stale failure mode
# the generator exists to prevent (see 872450eb).
AGENTS.md
.agents/
.codex/

# Claude Code worktrees (the WorktreeCreate hook puts ours at
# ~/src/callback-worktrees/ instead, but the default location would still
# be created if the hook is somehow bypassed)
.claude/worktrees/

# Claude Code runtime / machine-local
.claude/scheduled_tasks.lock
.claude/session-*.json
.claude/settings.local.json
.claude/projects/
.claude/screenshots/

# OS
.DS_Store

# Xcode local state / build products
*.xcuserstate
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
DerivedData/
ios-app/build/

# Scratch artifacts the agent (or you) drop in scratch/ — orientation
# docs, intermediate outputs, throwaway dumps. Only the README is
# tracked, to preserve the convention. See scratch/README.md.
scratch/*
!scratch/README.md

# Prompt viewer generated data (regenerate with `pnpm prompt-viewer` in
# callback-box). The size ledger (size-ledger.jsonl) and index.html are tracked.
dev/prompts/data.json

# Story-eval triage process is NOT tracked (boxholder, 2026-07-22): extraction
# runs and triage verdicts are local working files — only OUTCOMES are
# committed (promoted nuggets in site/, rubric/prompt revisions, distilled
# learnings folded into the subplan). The app + prompts + ingest tool stay
# tracked as real code.
dev/story-eval/runs/
dev/story-eval/verdicts/

# OpenGrep SARIF/JSON scan output
.opengrep-out/

# Private-issues shadow-repo mount (a SYMLINK in every checkout — no trailing
# slash: dir-only patterns do not match symlinks). See issues/CLAUDE.md.
/private-issues

# Exhibit-store mount (same symlink rule — bin/lib/exhibits-store.sh; design
# in callback-box/docs/plans/workstream-exhibits.md).
/exhibits
