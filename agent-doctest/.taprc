plugin:
  - "!@tapjs/typescript"
node-arg:
  - --import=tsx
  - --import=./src/tap-check.ts
  - --import=./src/doctest-loader.ts
include:
  - test/**/*.test.ts
  - test/**/*.doctest.md
# Agent-first output: plain machine-readable TAP, no ANSI/cursor codes.
# See beebox/.taprc for rationale.
reporter: tap
color: false
# The uncovered remainder is the Node loader-hook plumbing (resolve/load),
# which only runs via real module loading, not unit tests. Don't fail the
# suite on it — same setting as cardworks.
allow-incomplete-coverage: true
