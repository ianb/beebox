{
  "name": "agent-doctest",
  "version": "0.1.0",
  "description": "Markdown doctest runner for tap — write tests as executable documentation",
  "type": "module",
  "bin": {
    "doctest-typecheck": "./bin/doctest-typecheck.mjs"
  },
  "exports": {
    "./check": "./src/exports/check.ts",
    "./tap": "./src/tap-check/tap.ts",
    "./loader": "./src/doctest-loader.ts",
    "./hooks": "./src/doctest-hooks/hooks.ts",
    "./resolve-rules": "./src/doctest-hooks/resolve-rules.ts",
    "./typecheck": "./src/typecheck/check.ts"
  },
  "scripts": {
    "test": "tap",
    "typecheck": "tsc --noEmit",
    "typecheck:doctest": "node bin/doctest-typecheck.mjs --project tsconfig.json 'test/**/*.doctest.md'",
    "lint": "eslint src/"
  },
  "dependencies": {
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devDependencies": {
    "@ianbicking/personal-vibe-check": "workspace:*",
    "@tapjs/core": "^4.0.0",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.2",
    "tap": "^21.0.0"
  },
  "peerDependencies": {
    "@tapjs/core": ">=4.0.0",
    "esbuild": ">=0.20.0",
    "tap": ">=21.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "docs/"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ianb/agent-doctest.git"
  }
}
