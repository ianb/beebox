#!/usr/bin/env bash
# Run a scripted browser tour of the running callback-box app and dump
# artifacts (desktop + mobile screenshots, AX trees, axe-core a11y
# violations, summary.md) under callback-box/test/tours/.artifacts/.
#
# Drives the app through bin/browse; assumes the dev router at :3210
# (`pnpm dev`) and the agent-browser daemon (auto-started by bin/browse)
# are reachable. Tours themselves live at callback-box/test/tours/*.tour.ts.
#
# Usage:
#   bin/tour                # list available tours
#   bin/tour <name>         # run one
#   bin/tour --all          # run every tour
#   bin/tour --list         # explicit list

set -euo pipefail
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if [[ ! -x "$REPO_DIR/browse/node_modules/.bin/tsx" ]]; then
  echo "tour: tsx not found in browse/node_modules. Run 'pnpm install' in browse/." >&2
  exit 1
fi

# Same worktree detection as bin/browse, so tours hit the right URL prefix
# whether run from main or any worktree.
if [[ "$PWD" == *"/callback-worktrees/"* ]]; then
  worktree="${PWD#*/callback-worktrees/}"
  worktree="${worktree%%/*}"
else
  worktree="main"
fi
export BROWSE_WORKTREE="$worktree"

CLI="$REPO_DIR/callback-box/test/tours/tour-lib/cli.ts"
exec "$REPO_DIR/browse/node_modules/.bin/tsx" "$CLI" "$@"
