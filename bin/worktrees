#!/usr/bin/env bash
# CLI for the callback-box dev router and worktrees.
#
# Commands:
#   create <name>      Create (or re-attach to) a worktree, ready to work in:
#                      box clone, installs, Codex mirrors, box hooks. Prints the
#                      worktree path on stdout; logs go to stderr. Idempotent.
#                      Options: --base-ref <ref> (default main), --path <dir>.
#                      This is the agent-neutral entry point — Claude Code's
#                      WorktreeCreate hook and bin/launch-worktree-session are
#                      both thin clients of it.
#   remove <name>      Remove one worktree, its box clone, and its router/cache
#                      state. Refuses when the branch is unmerged, the tree is
#                      dirty, or an agent is live in it. --force overrides the
#                      first two; nothing overrides the liveness check.
#                      --keep-branch keeps the branch, --dry-run just reports.
#   list [--json]      Every worktree, joined across all three signals: git
#                      (ahead/dirty/merged), the router (cold/ready/ports), and
#                      agent liveness (none/live/unknown). Works with no router
#                      running — the runtime column degrades to "unknown".
#   serve              Run the router in the foreground.
#   status             Raw router status JSON (what the router itself reports).
#   down <name>        Tell the router to stop a worktree's processes.
#   panic              Kill the router + any known children, wipe state.
#                      Use when you suspect orphans.
#   sweep              Remove worktrees whose branch is fully merged into
#                      main, are clean, and have no active claude/codex session.
#                      Also prunes orphaned browse/log/pid state for
#                      already-removed worktrees. Add --dry-run to preview.
#   help               This text.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
STATE_DIR="${CALLBACK_STATE_DIR:-$HOME/.cache/callback-box}"
ROUTER_PID_FILE="$STATE_DIR/router.pid"
PID_DIR="$STATE_DIR/pids"
ROUTER_PORT="${ROUTER_PORT:-3210}"
# The router's TCP listener now authenticates every request (it's exposable over
# Tailscale). Local CLI reaches the router's control routes through the
# trusted-local Unix-domain socket instead, which is unauthenticated by capability
# (a non-browser, same-user-only channel). See bin/CLAUDE.md / expose-dev-router.md.
ROUTER_SOCK="$STATE_DIR/router.sock"

cmd="${1:-status}"
shift || true

case "$cmd" in
  create)
    name=""
    base_ref="main"
    want_path=""
    while [ $# -ge 1 ]; do
      case "$1" in
        --base-ref) [ $# -ge 2 ] || { echo "worktrees create: --base-ref needs a value" >&2; exit 1; }; base_ref="$2"; shift 2 ;;
        --base-ref=*) base_ref="${1#--base-ref=}"; shift ;;
        --path)     [ $# -ge 2 ] || { echo "worktrees create: --path needs a value" >&2; exit 1; }; want_path="$2"; shift 2 ;;
        --path=*)   want_path="${1#--path=}"; shift ;;
        -*)         echo "worktrees create: unknown option $1" >&2; exit 1 ;;
        *)          [ -z "$name" ] || { echo "worktrees create: unexpected argument $1" >&2; exit 1; }; name="$1"; shift ;;
      esac
    done
    [ -n "$name" ] || { echo "usage: worktrees create <name> [--base-ref <ref>] [--path <dir>]" >&2; exit 1; }

    # Stdout carries exactly one thing: the resulting worktree path. Claude
    # Code's WorktreeCreate hook contract requires it, and every other caller
    # wants it too.
    #
    # Enforced structurally rather than by discipline: stash the real stdout on
    # fd 3 and point fd 1 at stderr for the whole command, so every child
    # process inherits a stdout that is already stderr. Individual `>&2` in the
    # steps below are then belt-and-braces. Without this, any child that prints
    # to stdout silently corrupts the contract — `bin/generate-agents-md.ts`
    # does exactly that ("wrote 18 AGENTS.md mirror(s)…"), and its line landed in
    # the returned path until this was added.
    exec 3>&1 1>&2
    # shellcheck source=lib/worktree-create.sh
    . "$REPO_DIR/bin/lib/worktree-create.sh"
    trap 'rc=$?; echo "[worktree-create] FAILED at line $LINENO (exit $rc). Worktree may be partially set up at ${WT_CREATED_PATH:-unknown}." >&2; exit $rc' ERR
    wt_create "$name" "$base_ref" "$want_path"
    printf '%s\n' "$WT_CREATED_PATH" >&3
    ;;

  remove)
    name=""
    force=false
    keep_branch=""
    dry_run=false
    while [ $# -ge 1 ]; do
      case "$1" in
        --force)       force=true; shift ;;
        --keep-branch) keep_branch="--keep-branch"; shift ;;
        --dry-run)     dry_run=true; shift ;;
        -*)            echo "worktrees remove: unknown option $1" >&2; exit 1 ;;
        *)             [ -z "$name" ] || { echo "worktrees remove: unexpected argument $1" >&2; exit 1; }; name="$1"; shift ;;
      esac
    done
    [ -n "$name" ] || { echo "usage: worktrees remove <name> [--force] [--keep-branch] [--dry-run]" >&2; exit 1; }

    # shellcheck source=lib/worktree-teardown.sh
    . "$REPO_DIR/bin/lib/worktree-teardown.sh"
    WT_LOG_LABEL="Remove"
    WT_SAY_PREFIX="  "
    target="$WT_ROOT/$name"
    [ -d "$target" ] || { echo "worktrees remove: no worktree at $target" >&2; exit 1; }

    # The liveness check is NOT subject to --force. Merged/dirty are judgements
    # about work you can still recover from a branch; a live agent is work in
    # flight, and there is no version of "I meant it" that makes deleting the
    # directory out from under a running session correct. `unknown` counts as
    # live — see wt_other_agent_live.
    wt_other_agent_live "$target"
    if [ "$WT_AGENT_STATE" != "none" ]; then
      echo "refusing: $name has agent=$WT_AGENT_STATE ($WT_AGENT_REASON)" >&2
      echo "  (--force does not apply to liveness; close the session first)" >&2
      exit 1
    fi

    wt_work_state "$target"
    if [ "$force" = false ] && { [ "$WT_AHEAD" != "0" ] || [ "$WT_DIRTY" != "0" ]; }; then
      echo "refusing: $name has ahead=$WT_AHEAD non-deletion-dirty=$WT_DIRTY" >&2
      [ -n "$WT_BLOCKERS" ] && echo "  blockers: $WT_BLOCKERS" >&2
      echo "  (pass --force to remove anyway; --keep-branch to keep the commits)" >&2
      exit 1
    fi

    if [ "$dry_run" = true ]; then
      echo "would remove $name (branch=$WT_BRANCH ahead=$WT_AHEAD dirty=$WT_DIRTY)"
      exit 0
    fi
    echo "remove $name (branch=$WT_BRANCH)"
    if [ -n "$keep_branch" ]; then
      wt_remove_now "$target" "$WT_BRANCH" --keep-branch
    else
      wt_remove_now "$target" "$WT_BRANCH"
    fi
    ;;

  serve)
    exec "$REPO_DIR/node_modules/.bin/tsx" "$REPO_DIR/bin/router.ts" "$@"
    ;;

  list)
    as_json=false
    [ "${1:-}" = "--json" ] && as_json=true

    # Implemented in bash, not TypeScript, for one reason: the agent-liveness
    # answer must come from wt_other_agent_live and nowhere else. A second
    # implementation of a guard that stands in front of an irreversible delete is
    # exactly the duplication that produced the fail-open bug this refactor
    # closed, and a TS reimplementation would be precisely that.
    # shellcheck source=lib/worktree-teardown.sh
    . "$REPO_DIR/bin/lib/worktree-teardown.sh"
    WT_LOG_LABEL="List"
    wt_agent_snapshot_capture

    # One router query for the whole listing. A router that is down, wedged, or
    # simply not started is normal — every runtime field then reports "unknown",
    # which is distinct from a worktree the router knows to be "cold".
    router_json=$(curl -fsS -m 3 --unix-socket "$ROUTER_SOCK" "http://router/__router/status" 2>/dev/null || true)

    rows="[]"
    for d in "$WT_ROOT"/*; do
      [ -d "$d" ] || continue
      name=$(basename "$d")

      wt_other_agent_live "$d"
      wt_work_state "$d"

      # `git status` failing yields "?" from wt_work_state. Carry that through as
      # JSON null rather than coercing it to a number — a reader must not be able
      # to mistake "could not tell" for "clean".
      merged="null"
      [ "$WT_AHEAD" = "0" ] && merged=true
      [ "$WT_AHEAD" != "0" ] && [ "$WT_AHEAD" != "?" ] && merged=false

      if [ -n "$router_json" ]; then
        runtime=$(printf '%s' "$router_json" | jq -c --arg n "$name" '.worktrees[$n] // {state:"unknown"}')
      else
        runtime='{"state":"unknown"}'
      fi

      rows=$(jq -c \
        --argjson rows "$rows" \
        --arg name "$name" \
        --arg branch "$WT_BRANCH" \
        --arg path "$d" \
        --arg ahead "$WT_AHEAD" \
        --arg dirty "$WT_DIRTY" \
        --argjson merged "$merged" \
        --argjson runtime "$runtime" \
        --arg agentState "$WT_AGENT_STATE" \
        --arg agentReason "$WT_AGENT_REASON" \
        --arg box "$WT_BOX_ROOT/$name/test1" \
        --arg url "http://localhost:${ROUTER_PORT}/$name/" \
        -n '$rows + [{
              name: $name, branch: $branch, path: $path, box: $box, url: $url,
              git: {
                ahead:  (if $ahead == "?" then null else ($ahead | tonumber) end),
                dirty:  (if $dirty == "?" then null else ($dirty | tonumber) end),
                merged: $merged
              },
              runtime: $runtime,
              agent: { state: $agentState, reason: $agentReason }
            }]')
    done

    if [ "$as_json" = true ]; then
      printf '%s\n' "$rows" | jq .
    else
      printf '%s\n' "$rows" | jq -r '
        (["WORKTREE","AGENT","GIT","RUNTIME"] | @tsv),
        (.[] | [
          .name,
          .agent.state,
          ((if .git.ahead == null then "ahead=?" else "ahead=\(.git.ahead)" end) +
           (if .git.dirty == null then " dirty=?" elif .git.dirty > 0 then " dirty=\(.git.dirty)" else "" end)),
          .runtime.state
        ] | @tsv)' | column -t -s "$(printf '\t')"
    fi
    ;;

  status)
    if ! [ -f "$ROUTER_PID_FILE" ] || ! kill -0 "$(cat "$ROUTER_PID_FILE" 2>/dev/null)" 2>/dev/null; then
      echo "router not running"
      if [ -d "$PID_DIR" ] && [ -n "$(ls -A "$PID_DIR" 2>/dev/null)" ]; then
        echo "(stale PID files present in $PID_DIR — run \`bin/worktrees panic\` to clean)"
      fi
      exit 0
    fi
    curl -fsS --unix-socket "$ROUTER_SOCK" "http://router/__router/status" | jq .
    ;;

  down)
    name="${1:?usage: worktrees down <name>}"
    if ! [ -f "$ROUTER_PID_FILE" ]; then
      echo "router not running"
      exit 0
    fi
    curl -fsS -X POST --unix-socket "$ROUTER_SOCK" "http://router/__router/stop/$name"
    ;;

  panic)
    # Nuclear cleanup. SIGTERM, then SIGKILL after a grace window.
    killed_any=0
    if [ -f "$ROUTER_PID_FILE" ]; then
      pid=$(cat "$ROUTER_PID_FILE")
      if kill -TERM "$pid" 2>/dev/null; then
        echo "sent SIGTERM to router pid $pid"
        killed_any=1
      fi
    fi
    if [ -d "$PID_DIR" ]; then
      for f in "$PID_DIR"/*.json; do
        [ -f "$f" ] || continue
        while IFS= read -r p; do
          [ -n "$p" ] || continue
          if kill -TERM "$p" 2>/dev/null; then
            echo "sent SIGTERM to child pid $p"
            killed_any=1
          fi
        done < <(jq -r '.vitePid // empty, .fastifyPid // empty' "$f")
        # Per-worktree dashboard writes its PID into <socketDir>/dashboard.pid
        sock_dir=$(jq -r '.socketDir // empty' "$f")
        if [ -n "$sock_dir" ] && [ -f "$sock_dir/dashboard.pid" ]; then
          dp=$(cat "$sock_dir/dashboard.pid" 2>/dev/null || true)
          if [ -n "$dp" ] && kill -TERM "$dp" 2>/dev/null; then
            echo "sent SIGTERM to dashboard pid $dp"
            killed_any=1
          fi
        fi
      done
    fi
    if [ "$killed_any" = 1 ]; then
      sleep 1
    fi
    # Escalate to SIGKILL.
    if [ -f "$ROUTER_PID_FILE" ]; then
      pid=$(cat "$ROUTER_PID_FILE" 2>/dev/null || true)
      [ -n "$pid" ] && kill -KILL "$pid" 2>/dev/null || true
    fi
    if [ -d "$PID_DIR" ]; then
      for f in "$PID_DIR"/*.json; do
        [ -f "$f" ] || continue
        while IFS= read -r p; do
          [ -n "$p" ] || continue
          kill -KILL "$p" 2>/dev/null || true
        done < <(jq -r '.vitePid // empty, .fastifyPid // empty' "$f")
        sock_dir=$(jq -r '.socketDir // empty' "$f")
        if [ -n "$sock_dir" ] && [ -f "$sock_dir/dashboard.pid" ]; then
          dp=$(cat "$sock_dir/dashboard.pid" 2>/dev/null || true)
          [ -n "$dp" ] && kill -KILL "$dp" 2>/dev/null || true
        fi
      done
    fi
    rm -f "$ROUTER_PID_FILE"
    rm -rf "$PID_DIR"
    # Also catch anything bound to our router port (defensive).
    if pids=$(lsof -tiTCP:"$ROUTER_PORT" -sTCP:LISTEN 2>/dev/null); then
      for p in $pids; do
        kill -KILL "$p" 2>/dev/null && echo "killed leftover on :$ROUTER_PORT (pid $p)" || true
      done
    fi
    # The pidfile-tracked kills above only ever knew the CURRENT generation of
    # each worktree plus the dashboard daemons. Reclaim what they can't see:
    # leaked older vite/fastify generations and any agent-browser daemons,
    # scoped to this project. With the router now dead, those vite/fastify are
    # orphans, so the aggressive sweep takes them; agent-browsers owned by an
    # active sibling claude session are still spared (never sabotage live work).
    if [ -x "$REPO_DIR/node_modules/.bin/tsx" ]; then
      "$REPO_DIR/node_modules/.bin/tsx" "$REPO_DIR/bin/process-cleanup.ts" panic || true
    fi
    echo "router stopped, state cleaned"
    ;;

  sweep)
    dry_run=false
    [ "${1:-}" = "--dry-run" ] && dry_run=true
    BROWSE_ROOT="$STATE_DIR/browse"
    LOGS_ROOT="$STATE_DIR/logs"

    # Locations are derived, never hardcoded — see bin/lib/worktree-paths.sh.
    # shellcheck source=lib/worktree-paths.sh
    . "$REPO_DIR/bin/lib/worktree-paths.sh"
    wt_paths_init "$REPO_DIR" || exit 1

    # Which worktrees have an active claude/codex session (never touch them)?
    # This uses the SHARED guard in bin/lib/worktree-teardown.sh rather than a
    # local copy. Sweep's reason for keeping its own — one process snapshot
    # reused across N worktrees — is now expressed by the snapshot API, and the
    # local copy's two-state answer was a fail-OPEN hole in front of an
    # irreversible delete (issues/bugs/2026-08-04-sweep-live-agent-guard-fails-open.md):
    # a `ps` or `lsof` that could not answer read as "nothing is running".
    # shellcheck source=lib/worktree-teardown.sh
    . "$REPO_DIR/bin/lib/worktree-teardown.sh"
    WT_LOG_LABEL="Sweep"
    wt_agent_snapshot_capture

    removed=0
    skipped_unknown=0
    for d in "$WT_ROOT"/*; do
      [ -e "$d" ] || continue
      name=$(basename "$d")
      # Skip non-dirs (e.g. stray symlinks) and known-active worktrees.
      if [ ! -d "$d" ]; then
        echo "stray (not a directory): $d — leaving alone, inspect manually"
        continue
      fi
      # `unknown` is NOT `none`. A ps/lsof that could not answer leaves the
      # worktree alone and says so; the next sweep collects it if it really is
      # idle, whereas a worktree deleted under live work is gone.
      wt_other_agent_live "$d"
      if [ "$WT_AGENT_STATE" != "none" ]; then
        echo "skip $name: agent=$WT_AGENT_STATE ($WT_AGENT_REASON)"
        [ "$WT_AGENT_STATE" = "unknown" ] && skipped_unknown=$((skipped_unknown + 1))
        continue
      fi
      # Shared with the hook teardown path: sets WT_BRANCH, WT_AHEAD, WT_DIRTY.
      # Deletion-only working-tree entries don't count as dirt (a cleanup killed
      # mid-delete leaves phantom `D` lines whose content is all in git), and a
      # `git status` that ERRORS reports "?" rather than the 0 that a bare
      # `grep -c` would have produced — "?" blocks, 0 authorizes.
      wt_work_state "$d"
      ahead="$WT_AHEAD"
      dirty="$WT_DIRTY"
      if [ "$ahead" != "0" ] || [ "$dirty" != "0" ]; then
        echo "skip $name: ahead=$ahead non-deletion-dirty=$dirty (has unmerged work)"
        continue
      fi
      branch="$WT_BRANCH"
      echo "remove $name (branch=$branch)"
      if [ "$dry_run" = false ]; then
        # One destructive implementation, shared with the SessionEnd and
        # codex-exit hooks. Sweep used to inline its own: `git worktree remove
        # --force` plus a synchronous `rm -rf` of the box, versus the shared
        # path's rename-into-trash and detached delete. The trash form is the
        # one hardened against being killed mid-delete (the 2026-06 half-deleted
        # worktree accumulation), and sweep — which runs unattended at every
        # session start and end — is the caller that most needs that.
        wt_remove_now "$d" "$branch"
        removed=$((removed + 1))
      fi
    done

    # Orphaned browse/log/pid state (no matching worktree, not "main").
    orphan_browse=0; orphan_logs=0; orphan_pids=0
    for d in "$BROWSE_ROOT"/*; do
      [ -d "$d" ] || continue
      name=$(basename "$d")
      [ "$name" = "main" ] && continue
      [ -d "$WT_ROOT/$name" ] && continue
      echo "orphan browse: $d"
      [ "$dry_run" = false ] && rm -rf "$d"
      orphan_browse=$((orphan_browse + 1))
    done
    for f in "$LOGS_ROOT"/*.log; do
      [ -f "$f" ] || continue
      name=$(basename "$f" .log)
      [ "$name" = "main" ] && continue
      [ -d "$WT_ROOT/$name" ] && continue
      echo "orphan log: $f"
      [ "$dry_run" = false ] && rm -f "$f"
      orphan_logs=$((orphan_logs + 1))
    done
    for f in "$PID_DIR"/*.json; do
      [ -f "$f" ] || continue
      name=$(basename "$f" .json)
      [ "$name" = "main" ] && continue
      [ -d "$WT_ROOT/$name" ] && continue
      echo "orphan pidfile: $f"
      [ "$dry_run" = false ] && rm -f "$f"
      orphan_pids=$((orphan_pids + 1))
    done

    # Private-issues orphan pass, UNCONDITIONALLY every sweep (hook logs are
    # best-effort, so this is the mechanism that guarantees an orphaned
    # private worktree/branch is eventually seen). The real run prunes stale
    # registrations and collects merged+clean orphans (sweep-orphans);
    # dry-run only lists (report-orphans). Unmerged orphans are re-announced
    # every run until resolved.
    if [ -x "$REPO_DIR/bin/private-issues" ]; then
      if [ "$dry_run" = true ]; then
        "$REPO_DIR/bin/private-issues" report-orphans "$REPO_DIR" 2>/dev/null | sed 's/^/private-issues /' || true
      else
        "$REPO_DIR/bin/private-issues" sweep-orphans "$REPO_DIR" 2>/dev/null | sed 's/^/private-issues /' || true
      fi
    fi

    suffix=""
    [ "$dry_run" = true ] && suffix=" (dry-run; nothing removed)"
    # Surfaced, not silent: an unknown-liveness skip means a guard declined to
    # answer, which is worth seeing if it ever becomes routine.
    [ "$skipped_unknown" -gt 0 ] && suffix="$suffix ($skipped_unknown skipped: liveness unknown)"
    echo "sweep done: $removed worktrees, $orphan_browse browse, $orphan_logs logs, $orphan_pids pids$suffix"
    ;;

  help | -h | --help)
    awk 'NR==1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
    ;;

  *)
    echo "unknown command: $cmd" >&2
    echo "run \`bin/worktrees help\` for usage" >&2
    exit 1
    ;;
esac
