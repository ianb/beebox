#!/usr/bin/env bash
# CLI for the callback-mono dev router and worktrees.
#
# Commands:
#   serve              Run the router in the foreground.
#   status, list       Show what the router is currently running.
#   down <name>        Tell the router to stop a worktree's processes.
#   panic              Kill the router + any known children, wipe state.
#                      Use when you suspect orphans.
#   sweep              Remove worktrees whose branch is fully merged into
#                      main, are clean, and have no active claude session.
#                      Also prunes orphaned browse/log/pid state for
#                      already-removed worktrees. Add --dry-run to preview.
#   help               This text.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
STATE_DIR="$HOME/.cache/callback-mono"
ROUTER_PID_FILE="$STATE_DIR/router.pid"
PID_DIR="$STATE_DIR/pids"
ROUTER_PORT="${ROUTER_PORT:-3210}"

cmd="${1:-status}"
shift || true

case "$cmd" in
  serve)
    exec "$REPO_DIR/node_modules/.bin/tsx" "$REPO_DIR/bin/router.ts" "$@"
    ;;

  status | list)
    if ! [ -f "$ROUTER_PID_FILE" ] || ! kill -0 "$(cat "$ROUTER_PID_FILE" 2>/dev/null)" 2>/dev/null; then
      echo "router not running"
      if [ -d "$PID_DIR" ] && [ -n "$(ls -A "$PID_DIR" 2>/dev/null)" ]; then
        echo "(stale PID files present in $PID_DIR — run \`bin/worktrees panic\` to clean)"
      fi
      exit 0
    fi
    curl -fsS "http://127.0.0.1:$ROUTER_PORT/__router/status" | jq .
    ;;

  down)
    name="${1:?usage: worktrees down <name>}"
    if ! [ -f "$ROUTER_PID_FILE" ]; then
      echo "router not running"
      exit 0
    fi
    curl -fsS -X POST "http://127.0.0.1:$ROUTER_PORT/__router/stop/$name"
    ;;

  panic)
    # Nuclear cleanup. SIGTERM, then SIGKILL after a grace window.
    killed_any=0
    if [ -f "$ROUTER_PID_FILE" ]; then
      pid=$(cat "$ROUTER_PID_FILE")
      if kill -TERM "$pid" 2>/dev/null; then
        echo "sent SIGTERM to router pid $pid"
        killed_any=1
      fi
    fi
    if [ -d "$PID_DIR" ]; then
      for f in "$PID_DIR"/*.json; do
        [ -f "$f" ] || continue
        while IFS= read -r p; do
          [ -n "$p" ] || continue
          if kill -TERM "$p" 2>/dev/null; then
            echo "sent SIGTERM to child pid $p"
            killed_any=1
          fi
        done < <(jq -r '.vitePid // empty, .fastifyPid // empty' "$f")
        # Per-worktree dashboard writes its PID into <socketDir>/dashboard.pid
        sock_dir=$(jq -r '.socketDir // empty' "$f")
        if [ -n "$sock_dir" ] && [ -f "$sock_dir/dashboard.pid" ]; then
          dp=$(cat "$sock_dir/dashboard.pid" 2>/dev/null || true)
          if [ -n "$dp" ] && kill -TERM "$dp" 2>/dev/null; then
            echo "sent SIGTERM to dashboard pid $dp"
            killed_any=1
          fi
        fi
      done
    fi
    if [ "$killed_any" = 1 ]; then
      sleep 1
    fi
    # Escalate to SIGKILL.
    if [ -f "$ROUTER_PID_FILE" ]; then
      pid=$(cat "$ROUTER_PID_FILE" 2>/dev/null || true)
      [ -n "$pid" ] && kill -KILL "$pid" 2>/dev/null || true
    fi
    if [ -d "$PID_DIR" ]; then
      for f in "$PID_DIR"/*.json; do
        [ -f "$f" ] || continue
        while IFS= read -r p; do
          [ -n "$p" ] || continue
          kill -KILL "$p" 2>/dev/null || true
        done < <(jq -r '.vitePid // empty, .fastifyPid // empty' "$f")
        sock_dir=$(jq -r '.socketDir // empty' "$f")
        if [ -n "$sock_dir" ] && [ -f "$sock_dir/dashboard.pid" ]; then
          dp=$(cat "$sock_dir/dashboard.pid" 2>/dev/null || true)
          [ -n "$dp" ] && kill -KILL "$dp" 2>/dev/null || true
        fi
      done
    fi
    rm -f "$ROUTER_PID_FILE"
    rm -rf "$PID_DIR"
    # Also catch anything bound to our router port (defensive).
    if pids=$(lsof -tiTCP:"$ROUTER_PORT" -sTCP:LISTEN 2>/dev/null); then
      for p in $pids; do
        kill -KILL "$p" 2>/dev/null && echo "killed leftover on :$ROUTER_PORT (pid $p)" || true
      done
    fi
    # The pidfile-tracked kills above only ever knew the CURRENT generation of
    # each worktree plus the dashboard daemons. Reclaim what they can't see:
    # leaked older vite/fastify generations and any agent-browser daemons,
    # scoped to this project. With the router now dead, those vite/fastify are
    # orphans, so the aggressive sweep takes them; agent-browsers owned by an
    # active sibling claude session are still spared (never sabotage live work).
    if [ -x "$REPO_DIR/node_modules/.bin/tsx" ]; then
      "$REPO_DIR/node_modules/.bin/tsx" "$REPO_DIR/bin/process-cleanup.ts" panic || true
    fi
    echo "router stopped, state cleaned"
    ;;

  sweep)
    dry_run=false
    [ "${1:-}" = "--dry-run" ] && dry_run=true
    MONO="$REPO_DIR"
    WT_ROOT="$HOME/src/callback-worktrees"
    BOX_ROOT="$HOME/src/box-worktrees"
    BROWSE_ROOT="$STATE_DIR/browse"
    LOGS_ROOT="$STATE_DIR/logs"

    # Which worktrees have an active claude session (so we never touch them)?
    # Two signals, both required to be absent before removal:
    #   1. argv — sessions launched as `claude --worktree <name>`
    #   2. process cwd — sessions resumed from inside the worktree don't
    #      carry the --worktree argv, but their claude process's cwd is in
    #      the worktree. lsof on the claude pids surfaces those.
    active=$(ps -axo command 2>/dev/null | grep -oE "claude --worktree [a-zA-Z0-9_-]+" | awk '{print $NF}' | sort -u)
    claude_pids=$(pgrep -x claude 2>/dev/null | tr '\n' ',' | sed 's/,$//')
    active_cwds=""
    if [ -n "$claude_pids" ]; then
      active_cwds=$(lsof -a -d cwd -p "$claude_pids" -Fn 2>/dev/null | sed -n 's/^n//p' | sort -u)
    fi

    removed=0
    for d in "$WT_ROOT"/*; do
      [ -e "$d" ] || continue
      name=$(basename "$d")
      # Skip non-dirs (e.g. stray symlinks) and known-active worktrees.
      if [ ! -d "$d" ]; then
        echo "stray (not a directory): $d — leaving alone, inspect manually"
        continue
      fi
      if echo "$active" | grep -qxF "$name"; then
        echo "skip $name: active claude session (argv)"
        continue
      fi
      if [ -n "$active_cwds" ] && echo "$active_cwds" | grep -qE "^$d(/|\$)"; then
        echo "skip $name: active claude session (cwd)"
        continue
      fi
      ahead=$(git -C "$d" rev-list --count main..HEAD 2>/dev/null || echo "?")
      # Deletion-only entries don't block removal: a cleanup killed mid-
      # delete (the old hook-timeout bug) leaves phantom `D` lines for
      # tracked files whose content is all in git. Real dirt (modified,
      # untracked, renamed, conflicted) still blocks.
      dirty=$(git -C "$d" status --porcelain 2>/dev/null | grep -cvE '^( D|D ) ' || true)
      if [ "$ahead" != "0" ] || [ "$dirty" != "0" ]; then
        echo "skip $name: ahead=$ahead non-deletion-dirty=$dirty (has unmerged work)"
        continue
      fi
      branch=$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
      echo "remove $name (branch=$branch)"
      if [ "$dry_run" = false ]; then
        curl -fsS -X POST -m 3 "http://127.0.0.1:$ROUTER_PORT/__router/stop/$name" >/dev/null 2>&1 || true
        git -C "$MONO" worktree remove --force "$d" 2>/dev/null || true
        # A half-deleted worktree can defeat `worktree remove` — fall back
        # to deleting the directory and pruning the registration.
        if [ -d "$d" ]; then
          rm -rf "$d"
          git -C "$MONO" worktree prune 2>/dev/null || true
        fi
        [ -n "$branch" ] && git -C "$MONO" branch -D "$branch" >/dev/null 2>&1 || true
        rm -rf "$BOX_ROOT/$name" "$BROWSE_ROOT/$name"
        rm -f "$LOGS_ROOT/$name.log" "$PID_DIR/$name.json"
        removed=$((removed + 1))
      fi
    done

    # Orphaned browse/log/pid state (no matching worktree, not "main").
    orphan_browse=0; orphan_logs=0; orphan_pids=0
    for d in "$BROWSE_ROOT"/*; do
      [ -d "$d" ] || continue
      name=$(basename "$d")
      [ "$name" = "main" ] && continue
      [ -d "$WT_ROOT/$name" ] && continue
      echo "orphan browse: $d"
      [ "$dry_run" = false ] && rm -rf "$d"
      orphan_browse=$((orphan_browse + 1))
    done
    for f in "$LOGS_ROOT"/*.log; do
      [ -f "$f" ] || continue
      name=$(basename "$f" .log)
      [ "$name" = "main" ] && continue
      [ -d "$WT_ROOT/$name" ] && continue
      echo "orphan log: $f"
      [ "$dry_run" = false ] && rm -f "$f"
      orphan_logs=$((orphan_logs + 1))
    done
    for f in "$PID_DIR"/*.json; do
      [ -f "$f" ] || continue
      name=$(basename "$f" .json)
      [ "$name" = "main" ] && continue
      [ -d "$WT_ROOT/$name" ] && continue
      echo "orphan pidfile: $f"
      [ "$dry_run" = false ] && rm -f "$f"
      orphan_pids=$((orphan_pids + 1))
    done

    suffix=""
    [ "$dry_run" = true ] && suffix=" (dry-run; nothing removed)"
    echo "sweep done: $removed worktrees, $orphan_browse browse, $orphan_logs logs, $orphan_pids pids$suffix"
    ;;

  help | -h | --help)
    awk 'NR==1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
    ;;

  *)
    echo "unknown command: $cmd" >&2
    echo "run \`bin/worktrees help\` for usage" >&2
    exit 1
    ;;
esac
