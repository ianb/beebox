#!/usr/bin/env bash
# CLI for the callback-box dev router and worktrees.
#
# Commands:
#   create <name>      Create (or re-attach to) a worktree, ready to work in:
#                      box clone, installs, Codex mirrors, box hooks. Prints the
#                      worktree path on stdout; logs go to stderr. Idempotent.
#                      Options: --base-ref <ref> (default main), --path <dir>.
#                      This is the agent-neutral entry point — Claude Code's
#                      WorktreeCreate hook and bin/launch-worktree-session are
#                      both thin clients of it.
#   remove <name>      Remove one worktree, its box clone, and its router/cache
#                      state. Refuses when the branch is unmerged, the tree is
#                      dirty, or an agent is live in it. --force overrides the
#                      first two; nothing overrides the liveness check.
#                      --keep-branch keeps the branch, --dry-run just reports.
#   focus <name>       Bring a live workstream's Terminal tab to the front.
#   close <name>       Close a merged, clean workstream's live Terminal tab.
#                      --force overrides merged/clean, never liveness safety.
#   resume <name>      Focus live, reopen idle, or recreate a culled workstream.
#                      Accepts an optional briefing as text, -, or @file.
#                      Options: --agent claude|codex, --fresh, --at-final-sha.
#   reset-test <name>  Hard-reset the workstream's test1 clone to test-setup.
#   confirm-tested <issue-basename>  Clear manual-testing on main and commit.
#   list [--json]      Every worktree, joined across git, runtime, agent,
#                      session-registry, and test1-clone state. Add
#                      --include-removed with --json for registry ghost rows.
#   agent-liveness <path>...
#                      Per-path claude/codex liveness (none|live|unknown) as
#                      JSON, from the one shared guard. For tooling that must
#                      not act on a live session's resources.
#   quotas --json      Claude and Codex account quota windows and reset times.
#   unset-claude-quota Remove the retired Claude quota status-line collector.
#   archive <name>     Keep a workstream but move it into the archived section.
#   unarchive <name>   Return an archived workstream to the active sections.
#   serve              Run the router in the foreground.
#   status             Raw router status JSON (what the router itself reports).
#   down <name>        Tell the router to stop a worktree's processes.
#   panic              Kill the router + any known children, wipe state.
#                      Use when you suspect orphans.
#   sweep              Remove worktrees whose branch is fully merged into
#                      main, are clean, and have no active claude/codex session.
#                      Also prunes orphaned browse/log/pid state for
#                      already-removed worktrees. Add --dry-run to preview.
#   help               This text.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
STATE_DIR="${CALLBACK_STATE_DIR:-$HOME/.cache/callback-box}"
ROUTER_PID_FILE="$STATE_DIR/router.pid"
PID_DIR="$STATE_DIR/pids"
ROUTER_PORT="${ROUTER_PORT:-3210}"
# The router's TCP listener now authenticates every request (it's exposable over
# Tailscale). Local CLI reaches the router's control routes through the
# trusted-local Unix-domain socket instead, which is unauthenticated by capability
# (a non-browser, same-user-only channel). See bin/CLAUDE.md / expose-dev-router.md.
ROUTER_SOCK="$STATE_DIR/router.sock"

cmd="${1:-status}"
shift || true

case "$cmd" in
  agent-liveness)
    # Per-path agent liveness for tooling that stands in front of something
    # destructive — today `bin/process-cleanup.ts`, which must not reclaim an
    # agent-browser a live session is using. Takes ABSOLUTE PATHS, not names, so
    # a caller with its own notion of where checkouts live (process-cleanup
    # scopes by path prefix) needs no agreement with this script about roots,
    # and the main checkout is just another path.
    #
    # Same reason `list` is bash: the answer comes from wt_other_agent_live and
    # nowhere else. A second implementation of a guard this destructive is the
    # duplication that produced the fail-open sweep bug of 2026-08-04.
    [ $# -ge 1 ] || { echo "usage: workstreams agent-liveness <worktree-path>..." >&2; exit 1; }
    # shellcheck source=lib/worktree-teardown.sh
    . "$REPO_DIR/bin/lib/worktree-teardown.sh"
    WT_LOG_LABEL="AgentLiveness"
    # One system-wide ps/lsof snapshot reused across every path asked about.
    wt_agent_snapshot_capture
    liveness_paths="{}"
    for wt_path in "$@"; do
      wt_other_agent_live "$wt_path"
      liveness_paths=$(jq -c -n \
        --argjson paths "$liveness_paths" \
        --arg path "$wt_path" \
        --arg state "$WT_AGENT_STATE" \
        --arg reason "$WT_AGENT_REASON" \
        '$paths + {($path): {state: $state, reason: $reason}}')
    done
    jq -c -n --argjson paths "$liveness_paths" '{ok: true, paths: $paths}'
    ;;

  quotas)
    [ "${1:-}" = "--json" ] && [ $# -eq 1 ] || { echo "usage: workstreams quotas --json" >&2; exit 1; }
    exec node --import tsx "$REPO_DIR/bin/agent-quotas.ts"
    ;;

  unset-claude-quota)
    [ $# -eq 0 ] || { echo "usage: workstreams unset-claude-quota" >&2; exit 1; }
    command -v jq >/dev/null || { echo "workstreams unset-claude-quota: jq is required" >&2; exit 1; }
    config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    settings="$config_dir/settings.json"
    [ -f "$settings" ] || exit 0
    jq -e 'type == "object"' "$settings" >/dev/null 2>&1 || {
      echo "workstreams unset-claude-quota: refusing malformed settings file: $settings" >&2
      exit 1
    }
    existing=$(jq -r '.statusLine.command // empty' "$settings")
    if [ -z "$existing" ]; then
      exit 0
    fi
    if [[ "$existing" != */bin/claude-quota-statusline ]]; then
      echo "workstreams unset-claude-quota: refusing to remove unrelated statusLine command: $existing" >&2
      exit 1
    fi
    settings_tmp=$(mktemp "$config_dir/settings.json.XXXXXX")
    jq 'del(.statusLine)' "$settings" > "$settings_tmp"
    chmod 600 "$settings_tmp"
    mv "$settings_tmp" "$settings"
    echo "Removed the retired Claude quota status-line collector."
    ;;

  archive|unarchive)
    name="${1:-}"
    [ -n "$name" ] && [ $# -eq 1 ] || { echo "usage: workstreams $cmd <name>" >&2; exit 1; }
    # shellcheck source=lib/worktree-paths.sh
    . "$REPO_DIR/bin/lib/worktree-paths.sh"
    wt_paths_init "$REPO_DIR" || exit 1
    wt_paths_valid_name "$name" \
      || { echo "workstreams $cmd: invalid workstream name '$name'" >&2; exit 1; }
    # shellcheck source=lib/session-registry.sh
    . "$REPO_DIR/bin/lib/session-registry.sh"
    record=$(session_registry_read "$name" || true)
    if [ ! -d "$WT_ROOT/$name" ] && [ -z "$record" ]; then
      echo "workstreams $cmd: unknown workstream '$name'" >&2
      exit 1
    fi
    if [ "$cmd" = archive ]; then
      if printf '%s' "$record" | jq -e '.removed.merged == false' >/dev/null 2>&1; then
        echo "workstreams archive: refusing to hide recovery state for '$name'" >&2
        exit 1
      fi
      archived_at=$(printf '%s' "$record" | jq -r '.archived.at // empty' 2>/dev/null || true)
      [ -n "$archived_at" ] || archived_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      patch=$(jq -cn --arg at "$archived_at" '{archived:{at:$at}}')
    else
      patch='{"archived":null}'
    fi
    session_registry_merge "$name" "$patch"
    echo "workstreams $cmd: $name"
    ;;

  create)
    name=""
    base_ref="main"
    box_ref=""
    want_path=""
    while [ $# -ge 1 ]; do
      case "$1" in
        --base-ref) [ $# -ge 2 ] || { echo "workstreams create: --base-ref needs a value" >&2; exit 1; }; base_ref="$2"; shift 2 ;;
        --base-ref=*) base_ref="${1#--base-ref=}"; shift ;;
        --path)     [ $# -ge 2 ] || { echo "workstreams create: --path needs a value" >&2; exit 1; }; want_path="$2"; shift 2 ;;
        --path=*)   want_path="${1#--path=}"; shift ;;
        --box-ref) [ $# -ge 2 ] || { echo "workstreams create: --box-ref needs a value" >&2; exit 1; }; box_ref="$2"; shift 2 ;;
        --box-ref=*) box_ref="${1#--box-ref=}"; shift ;;
        -*)         echo "workstreams create: unknown option $1" >&2; exit 1 ;;
        *)          [ -z "$name" ] || { echo "workstreams create: unexpected argument $1" >&2; exit 1; }; name="$1"; shift ;;
      esac
    done
    [ -n "$name" ] || { echo "usage: workstreams create <name> [--base-ref <ref>] [--path <dir>]" >&2; exit 1; }

    # Stdout carries exactly one thing: the resulting worktree path. Claude
    # Code's WorktreeCreate hook contract requires it, and every other caller
    # wants it too.
    #
    # Enforced structurally rather than by discipline: stash the real stdout on
    # fd 3 and point fd 1 at stderr for the whole command, so every child
    # process inherits a stdout that is already stderr. Individual `>&2` in the
    # steps below are then belt-and-braces. Without this, any child that prints
    # to stdout silently corrupts the contract — `bin/generate-agents-md.ts`
    # does exactly that ("wrote 18 AGENTS.md mirror(s)…"), and its line landed in
    # the returned path until this was added.
    exec 3>&1 1>&2
    # shellcheck source=lib/worktree-create.sh
    . "$REPO_DIR/bin/lib/worktree-create.sh"
    # Validated before the ERR trap is armed, so a bad name reports itself
    # rather than the trap's "may be partially set up" — nothing has been
    # created yet. wt_create re-checks for callers that source the lib directly.
    wt_paths_valid_name "$name" \
      || { echo "workstreams create: '$name' is not a worktree name ([a-zA-Z0-9_-]+, no slashes)" >&2; exit 1; }
    trap 'rc=$?; echo "[worktree-create] FAILED at line $LINENO (exit $rc). Worktree may be partially set up at ${WT_CREATED_PATH:-unknown}." >&2; exit $rc' ERR
    wt_create "$name" "$base_ref" "$want_path" "$box_ref"
    printf '%s\n' "$WT_CREATED_PATH" >&3
    ;;

  remove)
    name=""
    force=false
    keep_branch=""
    dry_run=false
    while [ $# -ge 1 ]; do
      case "$1" in
        --force)       force=true; shift ;;
        --keep-branch) keep_branch="--keep-branch"; shift ;;
        --dry-run)     dry_run=true; shift ;;
        -*)            echo "workstreams remove: unknown option $1" >&2; exit 1 ;;
        *)             [ -z "$name" ] || { echo "workstreams remove: unexpected argument $1" >&2; exit 1; }; name="$1"; shift ;;
      esac
    done
    [ -n "$name" ] || { echo "usage: workstreams remove <name> [--force] [--keep-branch] [--dry-run]" >&2; exit 1; }

    # shellcheck source=lib/worktree-teardown.sh
    . "$REPO_DIR/bin/lib/worktree-teardown.sh"
    . "$REPO_DIR/bin/lib/workstream-box-state.sh"
    # See the note in `list`: the lib clears the roots instead of exiting, and a
    # destructive command must not proceed on an empty one.
    wt_paths_init "$REPO_DIR" || exit 1
    WT_LOG_LABEL="Remove"
    WT_SAY_PREFIX="  "
    # Validate BEFORE building a path. `remove ../boxes/test1` would otherwise
    # resolve outside WT_ROOT, pass the `-d` check, and trash the source box.
    wt_paths_valid_name "$name" \
      || { echo "workstreams remove: '$name' is not a worktree name ([a-zA-Z0-9_-]+, no slashes)" >&2; exit 1; }
    target="$WT_ROOT/$name"
    [ -d "$target" ] || { echo "workstreams remove: no worktree at $target" >&2; exit 1; }

    # The liveness check is NOT subject to --force. Merged/dirty are judgements
    # about work you can still recover from a branch; a live agent is work in
    # flight, and there is no version of "I meant it" that makes deleting the
    # directory out from under a running session correct. `unknown` counts as
    # live — see wt_other_agent_live.
    wt_other_agent_live "$target"
    if [ "$WT_AGENT_STATE" != "none" ]; then
      echo "refusing: $name has agent=$WT_AGENT_STATE ($WT_AGENT_REASON)" >&2
      echo "  (--force does not apply to liveness; close the session first)" >&2
      exit 1
    fi

    wt_work_state "$target"
    if [ "$force" = false ] && { [ "$WT_AHEAD" != "0" ] || [ "$WT_DIRTY" != "0" ]; }; then
      echo "refusing: $name has ahead=$WT_AHEAD non-deletion-dirty=$WT_DIRTY" >&2
      [ -n "$WT_BLOCKERS" ] && echo "  blockers: $WT_BLOCKERS" >&2
      echo "  (pass --force to remove anyway; --keep-branch to keep the commits)" >&2
      exit 1
    fi

    if [ "$force" = false ] && pin_reason=$(workstream_cull_pin_reason "$name"); then
      echo "refusing: $name is pinned=$pin_reason" >&2
      echo "  (confirm testing or use release; --force preserves keep before removal)" >&2
      exit 1
    fi

    if [ "$dry_run" = true ]; then
      echo "would remove $name (branch=$WT_BRANCH ahead=$WT_AHEAD dirty=$WT_DIRTY)"
      exit 0
    fi
    echo "remove $name (branch=$WT_BRANCH)"
    preserve_arg="--preserve-box"
    if [ -n "$keep_branch" ]; then
      wt_remove_now "$target" "$WT_BRANCH" --keep-branch $preserve_arg
    else
      wt_remove_now "$target" "$WT_BRANCH" $preserve_arg
    fi
    ;;

  focus)
    name="${1:-}"
    # shellcheck source=lib/worktree-teardown.sh
    . "$REPO_DIR/bin/lib/worktree-teardown.sh"
    wt_paths_init "$REPO_DIR" || exit 1
    if [ $# -ne 1 ] || ! wt_paths_valid_name "$name"; then
      echo "usage: workstreams focus <name>" >&2
      exit 1
    fi
    # shellcheck source=lib/session-registry.sh
    . "$REPO_DIR/bin/lib/session-registry.sh"
    # shellcheck source=lib/terminal-tabs.sh
    . "$REPO_DIR/bin/lib/terminal-tabs.sh"
    record=$(session_registry_read "$name" || true)
    tty_path=$(printf '%s' "$record" | jq -r '.tty // empty' 2>/dev/null || true)
    if [ -z "$tty_path" ] || ! terminal_agent_on_tty "$tty_path" "$WT_ROOT/$name"; then
      echo "workstreams focus: no live session for $name — use resume" >&2
      exit 1
    fi
    terminal_focus_tty "$tty_path" || {
      echo "workstreams focus: Terminal has no tab for $name at $tty_path — use resume" >&2
      exit 1
    }
    ;;

  close)
    name=""
    force=false
    while [ $# -ge 1 ]; do
      case "$1" in
        --force) force=true; shift ;;
        -*) echo "workstreams close: unknown option $1" >&2; exit 1 ;;
        *) [ -z "$name" ] || { echo "workstreams close: unexpected argument $1" >&2; exit 1; }; name="$1"; shift ;;
      esac
    done
    # shellcheck source=lib/worktree-teardown.sh
    . "$REPO_DIR/bin/lib/worktree-teardown.sh"
    wt_paths_init "$REPO_DIR" || exit 1
    [ -n "$name" ] && wt_paths_valid_name "$name" || {
      echo "usage: workstreams close <name> [--force]" >&2
      exit 1
    }
    target="$WT_ROOT/$name"
    [ -d "$target" ] || { echo "workstreams close: no worktree at $target" >&2; exit 1; }

    wt_other_agent_live "$target"
    case "$WT_AGENT_STATE" in
      live) ;;
      none) echo "workstreams close: no live session for $name — use resume" >&2; exit 1 ;;
      *) echo "workstreams close: liveness unknown ($WT_AGENT_REASON) — refusing" >&2; exit 1 ;;
    esac
    wt_work_state "$target"
    if [ "$force" = false ] && { [ "$WT_AHEAD" != "0" ] || [ "$WT_DIRTY" != "0" ]; }; then
      echo "workstreams close: refusing $name (ahead=$WT_AHEAD dirty=$WT_DIRTY); pass --force to close anyway" >&2
      exit 1
    fi

    # shellcheck source=lib/session-registry.sh
    . "$REPO_DIR/bin/lib/session-registry.sh"
    # shellcheck source=lib/terminal-tabs.sh
    . "$REPO_DIR/bin/lib/terminal-tabs.sh"
    record=$(session_registry_read "$name" || true)
    tty_path=$(printf '%s' "$record" | jq -r '.tty // empty' 2>/dev/null || true)
    if [ -z "$tty_path" ] || ! terminal_agent_on_tty "$tty_path" "$target"; then
      echo "workstreams close: registry tty is stale for $name — refusing" >&2
      exit 1
    fi
    terminal_close_tty "$tty_path" || {
      echo "workstreams close: could not close Terminal tab $tty_path" >&2
      exit 1
    }
    ;;

  resume)
    workstream_resume_status() {
      [ "${WORKSTREAM_RESUME_PROGRESS:-}" = 1 ] || return 0
      printf '\nWORKSTREAM_RESUME_STATUS:%s\n' "$1" >&2
    }
    name=""
    requested_agent=""
    fresh=false
    at_final_sha=false
    briefing_args=()
    while [ $# -ge 1 ]; do
      case "$1" in
        --agent) [ $# -ge 2 ] || { echo "workstreams resume: --agent needs a value" >&2; exit 1; }; requested_agent="$2"; shift 2 ;;
        --agent=*) requested_agent="${1#--agent=}"; shift ;;
        --fresh) fresh=true; shift ;;
        --at-final-sha) at_final_sha=true; shift ;;
        --) shift; briefing_args=("$@"); break ;;
        -) [ -n "$name" ] || { echo "workstreams resume: workstream name must precede briefing" >&2; exit 1; }; briefing_args=("$@"); break ;;
        -*) echo "workstreams resume: unknown option $1" >&2; exit 1 ;;
        *)
          if [ -z "$name" ]; then name="$1"; shift
          else briefing_args=("$@"); break
          fi
          ;;
      esac
    done
    case "$requested_agent" in ""|claude|codex) ;; *) echo "workstreams resume: --agent must be claude or codex" >&2; exit 1 ;; esac

    # shellcheck source=lib/worktree-teardown.sh
    . "$REPO_DIR/bin/lib/worktree-teardown.sh"
    wt_paths_init "$REPO_DIR" || exit 1
    [ -n "$name" ] && wt_paths_valid_name "$name" || {
      echo "usage: workstreams resume [--agent claude|codex] [--fresh] [--at-final-sha] <name> [--] [<briefing> | - | @file]" >&2
      exit 1
    }
    # shellcheck source=lib/workstream-briefing.sh
    . "$REPO_DIR/bin/lib/workstream-briefing.sh"
    workstream_read_briefing "workstreams resume" ${briefing_args[@]+"${briefing_args[@]}"}
    # shellcheck source=lib/session-registry.sh
    . "$REPO_DIR/bin/lib/session-registry.sh"
    # shellcheck source=lib/workstream-resume.sh
    . "$REPO_DIR/bin/lib/workstream-resume.sh"
    workstream_resume_status checking
    record=$(session_registry_read "$name" || true)
    target="$WT_ROOT/$name"
    worktree_exists=false
    agent_state=none
    if [ -d "$target" ]; then
      worktree_exists=true
      wt_other_agent_live "$target"
      agent_state="$WT_AGENT_STATE"
    elif [ -n "$record" ]; then
      launch_status=$(session_registry_launch_status_from_record "$record" "$(date +%s)")
      case "$(jq -r '.state' <<<"$launch_status")" in
        active) agent_state="launching" ;;
        failed) agent_state="launch-failed" ;;
        expired) agent_state="launch-expired" ;;
        unknown) agent_state="unknown" ;;
      esac
    fi
    resume_state=$(workstream_resume_state "$worktree_exists" "$agent_state" "$record")
    case "$resume_state" in
      focus)
        if [ "$WORKSTREAM_BRIEFING_PROVIDED" = false ]; then
          exec "$REPO_DIR/bin/workstreams" focus "$name"
        fi
        handoff_file=$(mktemp -t "workstream-handoff.$name.XXXXXX")
        workstream_wrap_briefing "$WORKSTREAM_BRIEFING" > "$handoff_file"
        chmod 600 "$handoff_file"
        "$REPO_DIR/bin/workstreams" focus "$name" >/dev/null 2>&1 || true
        echo "workstreams resume: manual forwarding required: $handoff_file"
        exit 0
        ;;
      liveness-unknown)
        echo "workstreams resume: cannot determine liveness for $name ($WT_AGENT_REASON) — refusing to open a duplicate" >&2
        exit 1 ;;
      launch-in-progress)
        echo "workstreams resume: $name is already launching — wait for it to finish or expire" >&2
        exit 1 ;;
      unknown)
        echo "workstreams resume: unknown workstream '$name'; use launch-worktree-session to start new work" >&2
        exit 1 ;;
      removed-unmerged)
        if [ "$fresh" = false ] && [ "$at_final_sha" = false ]; then
          final_sha=$(printf '%s' "$record" | jq -r '.removed.finalSha // "not recorded"')
          echo "workstreams resume: $name was removed with unmerged work at $final_sha; pass --at-final-sha or --fresh" >&2
          exit 1
        fi
        ;;
    esac

    if [ "$resume_state" = "launch-retry" ]; then
      target=""
    fi

    resolved_agent="$requested_agent"
    [ -n "$resolved_agent" ] || resolved_agent=$(printf '%s' "$record" | jq -r '.agent // empty' 2>/dev/null || true)
    case "$resolved_agent" in
      claude|codex) ;;
      *) echo "workstreams resume: no recorded agent for $name; pass --agent claude or --agent codex" >&2; exit 1 ;;
    esac

    if [ "$resume_state" = "culled" ] || [ "$resume_state" = "removed-unmerged" ]; then
      workstream_resume_status restoring
      final_sha=$(printf '%s' "$record" | jq -r '.removed.finalSha // empty')
      box_ref=$(printf '%s' "$record" | jq -r '.removed.boxRef // empty')
      if [ "$at_final_sha" = true ]; then
        [ -n "$final_sha" ] || { echo "workstreams resume: no final SHA recorded; recreating at it is impossible" >&2; exit 1; }
        create_args=("$name" --base-ref "$final_sha")
        [ -n "$box_ref" ] && create_args+=(--box-ref "$box_ref")
        target=$("$REPO_DIR/bin/workstreams" create "${create_args[@]}")
        new_base_sha="$final_sha"
      else
        [ -n "$final_sha" ] || echo "workstreams resume: no final SHA recorded; recreating from main" >&2
        create_args=("$name")
        [ -n "$box_ref" ] && create_args+=(--box-ref "$box_ref")
        target=$("$REPO_DIR/bin/workstreams" create "${create_args[@]}")
        new_base_sha=$(git -C "$WT_MONO" rev-parse main)
      fi
      session_registry_merge "$name" "$(jq -n --arg baseSha "$new_base_sha" '{baseSha:$baseSha}')" || true
    fi

    workstream_resume_status preparing
    final_sha=$(printf '%s' "$record" | jq -r '.removed.finalSha // empty' 2>/dev/null || true)
    landed_log=""
    if [ -n "$final_sha" ] && git -C "$WT_MONO" cat-file -e "$final_sha^{commit}" 2>/dev/null; then
      landed_log=$(git -C "$WT_MONO" log --oneline "$final_sha..main" -50 2>/dev/null || true)
    fi
    # shellcheck source=lib/launch-session.sh
    . "$REPO_DIR/bin/lib/launch-session.sh"
    launch_dir=$(mktemp -d -t workstreams-resume.XXXXXX)
    prompt_file="$launch_dir/prompt.txt"
    workstream_continuation_prompt "$name" "$record" "$landed_log" > "$prompt_file"
    if [ "$WORKSTREAM_BRIEFING_PROVIDED" = true ]; then
      printf '\n' >> "$prompt_file"
      workstream_wrap_briefing "$WORKSTREAM_BRIEFING" >> "$prompt_file"
    fi
    emoji=$(printf '%s' "$record" | jq -r '.emoji // empty' 2>/dev/null || true)
    [ -n "$emoji" ] || emoji=$(launch_session_default_emoji "$name")
    model=$(printf '%s' "$record" | jq -r '.model // empty' 2>/dev/null || true)
    LS_MONO="$WT_MONO"
    LS_WORKSTREAM="$name"
    LS_SESSION_NAME="$emoji $name"
    LS_AGENT="$resolved_agent"
    LS_MODEL="$model"
    LS_REMOTE_CONTROL=1
    LS_PROMPT_FILE="$prompt_file"
    LS_EMOJI="$emoji"
    LS_LAUNCH_DIR="$launch_dir"
    LS_WORKTREE_PATH="$target"
    LS_CODEX_RESUME=0
    LS_DESCRIPTION_FILE=""
    if [ "$resolved_agent" = codex ] && [ "$fresh" = false ] && [ "$resume_state" = existing ]; then
      LS_CODEX_RESUME=1
    fi
    launch_session_build
    workstream_resume_status opening-terminal
    result=$(launch_session_open)
    workstream_resume_status opened
    if [ "$WORKSTREAM_BRIEFING_PROVIDED" = true ]; then
      echo "workstreams resume: launched $resolved_agent for $name with briefing ($result)"
    else
      echo "workstreams resume: launched $resolved_agent for $name ($result)"
    fi
    ;;

  reset-test)
    name="${1:-}"
    . "$REPO_DIR/bin/lib/worktree-paths.sh"
    wt_paths_init "$REPO_DIR" || exit 1
    [ $# -eq 1 ] || { echo "usage: workstreams reset-test <name>" >&2; exit 1; }
    . "$REPO_DIR/bin/lib/manual-testing.sh"
    workstream_reset_test "$name"
    ;;

  release)
    name="${1:-}"
    . "$REPO_DIR/bin/lib/worktree-teardown.sh"
    wt_paths_init "$REPO_DIR" || exit 1
    [ $# -eq 1 ] && wt_paths_valid_name "$name" || { echo "usage: workstreams release <name>" >&2; exit 1; }
    target="$WT_ROOT/$name"
    [ -d "$target" ] || { echo "workstreams release: no worktree for $name" >&2; exit 1; }
    wt_other_agent_live "$target"
    [ "$WT_AGENT_STATE" = none ] || { echo "workstreams release: agent=$WT_AGENT_STATE — refusing" >&2; exit 1; }
    wt_work_state "$target"
    [ "$WT_AHEAD" = 0 ] && [ "$WT_DIRTY" = 0 ] \
      || { echo "workstreams release: code is not merged and clean — refusing" >&2; exit 1; }
    wt_remove_now "$target" "$WT_BRANCH" --preserve-box
    ;;

  confirm-tested)
    basename=""
    agent_confirmed=false
    while [ $# -ge 1 ]; do
      case "$1" in
        --agent-confirmed) agent_confirmed=true; shift ;;
        -*) echo "workstreams confirm-tested: unknown option $1" >&2; exit 1 ;;
        *) [ -z "$basename" ] || { echo "workstreams confirm-tested: unexpected argument $1" >&2; exit 1; }; basename="$1"; shift ;;
      esac
    done
    [ -n "$basename" ] || { echo "usage: workstreams confirm-tested <issue-basename> [--agent-confirmed]" >&2; exit 1; }
    . "$REPO_DIR/bin/lib/worktree-paths.sh"
    wt_paths_init "$REPO_DIR" || exit 1
    . "$REPO_DIR/bin/lib/manual-testing.sh"
    workstream_confirm_tested "$basename" "$agent_confirmed"
    ;;

  serve)
    exec "$REPO_DIR/node_modules/.bin/tsx" "$REPO_DIR/bin/router.ts" "$@"
    ;;

  list)
    as_json=false
    include_removed=false
    while [ $# -ge 1 ]; do
      case "$1" in
        --json) as_json=true; shift ;;
        --include-removed) include_removed=true; shift ;;
        *) echo "workstreams list: unknown option $1" >&2; exit 1 ;;
      esac
    done
    if [ "$include_removed" = true ] && [ "$as_json" = false ]; then
      echo "workstreams list: --include-removed requires --json" >&2
      exit 1
    fi

    # Implemented in bash, not TypeScript, for one reason: the agent-liveness
    # answer must come from wt_other_agent_live and nowhere else. A second
    # implementation of a guard that stands in front of an irreversible delete is
    # exactly the duplication that produced the fail-open bug this refactor
    # closed, and a TS reimplementation would be precisely that.
    # shellcheck source=lib/worktree-teardown.sh
    . "$REPO_DIR/bin/lib/worktree-teardown.sh"
    # The lib CLEARS the roots on a derivation failure rather than exiting (it is
    # sourced by non-blocking hooks). A command that iterates `$WT_ROOT/*` must
    # turn that into an exit: an empty root globs to `/*`, i.e. the filesystem
    # root. Re-running init here reports the reason and stops.
    wt_paths_init "$REPO_DIR" || exit 1
    WT_LOG_LABEL="List"
    wt_agent_snapshot_capture
    # shellcheck source=lib/workstream-box-state.sh
    . "$REPO_DIR/bin/lib/workstream-box-state.sh"
    # shellcheck source=lib/workstream-routing.sh
    . "$REPO_DIR/bin/lib/workstream-routing.sh"

    # One router query for the whole listing. A router that is down, wedged, or
    # simply not started is normal — every runtime field then reports "unknown",
    # which is distinct from a worktree the router knows to be "cold".
    router_json=$(curl -fsS -m 3 --unix-socket "$ROUTER_SOCK" "http://router/__router/status" 2>/dev/null || true)

    registered_worktrees=""
    while IFS= read -r -d '' worktree_field; do
      case "$worktree_field" in
        "worktree "*)
          registered_path=${worktree_field#worktree }
          [ -d "$registered_path" ] || continue
          registered_path=$(cd "$registered_path" && pwd -P)
          registered_worktrees="${registered_worktrees}${registered_path}"$'\n'
          ;;
      esac
    done < <(git -C "$WT_MONO" worktree list --porcelain -z)
    now_epoch=$(date +%s)
    rows="[]"
    for d in "$WT_ROOT"/*; do
      [ -d "$d" ] || continue
      name=$(basename "$d")
      canonical_d=$(cd "$d" && pwd -P)
      if ! printf '%s' "$registered_worktrees" | grep -Fqx -- "$canonical_d"; then
        echo "workstreams list: ignoring non-worktree directory: $d" >&2
        continue
      fi

      wt_other_agent_live "$d"
      wt_work_state "$d"
      tip=$(git -C "$d" rev-parse HEAD 2>/dev/null || true)
      tip_epoch=$(git -C "$d" log -1 --format=%ct 2>/dev/null || true)
      dir_epoch=$(stat -f %m "$d" 2>/dev/null || stat -c %Y "$d" 2>/dev/null || true)

      # `git status` failing yields "?" from wt_work_state. Carry that through as
      # JSON null rather than coercing it to a number — a reader must not be able
      # to mistake "could not tell" for "clean".
      merged="null"
      [ "$WT_AHEAD" = "0" ] && merged=true
      [ "$WT_AHEAD" != "0" ] && [ "$WT_AHEAD" != "?" ] && merged=false

      if [ -n "$router_json" ]; then
        runtime=$(printf '%s' "$router_json" | jq -c --arg n "$name" '.worktrees[$n] // {state:"unknown"}')
      else
        runtime='{"state":"unknown"}'
      fi
      session=$(session_registry_summary "$name")
      record=$(session_registry_read "$name" || true)
      routing=$(workstream_routing_json true "$WT_AGENT_STATE" "$record" "$tip_epoch" "$dir_epoch" "$now_epoch")
      box_state=$(workstream_box_state "$WT_BOX_ROOT/$name/test1" "$WT_BOX_SRC")

      rows=$(jq -c \
        --argjson rows "$rows" \
        --arg name "$name" \
        --arg branch "$WT_BRANCH" \
        --arg path "$d" \
        --arg ahead "$WT_AHEAD" \
        --arg dirty "$WT_DIRTY" \
        --arg tip "$tip" \
        --argjson merged "$merged" \
        --argjson runtime "$runtime" \
        --argjson session "$session" \
        --argjson routing "$routing" \
        --argjson boxState "$box_state" \
        --arg agentState "$WT_AGENT_STATE" \
        --arg agentReason "$WT_AGENT_REASON" \
        --arg box "$WT_BOX_ROOT/$name/test1" \
        --arg url "http://localhost:${ROUTER_PORT}/$name/" \
        -n '$rows + [{
              name: $name, branch: $branch, path: $path, box: $box, url: $url,
              git: {
                ahead:  (if $ahead == "?" then null else ($ahead | tonumber) end),
                dirty:  (if $dirty == "?" then null else ($dirty | tonumber) end),
                merged: $merged,
                tip: (if $tip == "" then null else $tip end)
              },
              runtime: $runtime,
              agent: { state: $agentState, reason: $agentReason },
              session: $session,
              routing: $routing,
              boxState: $boxState
            }]')
    done

    if [ -d "$WT_STATE_DIR/workstreams" ]; then
      for registry_file in "$WT_STATE_DIR"/workstreams/*.json; do
        [ -f "$registry_file" ] || continue
        name=$(basename "$registry_file" .json)
        wt_paths_valid_name "$name" || continue
        [ -d "$WT_ROOT/$name" ] && continue
        record=$(session_registry_read "$name" || true)
        [ -n "$record" ] || continue
        session=$(session_registry_summary "$name")
        launch_state=$(printf '%s' "$session" | jq -r '.launch.state')
        removed_state=$(printf '%s' "$record" | jq -r 'if .removed != null then "true" else "false" end')
        if [ "$launch_state" = "none" ] && { [ "$include_removed" != true ] || [ "$removed_state" != true ]; }; then
          continue
        fi
        case "$launch_state" in
          active) registry_agent_state="launching"; registry_agent_reason="signal=launch-lease" ;;
          expired) registry_agent_state="none"; registry_agent_reason="launch=expired" ;;
          failed) registry_agent_state="none"; registry_agent_reason="launch=failed" ;;
          unknown)
            registry_agent_state="unknown"
            registry_agent_reason=$(printf '%s' "$session" | jq -r '.launch.reason // "invalid-launch-status"')
            ;;
          *) registry_agent_state="none"; registry_agent_reason="no-worktree" ;;
        esac
        routing=$(workstream_routing_json false "$registry_agent_state" "$record" "" "" "$now_epoch")
        box_state=$(workstream_box_state "$WT_BOX_ROOT/$name/test1" "$WT_BOX_SRC")
        branch=$(printf '%s' "$record" | jq -r --arg name "$name" '.branch // ("worktree-" + $name)')
        rows=$(jq -c \
          --argjson rows "$rows" \
          --arg name "$name" \
          --arg branch "$branch" \
          --argjson session "$session" \
          --argjson routing "$routing" \
          --argjson boxState "$box_state" \
          --arg agentState "$registry_agent_state" \
          --arg agentReason "$registry_agent_reason" \
          -n '$rows + [{
            name:$name, branch:$branch, path:null, box:null, url:null, git:null,
            runtime:{state:"absent"}, agent:{state:$agentState, reason:$agentReason},
            session:$session, routing:$routing, boxState:$boxState
          }]')
      done
    fi

    if [ "$as_json" = true ]; then
      printf '%s\n' "$rows" | jq .
    else
      printf '%s\n' "$rows" | jq -r '
        (["WORKTREE","STATE","ACTION","AGE","AGENT","GIT","RUNTIME","DESCRIPTION"] | @tsv),
        (.[] | [
          .name,
          .routing.state,
          .routing.action,
          (.routing.lastActivityAt // "?"),
          .agent.state,
          ((if .git.ahead == null then "ahead=?" else "ahead=\(.git.ahead)" end) +
           (if .git.dirty == null then " dirty=?" elif .git.dirty > 0 then " dirty=\(.git.dirty)" else "" end)),
          # A ready generation whose backend source has changed on disk since it
          # started is still serving the old code — visible here because nothing
          # replaces it automatically (bin/router-core.ts checkSourceFreshness).
          (.runtime.state + (if .runtime.staleSince then " (stale)" else "" end)),
          (.session.description // "")
        ] | @tsv)' | column -t -s "$(printf '\t')"
    fi
    ;;

  status)
    if ! [ -f "$ROUTER_PID_FILE" ] || ! kill -0 "$(cat "$ROUTER_PID_FILE" 2>/dev/null)" 2>/dev/null; then
      echo "router not running"
      if [ -d "$PID_DIR" ] && [ -n "$(ls -A "$PID_DIR" 2>/dev/null)" ]; then
        echo "(stale PID files present in $PID_DIR — run \`bin/workstreams panic\` to clean)"
      fi
      exit 0
    fi
    curl -fsS --unix-socket "$ROUTER_SOCK" "http://router/__router/status" | jq .
    ;;

  down)
    name="${1:?usage: workstreams down <name>}"
    if ! [ -f "$ROUTER_PID_FILE" ]; then
      echo "router not running"
      exit 0
    fi
    curl -fsS -X POST --unix-socket "$ROUTER_SOCK" "http://router/__router/stop/$name"
    ;;

  panic)
    # Nuclear cleanup. SIGTERM, then SIGKILL after a grace window.
    killed_any=0
    if [ -f "$ROUTER_PID_FILE" ]; then
      pid=$(cat "$ROUTER_PID_FILE")
      if kill -TERM "$pid" 2>/dev/null; then
        echo "sent SIGTERM to router pid $pid"
        killed_any=1
      fi
    fi
    if [ -d "$PID_DIR" ]; then
      for f in "$PID_DIR"/*.json; do
        [ -f "$f" ] || continue
        while IFS= read -r p; do
          [ -n "$p" ] || continue
          if kill -TERM "$p" 2>/dev/null; then
            echo "sent SIGTERM to child pid $p"
            killed_any=1
          fi
        done < <(jq -r '.vitePid // empty, .fastifyPid // empty' "$f")
        # Per-worktree dashboard writes its PID into <socketDir>/dashboard.pid
        sock_dir=$(jq -r '.socketDir // empty' "$f")
        if [ -n "$sock_dir" ] && [ -f "$sock_dir/dashboard.pid" ]; then
          dp=$(cat "$sock_dir/dashboard.pid" 2>/dev/null || true)
          if [ -n "$dp" ] && kill -TERM "$dp" 2>/dev/null; then
            echo "sent SIGTERM to dashboard pid $dp"
            killed_any=1
          fi
        fi
      done
    fi
    if [ "$killed_any" = 1 ]; then
      sleep 1
    fi
    # Escalate to SIGKILL.
    if [ -f "$ROUTER_PID_FILE" ]; then
      pid=$(cat "$ROUTER_PID_FILE" 2>/dev/null || true)
      [ -n "$pid" ] && kill -KILL "$pid" 2>/dev/null || true
    fi
    if [ -d "$PID_DIR" ]; then
      for f in "$PID_DIR"/*.json; do
        [ -f "$f" ] || continue
        while IFS= read -r p; do
          [ -n "$p" ] || continue
          kill -KILL "$p" 2>/dev/null || true
        done < <(jq -r '.vitePid // empty, .fastifyPid // empty' "$f")
        sock_dir=$(jq -r '.socketDir // empty' "$f")
        if [ -n "$sock_dir" ] && [ -f "$sock_dir/dashboard.pid" ]; then
          dp=$(cat "$sock_dir/dashboard.pid" 2>/dev/null || true)
          [ -n "$dp" ] && kill -KILL "$dp" 2>/dev/null || true
        fi
      done
    fi
    rm -f "$ROUTER_PID_FILE"
    rm -rf "$PID_DIR"
    # Also catch anything bound to our router port (defensive).
    if pids=$(lsof -tiTCP:"$ROUTER_PORT" -sTCP:LISTEN 2>/dev/null); then
      for p in $pids; do
        kill -KILL "$p" 2>/dev/null && echo "killed leftover on :$ROUTER_PORT (pid $p)" || true
      done
    fi
    # The pidfile-tracked kills above only ever knew the CURRENT generation of
    # each worktree plus the dashboard daemons. Reclaim what they can't see:
    # leaked older vite/fastify generations and any agent-browser daemons,
    # scoped to this project. With the router now dead, those vite/fastify are
    # orphans, so the aggressive sweep takes them; agent-browsers owned by an
    # active sibling claude session are still spared (never sabotage live work).
    if [ -x "$REPO_DIR/node_modules/.bin/tsx" ]; then
      "$REPO_DIR/node_modules/.bin/tsx" "$REPO_DIR/bin/process-cleanup.ts" panic || true
    fi
    echo "router stopped, state cleaned"
    ;;

  sweep)
    dry_run=false
    [ "${1:-}" = "--dry-run" ] && dry_run=true
    BROWSE_ROOT="$STATE_DIR/browse"
    LOGS_ROOT="$STATE_DIR/logs"

    # Locations are derived, never hardcoded — see bin/lib/worktree-paths.sh.
    # shellcheck source=lib/worktree-paths.sh
    . "$REPO_DIR/bin/lib/worktree-paths.sh"
    wt_paths_init "$REPO_DIR" || exit 1

    # Which worktrees have an active claude/codex session (never touch them)?
    # This uses the SHARED guard in bin/lib/worktree-teardown.sh rather than a
    # local copy. Sweep's reason for keeping its own — one process snapshot
    # reused across N worktrees — is now expressed by the snapshot API, and the
    # local copy's two-state answer was a fail-OPEN hole in front of an
    # irreversible delete (issues/bugs/2026-08-04-sweep-live-agent-guard-fails-open.md):
    # a `ps` or `lsof` that could not answer read as "nothing is running".
    # shellcheck source=lib/worktree-teardown.sh
    . "$REPO_DIR/bin/lib/worktree-teardown.sh"
    # shellcheck source=lib/workstream-box-state.sh
    . "$REPO_DIR/bin/lib/workstream-box-state.sh"
    WT_LOG_LABEL="Sweep"
    wt_agent_snapshot_capture

    removed=0
    skipped_unknown=0
    for d in "$WT_ROOT"/*; do
      [ -e "$d" ] || continue
      name=$(basename "$d")
      # Skip non-dirs (e.g. stray symlinks) and known-active worktrees.
      if [ ! -d "$d" ]; then
        echo "stray (not a directory): $d — leaving alone, inspect manually"
        continue
      fi
      # `unknown` is NOT `none`. A ps/lsof that could not answer leaves the
      # worktree alone and says so; the next sweep collects it if it really is
      # idle, whereas a worktree deleted under live work is gone.
      wt_other_agent_live "$d"
      if [ "$WT_AGENT_STATE" != "none" ]; then
        echo "skip $name: agent=$WT_AGENT_STATE ($WT_AGENT_REASON)"
        [ "$WT_AGENT_STATE" = "unknown" ] && skipped_unknown=$((skipped_unknown + 1))
        continue
      fi
      # Shared with the hook teardown path: sets WT_BRANCH, WT_AHEAD, WT_DIRTY.
      # Deletion-only working-tree entries don't count as dirt (a cleanup killed
      # mid-delete leaves phantom `D` lines whose content is all in git), and a
      # `git status` that ERRORS reports "?" rather than the 0 that a bare
      # `grep -c` would have produced — "?" blocks, 0 authorizes.
      wt_work_state "$d"
      ahead="$WT_AHEAD"
      dirty="$WT_DIRTY"
      if [ "$ahead" != "0" ] || [ "$dirty" != "0" ]; then
        echo "skip $name: ahead=$ahead non-deletion-dirty=$dirty (has unmerged work)"
        continue
      fi
      if pin_reason=$(workstream_cull_pin_reason "$name"); then
        echo "skip $name: pinned=$pin_reason"
        continue
      fi
      branch="$WT_BRANCH"
      echo "remove $name (branch=$branch)"
      if [ "$dry_run" = false ]; then
        # One destructive implementation, shared with the SessionEnd and
        # codex-exit hooks. Sweep used to inline its own: `git worktree remove
        # --force` plus a synchronous `rm -rf` of the box, versus the shared
        # path's rename-into-trash and detached delete. The trash form is the
        # one hardened against being killed mid-delete (the 2026-06 half-deleted
        # worktree accumulation), and sweep — which runs unattended at every
        # session start and end — is the caller that most needs that.
        wt_remove_now "$d" "$branch"
        removed=$((removed + 1))
      fi
    done

    # Orphaned browse/log/pid state (no matching worktree, not "main").
    orphan_browse=0; orphan_logs=0; orphan_pids=0
    for d in "$BROWSE_ROOT"/*; do
      [ -d "$d" ] || continue
      name=$(basename "$d")
      [ "$name" = "main" ] && continue
      [ -d "$WT_ROOT/$name" ] && continue
      echo "orphan browse: $d"
      [ "$dry_run" = false ] && rm -rf "$d"
      orphan_browse=$((orphan_browse + 1))
    done
    for f in "$LOGS_ROOT"/*.log; do
      [ -f "$f" ] || continue
      name=$(basename "$f" .log)
      [ "$name" = "main" ] && continue
      [ -d "$WT_ROOT/$name" ] && continue
      echo "orphan log: $f"
      [ "$dry_run" = false ] && rm -f "$f"
      orphan_logs=$((orphan_logs + 1))
    done
    for f in "$PID_DIR"/*.json; do
      [ -f "$f" ] || continue
      name=$(basename "$f" .json)
      [ "$name" = "main" ] && continue
      [ -d "$WT_ROOT/$name" ] && continue
      echo "orphan pidfile: $f"
      [ "$dry_run" = false ] && rm -f "$f"
      orphan_pids=$((orphan_pids + 1))
    done

    # Private-issues orphan pass, UNCONDITIONALLY every sweep (hook logs are
    # best-effort, so this is the mechanism that guarantees an orphaned
    # private worktree/branch is eventually seen). The real run prunes stale
    # registrations and collects merged+clean orphans (sweep-orphans);
    # dry-run only lists (report-orphans). Unmerged orphans are re-announced
    # every run until resolved.
    if [ -x "$REPO_DIR/bin/private-issues" ]; then
      if [ "$dry_run" = true ]; then
        "$REPO_DIR/bin/private-issues" report-orphans "$REPO_DIR" 2>/dev/null | sed 's/^/private-issues /' || true
      else
        "$REPO_DIR/bin/private-issues" sweep-orphans "$REPO_DIR" 2>/dev/null | sed 's/^/private-issues /' || true
      fi
    fi

    # Exhibit stores: REPORT-ONLY, every run, both modes. Sweep never deletes
    # a store — culling exhibit content is always the developer's manual act
    # (docs/plans/workstream-exhibits.md Track A). "main" and the reserved
    # "apps" namespace are never orphans.
    if [ -d "${WT_EXHIBITS_ROOT:-}" ]; then
      for d in "$WT_EXHIBITS_ROOT"/*; do
        [ -d "$d" ] || continue
        name=$(basename "$d")
        { [ "$name" = "main" ] || [ "$name" = "apps" ]; } && continue
        [ -d "$WT_ROOT/$name" ] && continue
        echo "orphan exhibits (manual cull only): $d ($(du -sh "$d" 2>/dev/null | cut -f1))"
      done
    fi

    # Drain the trash even when nothing was removed this run. Otherwise the only
    # thing that reaps is a removal, so a reaper killed partway (sleep, reboot)
    # leaves its ~1GB box tree in the cache until the NEXT removal happens —
    # which may be never. Sweep already runs at every session start and end and
    # already prunes orphaned state, so this is the same job.
    if [ "$dry_run" = false ]; then
      # Registry entries intentionally outlive their worktrees. Retire only
      # records explicitly marked removed and older than the retention window.
      # shellcheck source=lib/session-registry.sh
      . "$REPO_DIR/bin/lib/session-registry.sh"
      registry_cutoff=$(date -v-90d +%s 2>/dev/null || date -d '90 days ago' +%s)
      session_registry_prune "$registry_cutoff"

      trash_left=$(find "$STATE_DIR/trash" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d ' ')
      if [ "$trash_left" != "0" ]; then
        echo "reaping $trash_left trashed tree(s) in $STATE_DIR/trash"
        wt_trash_reap
      fi
    fi

    suffix=""
    [ "$dry_run" = true ] && suffix=" (dry-run; nothing removed)"
    # Surfaced, not silent: an unknown-liveness skip means a guard declined to
    # answer, which is worth seeing if it ever becomes routine.
    [ "$skipped_unknown" -gt 0 ] && suffix="$suffix ($skipped_unknown skipped: liveness unknown)"
    echo "sweep done: $removed worktrees, $orphan_browse browse, $orphan_logs logs, $orphan_pids pids$suffix"
    ;;

  help | -h | --help)
    awk 'NR==1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
    ;;

  *)
    echo "unknown command: $cmd" >&2
    echo "run \`bin/workstreams help\` for usage" >&2
    exit 1
    ;;
esac
