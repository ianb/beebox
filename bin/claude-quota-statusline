#!/usr/bin/env bash
# Claude Code status-line sink: display and cache the account quota windows.
set -euo pipefail

umask 077
STATE_DIR="${CALLBACK_STATE_DIR:-$HOME/.cache/callback-box}"
CACHE="$STATE_DIR/claude-rate-limits.json"
mkdir -p "$STATE_DIR"

result=$(jq -r '
  (.rate_limits | if type == "object" then . else null end) as $limits |
  ({captured_at: (now | todateiso8601), rate_limits: $limits} |
    if $limits == null then null else . end | tojson),
  ([
    ($limits.five_hour.used_percentage? | if . == null then empty else "5h \(.)%" end),
    ($limits.seven_day.used_percentage? | if . == null then empty else "7d \(.)%" end)
  ] | if length == 0 then "Claude" else "Claude · " + join(" · ") end)
' 2>/dev/null) || { printf '%s\n' "Claude"; exit 0; }

cache_line=${result%%$'\n'*}
display=${result#*$'\n'}
if [ "$cache_line" != null ] && [ "$display" != "$result" ]; then
  output="$CACHE.$$"
  trap 'rm -f "$output"' EXIT
  printf '%s\n' "$cache_line" > "$output"
  mv "$output" "$CACHE"
fi
printf '%s\n' "$display"
