#!/usr/bin/env bash
# Thin wrapper around the upstream `agent-browser` Chromium CLI. Source in browse/.
#
# Adds four things; everything else passes straight through to the binary:
#   - `bin/browse open /path` rewrites to this worktree's router URL
#   - `bin/browse screenshot [path]` adds a URL/title sidecar and indexed default path
#   - Per-worktree env vars (AGENT_BROWSER_SOCKET_DIR / _PROFILE) so each worktree
#     runs a fully isolated agent-browser daemon with its own Chrome profile
#   - Loads the callback-clerk extension when BROWSE_CLERK=1, so the browse
#     agent can exercise it. Opt-in because loading any extension forces
#     agent-browser into headed mode (no --headless=new) — see below.

set -euo pipefail
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# node-linker=hoisted (root .npmrc) puts tsx at the workspace root, not in
# browse/node_modules. Prefer the root bin and fall back to the local one.
if [[ -x "$REPO_DIR/node_modules/.bin/tsx" ]]; then
  TSX="$REPO_DIR/node_modules/.bin/tsx"
elif [[ -x "$REPO_DIR/browse/node_modules/.bin/tsx" ]]; then
  TSX="$REPO_DIR/browse/node_modules/.bin/tsx"
else
  echo "browse: tsx not found. Run 'pnpm install' at the monorepo root." >&2
  exit 1
fi

if [[ "$PWD" == *"/callback-worktrees/"* ]]; then
  worktree="${PWD#*/callback-worktrees/}"
  worktree="${worktree%%/*}"
else
  worktree="main"
fi

browse_base="${HOME}/.cache/callback-box/browse/${worktree}"
mkdir -p "${browse_base}/socket" "${browse_base}/profile"

export BROWSE_REPO_DIR="$REPO_DIR"
export BROWSE_WORKTREE="$worktree"

# Auth is on by default in dev (local-password-auth Track B), so a page
# navigation into this worktree's box now hits the login wall unless it
# carries the box's agent-token bearer. The token already authenticates
# every in-box request (server-box-scope.ts verifyAgentBearer) — the only
# gap was that a real Chromium has no way to attach it. Resolve the same
# box path the dev router clones for this worktree (root CLAUDE.md: "main"
# serves from ~/src/boxes, every other worktree from
# ~/src/box-worktrees/<name>") and hand the token to cli.ts via env, which
# scopes it to this worktree's origin only (browse/src/worktree.ts) before
# passing it to agent-browser's own origin-scoped `open --headers`. No
# token file yet (first agent call hasn't run) is not an error — browse
# just proceeds unauthenticated, same as before this change.
browse_box="${BROWSE_BOX:-test1}"
if [[ "$worktree" == "main" ]]; then
  browse_box_root="${HOME}/src/boxes/${browse_box}"
else
  browse_box_root="${HOME}/src/box-worktrees/${worktree}/${browse_box}"
fi
# The token lives under the box's OPERATIONAL root, which in the v2 package
# shape is `<pkg>/content` (bin/box-entry.ts resolves the same contentDir, and
# that's the root server-box-scope.ts hands verifyAgentBearer). Looking only at
# the package root — as this did until 2026-07-31 — silently found nothing on
# every v2 box, so every browse ran unauthenticated straight into the login
# wall. The package-root path stays as the legacy (shapeVersion 1) fallback.
for browse_agent_token_file in \
  "${browse_box_root}/content/.callback-box/agent-token" \
  "${browse_box_root}/.callback-box/agent-token"; do
  if [[ -r "$browse_agent_token_file" ]]; then
    BROWSE_AGENT_TOKEN="$(tr -d '[:space:]' < "$browse_agent_token_file")"
    export BROWSE_AGENT_TOKEN
    break
  fi
done
export AGENT_BROWSER_SOCKET_DIR="${browse_base}/socket"
export AGENT_BROWSER_PROFILE="${browse_base}/profile"
export AGENT_BROWSER_IDLE_TIMEOUT_MS="${AGENT_BROWSER_IDLE_TIMEOUT_MS:-300000}"

# Load callback-clerk as an unpacked extension when BROWSE_CLERK=1 (agent-browser's
# --extension / AGENT_BROWSER_EXTENSIONS; a .crx can't be sideloaded via CLI).
# Opt-in: agent-browser drops --headless=new whenever an extension is present, so
# every browse would otherwise spawn a visible window (and break headless/CI).
# Append so a caller's own AGENT_BROWSER_EXTENSIONS still applies. Build first:
# (cd callback-clerk && pnpm build).
clerk_ext="${REPO_DIR}/callback-clerk/dist/chrome-mv3"
if [[ -n "${BROWSE_CLERK:-}" ]]; then
  if [[ -f "${clerk_ext}/manifest.json" ]]; then
    export AGENT_BROWSER_EXTENSIONS="${AGENT_BROWSER_EXTENSIONS:+${AGENT_BROWSER_EXTENSIONS},}${clerk_ext}"
  else
    echo "browse: BROWSE_CLERK set but extension not built — run (cd callback-clerk && pnpm build)" >&2
  fi
fi

# Reap superseded agent-browser daemons for this worktree before running. The
# upstream daemon stops serving its socket on idle but never exits (it reparents
# to PID 1 and lingers), so a new one spawns on next use and the dead ones pile
# up. The socket dir's *.pid files name the only live ones (daemon, dashboard,
# sessions); any other agent-browser launched from this repo is an orphan.
# Best-effort — never let cleanup fail the actual command.
{
  live=" "
  for f in "${AGENT_BROWSER_SOCKET_DIR}"/*.pid; do
    [[ -f "$f" ]] && live+="$(cat "$f" 2>/dev/null) "
  done
  while IFS= read -r abpid; do
    [[ -n "$abpid" && "$live" != *" $abpid "* ]] && kill "$abpid" 2>/dev/null
  done < <(pgrep -f "${REPO_DIR}/node_modules/agent-browser/bin" 2>/dev/null)
} 2>/dev/null || true

exec "$TSX" "$REPO_DIR/browse/src/cli.ts" "$@"
