#!/usr/bin/env bash
# Thin wrapper around the upstream `agent-browser` Chromium CLI. Source in browse/.
#
# Adds four things; everything else passes straight through to the binary:
#   - `bin/browse open /path` rewrites to this worktree's router URL
#   - `bin/browse screenshot [path]` adds a URL/title sidecar and indexed default path
#   - Per-worktree env vars (AGENT_BROWSER_SOCKET_DIR / _PROFILE) so each worktree
#     runs a fully isolated agent-browser daemon with its own Chrome profile
#   - Loads the callback-clerk extension (a core part of the system) when built,
#     so the browse agent can exercise and observe it. Opt out: BROWSE_NO_EXTENSION=1

set -euo pipefail
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# node-linker=hoisted (root .npmrc) puts tsx at the workspace root, not in
# browse/node_modules. Prefer the root bin and fall back to the local one.
if [[ -x "$REPO_DIR/node_modules/.bin/tsx" ]]; then
  TSX="$REPO_DIR/node_modules/.bin/tsx"
elif [[ -x "$REPO_DIR/browse/node_modules/.bin/tsx" ]]; then
  TSX="$REPO_DIR/browse/node_modules/.bin/tsx"
else
  echo "browse: tsx not found. Run 'pnpm install' at the monorepo root." >&2
  exit 1
fi

if [[ "$PWD" == *"/callback-worktrees/"* ]]; then
  worktree="${PWD#*/callback-worktrees/}"
  worktree="${worktree%%/*}"
else
  worktree="main"
fi

browse_base="${HOME}/.cache/callback-mono/browse/${worktree}"
mkdir -p "${browse_base}/socket" "${browse_base}/profile"

export BROWSE_REPO_DIR="$REPO_DIR"
export BROWSE_WORKTREE="$worktree"
export AGENT_BROWSER_SOCKET_DIR="${browse_base}/socket"
export AGENT_BROWSER_PROFILE="${browse_base}/profile"
export AGENT_BROWSER_IDLE_TIMEOUT_MS="${AGENT_BROWSER_IDLE_TIMEOUT_MS:-300000}"

# Load callback-clerk as an unpacked extension (agent-browser's --extension /
# AGENT_BROWSER_EXTENSIONS; .crx can't be sideloaded via CLI). Only when built —
# absent in a fresh worktree, so guard on the manifest and skip silently rather
# than fail the launch. Append so a caller's own AGENT_BROWSER_EXTENSIONS wins.
# Build it with: (cd callback-clerk && pnpm build).
clerk_ext="${REPO_DIR}/callback-clerk/dist/chrome-mv3"
if [[ -z "${BROWSE_NO_EXTENSION:-}" && -f "${clerk_ext}/manifest.json" ]]; then
  export AGENT_BROWSER_EXTENSIONS="${AGENT_BROWSER_EXTENSIONS:+${AGENT_BROWSER_EXTENSIONS},}${clerk_ext}"
fi

exec "$TSX" "$REPO_DIR/browse/src/cli.ts" "$@"
