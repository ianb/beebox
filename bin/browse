#!/usr/bin/env bash
# Thin wrapper around `agent-browser` that fills in this worktree's dev URL.
#
# Only the URL argument to `open` is rewritten: a leading "/" becomes the
# current worktree's router prefix.
#
#   bin/browse open /dashboard
#     -> agent-browser open http://localhost:3210/<worktree>/<box>/dashboard
#
# Every other subcommand passes through unchanged (so `screenshot /tmp/x.png`,
# `pdf /tmp/y.pdf`, etc. work normally).
#
# Worktree detection: a path containing "/callback-worktrees/<name>/" uses
# <name>; the main checkout uses "main". Box defaults to test1, override
# with $BROWSE_BOX. Router port via $ROUTER_PORT (default 3210).

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$REPO_DIR/node_modules/.bin/agent-browser"

if [[ ! -x "$BIN" ]]; then
  echo "browse: $BIN not found. Run 'pnpm install' at the monorepo root." >&2
  exit 1
fi

if [[ "$PWD" == *"/callback-worktrees/"* ]]; then
  worktree="${PWD#*/callback-worktrees/}"
  worktree="${worktree%%/*}"
else
  worktree="main"
fi

box="${BROWSE_BOX:-test1}"
port="${ROUTER_PORT:-3210}"
base="http://localhost:${port}/${worktree}/${box}"

if [[ "${1:-}" == "open" && "${2:-}" == /* && "${2:-}" != //* ]]; then
  shift
  url="${base}$1"
  shift
  exec "$BIN" open "$url" "$@"
fi

exec "$BIN" "$@"
