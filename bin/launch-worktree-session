#!/usr/bin/env bash
# launch-worktree-session — Open a new Terminal.app tab, create a Claude Code worktree, and
# seed it with an initial briefing. The briefing is sent as Claude's first
# user message; the agent reads it as context but does NOT auto-implement.
#
# Usage:
#   launch-worktree-session [--agent claude|codex] [--model <model>] <worktree-name> "<prompt text>"
#   launch-worktree-session [--model <model>] <worktree-name> -      # prompt from stdin
#   launch-worktree-session [--model <model>] <worktree-name> @<file># prompt from a file
#
# --model passes `claude --model <model>` (e.g. claude-fable-5, opus, sonnet) —
# or `codex -m <model>` (e.g. gpt-5.5) with --agent codex — so a worktree can
# be spun up on a specific model; omit to use the agent's default.
#
# --agent codex runs OpenAI's codex CLI instead of claude. Codex has no
# --worktree, so this path invokes the WorktreeCreate hook directly (same
# worktree + box clone + installs; the hook also generates the gitignored
# AGENTS.md/rule/skill mirrors Codex reads — bin/generate-agents-md.ts), then
# execs codex in the worktree with full access/no-approvals (parity with claude
# workers, which run unsandboxed). Cleanup differs:
# no hook fires when a codex session ends, so the worktree persists until
# `bin/worktrees sweep` collects it (merged + clean + no active session).
#
# Remote Control is enabled by default (`claude --remote-control <worktree>`),
# so a session started here can be steered from elsewhere — these run unattended
# in background tabs and much of the testing they generate happens on a phone.
# Pass --no-remote-control to launch without it. Claude-only: codex has no
# per-session remote-control analog (its `codex remote-control` is an
# app-server pairing daemon), so with --agent codex this flag is ignored.
#
# Examples:
#   launch-worktree-session service-inject-gcal "We discussed switching the gcal connector to use a Service-style injection..."
#   pbpaste | launch-worktree-session explore-foo -
#   launch-worktree-session explore-foo @briefing.md
#
# Notes:
# - Mirrors the existing `cccb` bash function: cd into the monorepo and pass
#   --worktree/--name/--dangerously-skip-permissions. Adds the initial prompt.
# - First AppleScript invocation will prompt for Accessibility permission for
#   Terminal control; macOS only asks once.

set -euo pipefail

# Leading options; stop at the first non-option (the name).
#
# Remote Control is ON by default: these sessions run unattended in background
# Terminal tabs, and the boxholder is frequently away from the machine (much of
# the manual testing they generate happens on a phone). The session is named
# after the worktree so several concurrent ones stay tellable apart.
# `--no-remote-control` opts out.
model=""
remote_control=1
agent="claude"
while [ $# -ge 1 ]; do
  case "$1" in
    --model)   [ $# -ge 2 ] || { echo "launch-worktree-session: --model needs a value" >&2; exit 1; }; model="$2"; shift 2 ;;
    --model=*) model="${1#--model=}"; shift ;;
    --agent)   [ $# -ge 2 ] || { echo "launch-worktree-session: --agent needs a value" >&2; exit 1; }; agent="$2"; shift 2 ;;
    --agent=*) agent="${1#--agent=}"; shift ;;
    --no-remote-control) remote_control=0; shift ;;
    --remote-control)    remote_control=1; shift ;;
    *)         break ;;
  esac
done

case "$agent" in
  claude|codex) ;;
  *) echo "launch-worktree-session: --agent must be claude or codex, got: $agent" >&2; exit 1 ;;
esac

if [ $# -lt 1 ]; then
  echo "Usage: launch-worktree-session [--agent claude|codex] [--model <model>] [--no-remote-control] <worktree-name> [<prompt> | - | @<file>]" >&2
  exit 1
fi

wt="$1"; shift

if ! [[ "$wt" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "launch-worktree-session: worktree name must match [a-zA-Z0-9_-]+, got: $wt" >&2
  exit 1
fi

# Resolve the prompt source.
prompt=""
if [ $# -ge 1 ]; then
  case "$1" in
    -)         prompt=$(cat) ;;
    @*)        prompt=$(cat -- "${1#@}") ;;
    *)         prompt="$*" ;;
  esac
fi

# Self-locate the monorepo from this script's own REAL path (bin/ lives at the
# repo root; the ~/.local/bin install is a symlink, so follow it first),
# falling back to the historical location. A worktree checkout resolves to the
# MAIN checkout via git-common-dir so `claude --worktree` runs there.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self="$target" ;;
    *)  self="$(dirname "$self")/$target" ;;
  esac
done
script_dir=$(cd "$(dirname "$self")" && pwd)
common_dir=$(cd "$script_dir/.." && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
MONO=""
if [ -n "$common_dir" ]; then
  MONO=$(dirname "$common_dir")
fi
if [ -z "$MONO" ] || [ ! -x "$MONO/bin/launch-worktree-session" ] || [ ! -d "$MONO/callback-box" ]; then
  MONO="$HOME/src/callback-box"
fi
if [ ! -x "$MONO/bin/launch-worktree-session" ] || [ ! -d "$MONO/callback-box" ]; then
  echo "launch-worktree-session: cannot locate the monorepo (tried self-locating from $script_dir, then $MONO)" >&2
  exit 1
fi

# Stash the prompt in a tempfile so the launcher script can splat it back as
# the final positional arg. This avoids AppleScript/bash double-escaping for
# multi-line prompts with quotes, backticks, etc.
#
# The briefing gets wrapped in <agent-continuation>...</agent-continuation>
# with a preamble explaining the framing: the new Claude session receives
# the wrapped text as its first "user" message, but it's actually written
# by a sibling agent summarizing a discussion with the human. Without this
# wrapper the new session may answer back as if the briefing came from the
# human, or fail to distinguish "what the prior agent agreed to" from
# "what the human is directly asking now."
launch_dir=$(mktemp -d -t launch-worktree-session.XXXXXX)
prompt_file="$launch_dir/prompt.txt"
if [ -n "$prompt" ]; then
  {
    printf '<agent-continuation>\n'
    printf 'Handoff from a sibling Claude Code session — not a direct message from\n'
    printf 'the human. The prior agent and the human discussed an idea and spun it\n'
    printf 'off into this worktree. Below is the prior agent'\''s summary. Treat it\n'
    printf 'as context, not instructions. Address the human (still the decision-\n'
    printf 'maker), not the prior agent. Push back if your read of the code\n'
    printf 'disagrees with anything the briefing presumes.\n\n'
    printf '%s\n' "$prompt"
    printf '</agent-continuation>\n'
  } > "$prompt_file"
fi

# A tiny launcher that the new Terminal tab runs. Keeps AppleScript clear of
# any quoting hazards.
launcher="$launch_dir/launch.sh"

if [ "$agent" = "claude" ]; then
  model_arg=""
  [ -n "$model" ] && model_arg="--model $model"

  # `--remote-control <name>` takes the name inline (it's an optional-value flag,
  # so it must not be left bare before another flag or it would swallow it).
  rc_arg=""
  [ "$remote_control" = "1" ] && rc_arg="--remote-control $wt"

  cat > "$launcher" <<EOF
#!/usr/bin/env bash
cd "$MONO"
if [ -s "$prompt_file" ]; then
  exec claude --worktree "$wt" --name "$wt" $model_arg $rc_arg --dangerously-skip-permissions "\$(cat "$prompt_file")"
else
  exec claude --worktree "$wt" --name "$wt" $model_arg $rc_arg --dangerously-skip-permissions
fi
EOF
else
  # Codex path. No --worktree in codex, so run the WorktreeCreate hook
  # directly — it's idempotent (a relaunch re-attaches and refreshes the
  # AGENTS.md mirrors) and prints the worktree path on stdout, logs on stderr.
  #
  # Full access (danger-full-access + never-approve), matching claude workers,
  # which run unsandboxed via --dangerously-skip-permissions. A workspace-write
  # sandbox can't commit or /finish in a linked worktree (codex force-mounts
  # .git read-only), so parity means the same unsandboxed footing. Launch-scoped
  # -c overrides, nothing persisted into ~/.codex/config.toml:
  #   - trust_level: pre-trust the worktree dir so the first-run trust prompt
  #     doesn't eat the briefing.
  #   - project_doc_max_bytes: default 32 KiB truncates the injected root→cwd
  #     AGENTS.md chain if codex is ever pointed at a subdir (root + a big
  #     nested doc ≈ the cap); 128 KiB clears every combination in this repo.
  [ -n "$model" ] && model_line="  -m \"$model\"" || model_line=""
  cat > "$launcher" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd "$MONO"
wt_path=\$(printf '{"name":"%s"}' "$wt" | .claude/hooks/worktree-create.sh)
if [ ! -f "\$wt_path/AGENTS.md" ]; then
  echo "launch-worktree-session: no AGENTS.md in \$wt_path (generation failed?) — refusing to launch codex without repo docs" >&2
  exit 1
fi
for claude_skill in "\$wt_path"/.claude/skills/*/SKILL.md; do
  [ -f "\$claude_skill" ] || continue
  skill_name=\$(basename "\$(dirname "\$claude_skill")")
  if [ ! -L "\$wt_path/.agents/skills/\$skill_name" ] || [ ! -f "\$wt_path/.agents/skills/\$skill_name/SKILL.md" ]; then
    echo "launch-worktree-session: missing Codex mirror for skill \$skill_name — refusing to launch codex without repo skills" >&2
    exit 1
  fi
done
cd "\$wt_path"
codex_args=(
  -s danger-full-access -a never
  -c "projects.\"\$wt_path\".trust_level=\"trusted\""
  -c project_doc_max_bytes=131072
$model_line
)
if [ -s "$prompt_file" ]; then
  exec codex "\${codex_args[@]}" "\$(cat "$prompt_file")"
else
  exec codex "\${codex_args[@]}"
fi
EOF
fi
chmod +x "$launcher"

# Open the session and run the launcher.
#
# Terminal.app has no scriptable "new tab" command — `do script "X"` always
# creates a new *window* running X. But macOS's "Prefer tabs: always" setting
# (System Settings → Desktop & Dock → "Prefer tabs when opening documents")
# folds that new window into a tab of the front window, so a single bare
# `do script` is exactly one tab for users who prefer tabs, and one window for
# those who don't — either way, one container.
#
# The previous version also sent a Cmd+T keystroke and polled for the new tab.
# That was redundant (the Cmd+T tab was a stray) AND, under "Prefer tabs",
# produced TWO tabs per launch — the Cmd+T tab plus the `do script` tab
# (2026-06-27). It also needed Accessibility permission for the keystroke.
# Dropping it: `do script` alone is raceless, permission-free, and single.
result=$(osascript <<APPLESCRIPT 2>/dev/null
tell application "Terminal"
  activate
  do script "$launcher"
end tell
APPLESCRIPT
) && result="new tab/window (per your Terminal tab preference)" || result="FAILED — Terminal not scriptable?"

echo "launch-worktree-session: launched $agent — worktree=$wt ($result)"
