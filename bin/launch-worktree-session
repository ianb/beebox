#!/usr/bin/env bash
# launch-worktree-session — Open a new Terminal.app tab, create a Claude Code worktree, and
# seed it with an initial briefing. The briefing is sent as Claude's first
# user message; the agent reads it as context but does NOT auto-implement.
#
# Usage:
#   launch-worktree-session [options] <worktree-name> "<prompt text>"
#   launch-worktree-session [options] <worktree-name> -        # prompt from stdin
#   launch-worktree-session [options] <worktree-name> @<file>  # prompt from a file
#   launch-worktree-session --help
#
# Options (all before the worktree name):
#   --agent claude|codex   default claude
#   --model <model>        see below
#   --description <text>   one line, at most 160 characters; shown in
#                          `bin/workstreams list`. Pass it on every agent launch.
#   --issue <path>         repo-relative issues/ or private-issues/ path the work
#                          takes ownership of; sets its `workstream:` field in the
#                          new checkout. For a cluster, anchor one issue and name
#                          the rest in the briefing.
#   --base-ref <ref>       branch the worktree from <ref> instead of main. Use only
#                          when both lines of work are one; the branches then land
#                          in order.
#   --allow-sigils         skip the briefing sigil check (below)
#   --check-briefing       run every pre-launch check below, then exit 0 without
#                          creating anything or opening Terminal
#   --no-remote-control    see below
#
# Pre-launch checks (refusals exit 1 before anything is created):
# - Name collision: an existing workstream with this name (live, dormant,
#   stale, removed, or scheduled) is refused, and its state, action, age, and
#   description are printed with the next step. A dormant or removed
#   workstream that owns the subject takes `bin/workstreams resume <name> -`;
#   a live one cannot receive injected context, so resume prints a
#   `manual forwarding required: <path>` note for the human to paste; `stale`
#   (about 14 days idle) usually wants a new name.
# - Briefing sigils: `/<skill>` or `$<skill>` in briefing prose, where <skill>
#   is a directory under .claude/skills/, is refused. The receiving agent runs
#   a sigil as an invocation; name the skill instead ("use the finish skill").
#   Fenced code blocks are exempt; inline code spans are not.
# - Unlanded context (a note, not a refusal): run from a checkout with
#   uncommitted changes or commits not on main, the launcher says so. A new
#   worktree branches from main; land the work, describe it in the briefing,
#   or pass --base-ref.
#
# --model passes `claude --model <model>` (e.g. claude-fable-5-1, opus, sonnet) —
# or `codex -m <model>` with --agent codex — so a worktree can be spun up on a
# specific model. Omitted Claude models use Claude's default; omitted Codex
# models use gpt-6-sol.
#
# A `glm-*` model (e.g. --model glm-5.3) runs the session on Z.ai's GLM through
# Claude Code itself: the agent is still claude and only the endpoint changes, so
# liveness, --resume, remote control and the sweep are untouched. The key comes
# from GLM_API_KEY in beebox/.env and is exported inside that one generated
# launcher script — never written to ~/.claude/settings.json, which would
# redirect every Claude Code session on the machine. See bin/lib/glm-provider.sh.
#
# --agent codex runs OpenAI's codex CLI instead of claude. Both paths call
# `bin/workstreams create` directly (same worktree + box clone + installs; it
# also generates the gitignored
# AGENTS.md/rule/skill mirrors Codex reads — bin/generate-agents-md.ts), then
# runs codex in the worktree with full access/no-approvals (parity with claude
# workers, which run unsandboxed). Codex is run, not exec'd, because it fires no
# hooks: the launcher needs an "after codex exits" moment to run
# bin/codex-session-end, which gives codex the same teardown SessionEnd gives
# claude (auto-remove when merged + clean; keep/remove prompt otherwise).
#
# Remote Control is enabled by default (`claude --remote-control <worktree>`),
# so a session started here can be steered from elsewhere — these run unattended
# in background tabs and much of the testing they generate happens on a phone.
# Pass --no-remote-control to launch without it. Claude-only: codex has no
# per-session remote-control analog (its `codex remote-control` is an
# app-server pairing daemon), so with --agent codex this flag is ignored.
#
# Examples:
#   launch-worktree-session service-inject-gcal "We discussed switching the gcal connector to use a Service-style injection..."
#   pbpaste | launch-worktree-session explore-foo -
#   launch-worktree-session explore-foo @briefing.md
#
# Teardown: Claude's SessionEnd hook and codex's exit (bin/codex-session-end)
# remove a merged, clean worktree and otherwise offer keep/remove, defaulting to
# keep. A closed tab skips that; `bin/workstreams sweep` handles it later.
# Reopen a workstream later with `bin/workstreams resume <name>`.
#
# Notes:
# - Creates or reattaches through `bin/workstreams create`, cd's into the
#   managed checkout, and passes --name/--dangerously-skip-permissions. It does
#   not pass Claude's native --worktree flag: repository hooks and sweep own
#   cleanup, so Claude must not show its separate keep/remove dialog on exit.
# - First AppleScript invocation will prompt for Accessibility permission for
#   Terminal control; macOS only asks once.

set -euo pipefail

# Leading options; stop at the first non-option (the name).
#
# Remote Control is ON by default: these sessions run unattended in background
# Terminal tabs, and the boxholder is frequently away from the machine (much of
# the manual testing they generate happens on a phone). The session is named
# after the worktree so several concurrent ones stay tellable apart.
# `--no-remote-control` opts out.
model=""
remote_control=1
agent="claude"
issue=""
description=""
description_set=false
base_ref=""
allow_sigils=false
check_only=false

# `--help` prints this file's own header comment — the usage block, the flag
# explanations, and the examples are already written there, and a second copy
# in a heredoc would be the one that goes stale. Reads from the line after the
# shebang to the first line that isn't a comment, stripping the `# ` prefix.
usage() {
  sed -n '2,${/^#/!q;s/^# \{0,1\}//;p;}' "${BASH_SOURCE[0]}"
}

while [ $# -ge 1 ]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --model)   [ $# -ge 2 ] || { echo "launch-worktree-session: --model needs a value" >&2; exit 1; }; model="$2"; shift 2 ;;
    --model=*) model="${1#--model=}"; shift ;;
    --agent)   [ $# -ge 2 ] || { echo "launch-worktree-session: --agent needs a value" >&2; exit 1; }; agent="$2"; shift 2 ;;
    --agent=*) agent="${1#--agent=}"; shift ;;
    --issue)   [ $# -ge 2 ] || { echo "launch-worktree-session: --issue needs a value" >&2; exit 1; }; issue="$2"; shift 2 ;;
    --issue=*) issue="${1#--issue=}"; shift ;;
    --description) [ $# -ge 2 ] || { echo "launch-worktree-session: --description needs a value" >&2; exit 1; }; description="$2"; description_set=true; shift 2 ;;
    --description=*) description="${1#--description=}"; description_set=true; shift ;;
    --base-ref) [ $# -ge 2 ] || { echo "launch-worktree-session: --base-ref needs a value" >&2; exit 1; }; base_ref="$2"; shift 2 ;;
    --base-ref=*) base_ref="${1#--base-ref=}"; shift ;;
    --allow-sigils) allow_sigils=true; shift ;;
    --check-briefing) check_only=true; shift ;;
    --no-remote-control) remote_control=0; shift ;;
    --remote-control)    remote_control=1; shift ;;
    *)         break ;;
  esac
done

case "$agent" in
  claude|codex) ;;
  *) echo "launch-worktree-session: --agent must be claude or codex, got: $agent" >&2; exit 1 ;;
esac

if [ $# -lt 1 ]; then
  echo "Usage: launch-worktree-session [--agent claude|codex] [--model <model>] [--description <text>] [--issue <path>] [--base-ref <ref>] [--allow-sigils] [--check-briefing] [--no-remote-control] <worktree-name> [<prompt> | - | @<file>]" >&2
  echo "       launch-worktree-session --help   # full documentation" >&2
  exit 1
fi

wt="$1"; shift

# Options go BEFORE the name. An option here would otherwise be swallowed as
# the briefing text — the session opens with "--issue <path> -" as its whole
# handoff (2026-08-25, three launches in a row).
for arg in "$@"; do
  case "$arg" in
    --*) echo "launch-worktree-session: option '$arg' must come before the worktree name '$wt'" >&2; exit 1 ;;
  esac
done

if ! [[ "$wt" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "launch-worktree-session: worktree name must match [a-zA-Z0-9_-]+, got: $wt" >&2
  exit 1
fi

if [ -n "$issue" ] && ! [[ "$issue" =~ ^(issues|private-issues)/((closed/)?(bugs|features|code-quality|docs-and-chores|decisions|exploration|watch)/|deferred/)[a-zA-Z0-9_-]+\.md$ ]]; then
  echo "launch-worktree-session: --issue must be a repo-relative issue markdown path, got: $issue" >&2
  exit 1
fi

# The session display name is the worktree name. It reaches the Terminal title
# escape the launcher emits and the registry's presentation; Claude's `--name`
# is the same string and is the durable liveness marker the sweep matches.
session_name="$wt"

# Self-locate the monorepo from this script's own REAL path (bin/ lives at the
# repo root; the ~/.local/bin install is a symlink, so follow it first),
# falling back to the historical location. A worktree checkout resolves to the
# MAIN checkout via git-common-dir so creation always uses the shared owner.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self="$target" ;;
    *)  self="$(dirname "$self")/$target" ;;
  esac
done
script_dir=$(cd "$(dirname "$self")" && pwd)
# shellcheck source=workstream-briefing.sh
. "$script_dir/lib/workstream-briefing.sh"
if [ "$description_set" = true ]; then
  workstream_validate_description "$description"
  description="$WORKSTREAM_DESCRIPTION"
fi
workstream_read_briefing launch-worktree-session "$@"
prompt="$WORKSTREAM_BRIEFING"
# One derivation, shared with every other piece of worktree tooling. It fails
# closed rather than falling back to a hardcoded $HOME path — launching a
# session against the wrong checkout is worse than not launching one.
# shellcheck source=worktree-paths.sh
. "$script_dir/lib/worktree-paths.sh"
if ! wt_paths_init "$script_dir/.."; then
  echo "launch-worktree-session: cannot locate the monorepo from $script_dir" >&2
  exit 1
fi
MONO="$WT_MONO"
if [ ! -x "$MONO/bin/launch-worktree-session" ]; then
  echo "launch-worktree-session: resolved monorepo $MONO has no bin/launch-worktree-session" >&2
  exit 1
fi
if [ -n "$issue" ]; then
  node --import tsx "$MONO/bin/assign-issue-workstream.ts" --check "$MONO/$issue" "$wt"
fi

# The scanner runs from this script's own checkout; skill names come from it
# and from main, which the new worktree branches from.
workstream_check_briefing_sigils launch-worktree-session "$(cd "$script_dir/.." && pwd)" "$allow_sigils" "$MONO"

if [ -n "$base_ref" ]; then
  if ! [[ "$base_ref" =~ ^[A-Za-z0-9._/@^~-]+$ ]] || ! git -C "$MONO" rev-parse --verify --quiet "$base_ref^{commit}" >/dev/null; then
    echo "launch-worktree-session: --base-ref is not a commit in $MONO: $base_ref" >&2
    exit 1
  fi
fi

# An existing name would silently reattach to that workstream's checkout and
# branch. Resume is the path for existing work; refuse and say where it stands.
# Fails closed: without the inventory a collision cannot be ruled out.
if ! inventory=$("$MONO/bin/workstreams" list --json); then
  echo "launch-worktree-session: bin/workstreams list failed; cannot check for an existing '$wt'" >&2
  exit 1
fi
existing=$(printf '%s' "$inventory" | jq -c --arg n "$wt" '[.[] | select(.name == $n)] | first // empty')
if [ -n "$existing" ]; then
  state=$(printf '%s' "$existing" | jq -r '.routing.state // "unknown"')
  action=$(printf '%s' "$existing" | jq -r '.routing.action // "unknown"')
  {
    echo "launch-worktree-session: refusing: workstream '$wt' already exists"
    printf '%s' "$existing" | jq -r '"  state=\(.routing.state // "?") action=\(.routing.action // "?") last-activity=\(.routing.lastActivityAt // "?")\n  description: \(.session.description // "(none)")\n  path: \(.path // "(absent)")"'
    case "$action" in
      manual-forward) echo "  It is live. 'bin/workstreams resume $wt -' focuses its tab and writes a note for the human to paste (inline it or give its absolute path; never @scratch/...)." ;;
      resume-with-briefing) echo "  If it owns this subject: bin/workstreams resume $wt - <<'EOF' ... EOF. Otherwise choose another name." ;;
      new-stream-preferred) echo "  It is $state (about 14 days idle). Choose another name unless the human wants its context; then resume it." ;;
      wait-for-launch) echo "  A launch is in progress; wait for it." ;;
      *) echo "  Its state needs investigation (bin/workstreams list --json); do not reuse the name." ;;
    esac
  } >&2
  exit 1
fi
# A removed workstream is absent from the inventory, but `remove --keep-branch`
# leaves its branch, and creation attaches to an existing branch without -b.
if git -C "$MONO" show-ref --verify --quiet "refs/heads/worktree-$wt"; then
  echo "launch-worktree-session: refusing: branch worktree-$wt already exists (a removed workstream's kept branch?). Launching would attach to it instead of branching fresh. Choose another name, or delete or resume that branch." >&2
  exit 1
fi

# The new worktree branches from main (or --base-ref), so it cannot see this
# checkout's uncommitted files or unlanded commits.
if [ -z "$base_ref" ] && caller_top=$(git rev-parse --show-toplevel 2>/dev/null) \
  && [ "$(git -C "$caller_top" rev-parse --path-format=absolute --git-common-dir)" = "$(git -C "$MONO" rev-parse --path-format=absolute --git-common-dir)" ]; then
  dirty=$(git -C "$caller_top" status --porcelain | wc -l | tr -d ' ')
  ahead=$(git -C "$caller_top" rev-list --count main..HEAD 2>/dev/null || echo 0)
  if [ "$dirty" != 0 ] || [ "$ahead" != 0 ]; then
    echo "launch-worktree-session: note: $caller_top has $dirty uncommitted path(s) and $ahead commit(s) not on main; '$wt' branches from main and will not see them. Land them, describe them in the briefing, or pass --base-ref." >&2
  fi
fi

if [ "$check_only" = true ]; then
  echo "launch-worktree-session: checks passed for '$wt'; nothing launched (--check-briefing)"
  exit 0
fi

# Stash the prompt in a tempfile so the launcher script can splat it back as
# the final positional arg. This avoids AppleScript/bash double-escaping for
# multi-line prompts with quotes, backticks, etc.
#
# The briefing gets wrapped in <agent-continuation>...</agent-continuation>
# with a preamble explaining the framing: the new Claude session receives
# the wrapped text as its first "user" message, but it's actually written
# by a sibling agent summarizing a discussion with the human. Without this
# wrapper the new session may answer back as if the briefing came from the
# human, or fail to distinguish "what the prior agent agreed to" from
# "what the human is directly asking now."
launch_dir=$(mktemp -d -t launch-worktree-session.XXXXXX)
prompt_file="$launch_dir/prompt.txt"
description_file=""
if [ "$description_set" = true ]; then
  description_file="$launch_dir/description.txt"
  printf '%s' "$description" > "$description_file"
fi
if [ -n "$prompt" ]; then
  workstream_wrap_briefing "$prompt" "$wt" > "$prompt_file"
fi

# The shared builder is also used by `bin/workstreams resume`; keep every tab
# spawn and per-agent script in one implementation.
# shellcheck source=launch-session.sh
. "$script_dir/lib/launch-session.sh"
LS_MONO="$MONO"
LS_WORKSTREAM="$wt"
LS_SESSION_NAME="$session_name"
LS_AGENT="$agent"
LS_MODEL="$model"
LS_REMOTE_CONTROL="$remote_control"
LS_PROMPT_FILE="$prompt_file"
LS_LAUNCH_DIR="$launch_dir"
LS_ISSUE="$issue"
LS_DESCRIPTION_FILE="$description_file"
LS_WORKTREE_PATH=""
LS_BASE_REF="$base_ref"
export LS_BASE_REF
export LS_MONO LS_WORKSTREAM LS_SESSION_NAME LS_AGENT LS_MODEL LS_REMOTE_CONTROL
export LS_PROMPT_FILE LS_LAUNCH_DIR LS_ISSUE LS_DESCRIPTION_FILE LS_WORKTREE_PATH
launch_session_build
result=$(launch_session_open)

echo "launch-worktree-session: launched $agent — $session_name (worktree=$wt) ($result)"
