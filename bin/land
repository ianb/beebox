#!/usr/bin/env bash
# land — Fast-forward a finished worktree branch onto main. Runs from anywhere.
#
# Why this exists: Claude Code isolates a `--worktree` session (and every
# subagent it spawns) from the main checkout, blocking `git -C <main>`,
# `--git-dir`, `GIT_DIR`/`GIT_WORK_TREE`, and `cd <main>` before git. See
# "How Claude Code enforces isolation" in https://code.claude.com/docs/en/worktrees.
# That check reads the Bash tool's command string; it does not follow into a
# script file, so `/finish` can invoke this and complete the merge itself.
#
# If that ever stops working, run this same script from the main checkout —
# it behaves identically there, so the fallback needs no code change.
#
# There is nothing to *resolve* in main. `/finish` merges main INTO the
# worktree and re-verifies there, so landing is a pure fast-forward: a pointer
# move. If it isn't a fast-forward, main moved — this refuses, and the fix
# belongs back in the worktree (merge main in, re-verify, retry), never here.
#
# Usage:
#   bin/land                 # from a worktree: land THIS worktree's branch
#                            # from main: auto-detect the single merge-ready branch
#   bin/land <branch>        # land a specific branch
#   bin/land --dry-run [..]  # preflight + report, merge nothing
#   bin/land --list          # show every merge-ready branch and exit
#
# Call it bare from a worktree; don't build the branch name with `$(…)`, which
# an isolated session refuses as "too complex to verify".
#
# Exit codes: 0 landed (or clean no-op), 1 refused.

set -euo pipefail

DRY_RUN=0
LIST_ONLY=0
BRANCH=""

die() { printf 'land: %s\n' "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --list)    LIST_ONLY=1 ;;
    # Print the header comment block, however long it grows: every line after
    # the shebang until the first non-comment. A fixed line range silently
    # truncates the help the moment the header is edited.
    -h|--help) awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; exit 0 ;;
    -*)        die "unknown option: $1" ;;
    *)
      [ -n "$BRANCH" ] && die "expected at most one branch, got '$BRANCH' and '$1'"
      BRANCH="$1"
      ;;
  esac
  shift
done

git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"

# Resolve the main checkout rather than assuming cwd is it. A linked worktree
# and the main checkout share one git dir: --git-common-dir points at the main
# checkout's .git from either, so its parent is the main working tree. Every
# git call below targets $MONO explicitly, which is what lets this run
# unchanged from the main checkout or from inside a worktree.
GIT_COMMON="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
MONO="$(dirname "$GIT_COMMON")"
[ -d "$MONO/.git" ] || die "could not resolve the main checkout (got '$MONO')"

# Are we inside a linked worktree? In the main checkout --absolute-git-dir and
# --git-common-dir agree; in a worktree they diverge. Used only to pick the
# default branch below.
IN_WORKTREE=0
[ "$(git rev-parse --absolute-git-dir)" != "$GIT_COMMON" ] && IN_WORKTREE=1
HERE_BRANCH="$(git rev-parse --abbrev-ref HEAD)"

g() { git -C "$MONO" "$@"; }

# A branch is merge-ready iff it already contains main (so the merge is a pure
# fast-forward) and has commits main doesn't. `--ff-only` re-checks this at
# merge time; this is for auto-detection and for a legible refusal message.
merge_ready() {
  local ref="$1"
  g merge-base --is-ancestor main "$ref" 2>/dev/null || return 1
  [ "$(g rev-parse "$ref")" != "$(g rev-parse main)" ] || return 1
}

candidates() {
  local ref
  while IFS= read -r ref; do
    merge_ready "$ref" && printf '%s\n' "$ref"
  done < <(g for-each-ref --format='%(refname:short)' refs/heads/ | grep -v '^main$')
}

if [ "$LIST_ONLY" = 1 ]; then
  found="$(candidates || true)"
  if [ -z "$found" ]; then
    echo "land: nothing merge-ready (no branch both contains main and is ahead of it)"
  else
    echo "land: merge-ready branches:"
    while IFS= read -r ref; do
      printf '    %-40s +%s commits\n' "$ref" "$(g rev-list --count main.."$ref")"
    done <<< "$found"
  fi
  exit 0
fi

# Everything below can merge, so enforce the merge preconditions. `--list`
# exited above without them: reporting what's ready is read-only and stays
# useful from a dirty or non-main checkout.
CURRENT="$(g rev-parse --abbrev-ref HEAD)"
[ "$CURRENT" = "main" ] || die "main checkout is on '$CURRENT', not main — landing would mis-target. Switch it to main first.
    main checkout: $MONO"

if [ -n "$(g status --porcelain)" ]; then
  die "main checkout ($MONO) has uncommitted changes; refusing to merge into a dirty tree.
$(g status --short | sed 's/^/    /')"
fi

# Default, when run from inside a worktree, to that worktree's own branch —
# which is always the branch you mean. This is what keeps the common call a
# bare `bin/land`: an isolated agent must NOT write
# `bin/land "$(git rev-parse --abbrev-ref HEAD)"`, because the harness refuses
# any command carrying a `$(…)` substitution as "too complex to verify" (a
# separate refusal from the git-redirect block). Nothing to substitute, nothing
# to refuse. It also sidesteps the several-candidates ambiguity below.
if [ -z "$BRANCH" ] && [ "$IN_WORKTREE" = 1 ]; then
  [ "$HERE_BRANCH" = "HEAD" ] && die "this worktree has a detached HEAD — pass the branch name explicitly."
  BRANCH="$HERE_BRANCH"
  echo "land: landing this worktree's branch: $BRANCH"
fi

if [ -z "$BRANCH" ]; then
  found="$(candidates || true)"
  count="$(printf '%s' "$found" | grep -c . || true)"
  case "$count" in
    0) echo "land: nothing to land — no branch is merge-ready."
       echo "      A branch qualifies once it contains main and is ahead of it."
       echo "      Still working? Merge main into the worktree branch and re-verify there."
       exit 0 ;;
    1) BRANCH="$found"
       echo "land: auto-detected $BRANCH" ;;
    *) echo "land: $count branches are merge-ready — name the one you mean:" >&2
       while IFS= read -r ref; do printf '    bin/land %s\n' "$ref" >&2; done <<< "$found"
       exit 1 ;;
  esac
fi

g show-ref --verify --quiet "refs/heads/$BRANCH" || die "no such local branch: $BRANCH"

if [ "$(g rev-parse "$BRANCH")" = "$(g rev-parse main)" ]; then
  echo "land: $BRANCH is already at main — nothing to land."
  exit 0
fi

if ! g merge-base --is-ancestor main "$BRANCH"; then
  die "$BRANCH does not contain current main — this would not be a fast-forward.
  Main moved (another finish probably landed). Resolve it in the WORKTREE, not here:
    git merge main    # from the worktree, then re-run verification
  then run: bin/land $BRANCH"
fi

AHEAD="$(g rev-list --count main.."$BRANCH")"

if [ "$DRY_RUN" = 1 ]; then
  echo "land: would fast-forward main to $BRANCH (+$AHEAD commits)"
  g log --oneline "main..$BRANCH" | sed 's/^/    /'
  echo "land: dry run — nothing merged"
  exit 0
fi

g merge --ff-only "$BRANCH"

echo
echo "land: main → $(g rev-parse --short HEAD) (+$AHEAD commits from $BRANCH)"
g log --oneline -3 | sed 's/^/    /'
echo
echo "land: the post-merge hook handles deploy for deployed paths."
echo "land: the worktree cleans up on session exit / next SessionStart sweep."
