#!/usr/bin/env bash
# land — Merge a finished worktree branch onto main (--no-ff). Runs from anywhere.
#
# Why this exists: one place that resolves the main checkout (from
# `--git-common-dir`), enforces main-clean and on-`main`, and merges `--no-ff`,
# so a landing is the same command from a worktree, from the main checkout, or
# from a Codex session — whose sandbox cannot git the main checkout at all.
# (Managed Claude sessions are NOT isolated from the main checkout: they don't
# use native `claude --worktree`, which is what carries that isolation. An
# earlier version of this comment claimed otherwise; corrected 2026-08-25.)
#
# There is nothing to *resolve* in main. `/finish` merges main INTO the
# worktree and re-verifies there, so landing itself never needs conflict
# resolution — it always merges cleanly. It merges with `--no-ff`, so a
# merge commit `Merge branch 'worktree-<name>'` always lands on main, keeping
# one visible entry per landing in `git log --first-parent main` (commit
# provenance: what a stream brought is `<merge>^1..<merge>^2`). If the branch
# doesn't already contain main, this refuses — main moved, and the fix
# belongs back in the worktree (merge main in, re-verify, retry), never here.
#
# Usage:
#   bin/land                 # from a worktree: land THIS worktree's branch
#                            # from main: auto-detect the single merge-ready branch
#   bin/land <branch>        # land a specific branch
#   bin/land --dry-run [..]  # preflight + report, merge nothing
#   bin/land --list          # show every merge-ready branch and exit
#   bin/land --allow-dirty-main [..]
#                            # land even though the main checkout has
#                            # uncommitted changes — only when those changes
#                            # touch no path the merge touches
#
# `--allow-dirty-main` exists because the main checkout is also where issue
# maintenance and doc close-outs get done, so it is routinely mid-edit while a
# worktree is ready to land, and that edit is usually someone else's to commit.
# It is not a blanket override. It permits exactly what git itself tolerates:
# unstaged modifications and untracked files on paths the merge does not touch.
# It still refuses on
#   - any overlap between a dirty path and a path the merge changes;
#   - any STAGED change (index ahead of HEAD), because git's merge refuses
#     whenever an index entry disagrees with HEAD for a path it walks, even one
#     whose content the merge would leave alone — a staged rename of an
#     untouched file is enough. Without this check the flag would promise a
#     landing and then hand back git's own refusal.
#
# Call it bare from a worktree; don't build the branch name with `$(…)`, which
# an isolated session refuses as "too complex to verify".
#
# Exit codes: 0 landed (or clean no-op), 1 refused.

set -euo pipefail

DRY_RUN=0
LIST_ONLY=0
ALLOW_DIRTY_MAIN=0
BRANCH=""

die() { printf 'land: %s\n' "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --list)    LIST_ONLY=1 ;;
    --allow-dirty-main) ALLOW_DIRTY_MAIN=1 ;;
    # Print the header comment block, however long it grows: every line after
    # the shebang until the first non-comment. A fixed line range silently
    # truncates the help the moment the header is edited.
    -h|--help) awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; exit 0 ;;
    -*)        die "unknown option: $1" ;;
    *)
      [ -n "$BRANCH" ] && die "expected at most one branch, got '$BRANCH' and '$1'"
      BRANCH="$1"
      ;;
  esac
  shift
done

git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"

# Resolve the main checkout rather than assuming cwd is it. A linked worktree
# and the main checkout share one git dir: --git-common-dir points at the main
# checkout's .git from either, so its parent is the main working tree. Every
# git call below targets $MONO explicitly, which is what lets this run
# unchanged from the main checkout or from inside a worktree.
GIT_COMMON="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
MONO="$(dirname "$GIT_COMMON")"
[ -d "$MONO/.git" ] || die "could not resolve the main checkout (got '$MONO')"
LAND_SOURCE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Are we inside a linked worktree? In the main checkout --absolute-git-dir and
# --git-common-dir agree; in a worktree they diverge. Used only to pick the
# default branch below.
IN_WORKTREE=0
[ "$(git rev-parse --absolute-git-dir)" != "$GIT_COMMON" ] && IN_WORKTREE=1
HERE_BRANCH="$(git rev-parse --abbrev-ref HEAD)"

g() { git -C "$MONO" "$@"; }

# A branch is merge-ready iff it already contains main (so a `--no-ff` merge
# is guaranteed conflict-free) and has commits main doesn't. The precondition
# checks below re-verify this at merge time; this is for auto-detection and
# for a legible refusal message.
merge_ready() {
  local ref="$1"
  g merge-base --is-ancestor main "$ref" 2>/dev/null || return 1
  [ "$(g rev-parse "$ref")" != "$(g rev-parse main)" ] || return 1
}

candidates() {
  local ref
  while IFS= read -r ref; do
    merge_ready "$ref" && printf '%s\n' "$ref"
  done < <(g for-each-ref --format='%(refname:short)' refs/heads/ | grep -v '^main$')
}

if [ "$LIST_ONLY" = 1 ]; then
  found="$(candidates || true)"
  if [ -z "$found" ]; then
    echo "land: nothing merge-ready (no branch both contains main and is ahead of it)"
  else
    echo "land: merge-ready branches:"
    while IFS= read -r ref; do
      printf '    %-40s +%s commits\n' "$ref" "$(g rev-list --count main.."$ref")"
    done <<< "$found"
  fi
  exit 0
fi

# Everything below can merge, so enforce the merge preconditions. `--list`
# exited above without them: reporting what's ready is read-only and stays
# useful from a dirty or non-main checkout.
CURRENT="$(g rev-parse --abbrev-ref HEAD)"
[ "$CURRENT" = "main" ] || die "main checkout is on '$CURRENT', not main — landing would mis-target. Switch it to main first.
    main checkout: $MONO"

MAIN_DIRTY=0
if [ -n "$(g status --porcelain)" ]; then
  if [ "$ALLOW_DIRTY_MAIN" = 0 ]; then
    die "main checkout ($MONO) has uncommitted changes; refusing to merge into a dirty tree.
$(g status --short | sed 's/^/    /')
    Someone is working there. Wait for them, or — if their changes touch nothing
    this merge touches — re-run with --allow-dirty-main, which checks exactly that."
  fi
  MAIN_DIRTY=1
fi

# Staged changes are the ones git will not merge around — see the header.
if [ "$MAIN_DIRTY" = 1 ] && ! g diff --cached --quiet; then
  die "main checkout ($MONO) has STAGED changes; --allow-dirty-main cannot cover those.
$(g diff --cached --name-status | sed 's/^/    /')
    git refuses to merge whenever the index disagrees with HEAD for a path it
    walks, even one this merge would not change. Commit or unstage that work
    first — it belongs to whoever staged it."
fi

# Every path the dirty main checkout has an opinion about. `-z` so a path with
# a space or non-ASCII character arrives verbatim instead of git-quoted, which
# a `--porcelain` parse would have had to guess at. Both halves of a rename or
# copy count: the merge must touch neither the old nor the new name.
dirty_paths() {
  local entry status path
  while IFS= read -r -d '' entry; do
    status="${entry:0:2}"
    path="${entry:3}"
    printf '%s\n' "$path"
    case "$status" in
      R*|C*|*R|*C) IFS= read -r -d '' path && printf '%s\n' "$path" ;;
    esac
  done < <(g status --porcelain -z)
}

# Default, when run from inside a worktree, to that worktree's own branch —
# which is always the branch you mean. This is what keeps the common call a
# bare `bin/land`: an isolated agent must NOT write
# `bin/land "$(git rev-parse --abbrev-ref HEAD)"`, because the harness refuses
# any command carrying a `$(…)` substitution as "too complex to verify" (a
# separate refusal from the git-redirect block). Nothing to substitute, nothing
# to refuse. It also sidesteps the several-candidates ambiguity below.
if [ -z "$BRANCH" ] && [ "$IN_WORKTREE" = 1 ]; then
  [ "$HERE_BRANCH" = "HEAD" ] && die "this worktree has a detached HEAD — pass the branch name explicitly."
  BRANCH="$HERE_BRANCH"
  echo "land: landing this worktree's branch: $BRANCH"
fi

if [ -z "$BRANCH" ]; then
  found="$(candidates || true)"
  count="$(printf '%s' "$found" | grep -c . || true)"
  case "$count" in
    0) echo "land: nothing to land — no branch is merge-ready."
       echo "      A branch qualifies once it contains main and is ahead of it."
       echo "      Still working? Merge main into the worktree branch and re-verify there."
       exit 0 ;;
    1) BRANCH="$found"
       echo "land: auto-detected $BRANCH" ;;
    *) echo "land: $count branches are merge-ready — name the one you mean:" >&2
       while IFS= read -r ref; do printf '    bin/land %s\n' "$ref" >&2; done <<< "$found"
       exit 1 ;;
  esac
fi

g show-ref --verify --quiet "refs/heads/$BRANCH" || die "no such local branch: $BRANCH"

if [ "$(g rev-parse "$BRANCH")" = "$(g rev-parse main)" ]; then
  echo "land: $BRANCH is already at main — nothing to land."
  exit 0
fi

if ! g merge-base --is-ancestor main "$BRANCH"; then
  die "$BRANCH does not contain current main — merging it now could conflict.
  Main moved (another finish probably landed). Resolve it in the WORKTREE, not here:
    git merge main    # from the worktree, then re-run verification
  then run: bin/land $BRANCH"
fi

# Validate the branch's committed candidate tree before dry-run reporting or
# merging. Never read the caller's working tree: it may be a different linked
# worktree, and main must remain untouched when this refuses.
(cd "$LAND_SOURCE_ROOT" && node --import tsx bin/doc-lifecycle-check.ts --repo "$MONO" --tree "$BRANCH") ||
  die "$BRANCH has document lifecycle errors; main was not changed"

# The dirty main checkout is only tolerable if this merge leaves those paths
# alone. `--no-renames` so a renamed file is listed under both names, and both
# sides are sorted for `comm`.
if [ "$MAIN_DIRTY" = 1 ]; then
  overlap="$(comm -12 \
    <(dirty_paths | sort -u) \
    <(g diff --no-renames --name-only main "$BRANCH" | sort -u))"
  if [ -n "$overlap" ]; then
    die "main checkout ($MONO) has uncommitted changes to paths this merge also changes:
$(printf '%s\n' "$overlap" | sed 's/^/    /')
    Merging would collide with work in progress. Commit or stash it first."
  fi
  echo "land: main checkout is dirty, but no dirty path is touched by this merge:"
  dirty_paths | sort -u | sed 's/^/    /'
fi

AHEAD="$(g rev-list --count main.."$BRANCH")"

if [ "$DRY_RUN" = 1 ]; then
  echo "land: would merge $BRANCH into main with --no-ff (+$AHEAD commits)"
  g log --oneline "main..$BRANCH" | sed 's/^/    /'
  echo "land: dry run — nothing merged"
  exit 0
fi

g merge --no-ff --no-edit "$BRANCH"

echo
echo "land: main → $(g rev-parse --short HEAD) (merge commit, +$AHEAD commits from $BRANCH)"
g log --oneline -3 | sed 's/^/    /'
echo
echo "land: the post-merge hook still handles deploy for deployed paths (fires on any merge that updates main, --no-ff included)."
echo "land: the worktree cleans up on session exit / next SessionStart sweep."
