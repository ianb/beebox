---
title: Implementation Order
---
graph TD
    classDef chore fill:#e8e8e8,stroke:#999,color:#333
    classDef infra fill:#4a90d9,stroke:#2c5f8a,color:#fff
    classDef build fill:#6ab04c,stroke:#3d7a2a,color:#fff
    classDef big fill:#e17055,stroke:#b33a1a,color:#fff
    classDef future fill:#fff,stroke:#aaa,color:#888,stroke-dasharray: 5 5

    subgraph W1[" Week 1: Chores + Test Core "]
        direction LR
        OVM["Overmind\n30 min"]:::chore
        EXE["execa swap\nhalf day"]:::chore
        SAN["sanitize-filename\n1 hour"]:::chore
        T1["TEST FRAMEWORK CORE\nexpect + serializers + TAP\n2-3 days"]:::infra
        OVM --> T1
        EXE --> T1
        SAN --> T1
    end

    subgraph W2[" Week 2: Prove the Framework "]
        direction LR
        T2["JSDoc @example\nextraction\n1 day"]:::infra
        UTIL["Utility swaps\nas proving ground\nhtml-entities, date-fns,\nky, proper-lockfile"]:::build
    end

    subgraph W3[" Week 3: Remark Pipeline "]
        direction LR
        REM["remark/unified\npipeline\n3-5 days"]:::build
        REH["rehype-highlight\ntrivial"]:::build
        REM --> REH
    end

    subgraph W4[" Week 4+: Big Migrations "]
        direction LR
        T3["Markdown literate\ntests\n1 day"]:::infra
        XST["XState migration\npage by page\nongoing"]:::big
        MOB["Remove mobx\nzustand"]:::future
        XST --> MOB
    end

    T1 --> T2
    T1 --> UTIL
    T2 --> REM
    UTIL --> REM
    REM --> T3
    T3 --> XST
    UTIL --> XST

    style W1 fill:#fafafa,stroke:#ccc,color:#333
    style W2 fill:#fafafa,stroke:#ccc,color:#333
    style W3 fill:#fafafa,stroke:#ccc,color:#333
    style W4 fill:#fafafa,stroke:#ccc,color:#333
