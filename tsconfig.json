{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // bin/ runs under tsx / native type stripping, where an explicit `.ts`
    // specifier is the thing that actually resolves (see bin/test-graph.ts
    // importing agent-doctest's resolve-rules). Same reason as
    // beebox/tsconfig.user-stories.json.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023"],
    "types": ["node", "@fastify/cookie"]
  },
  "include": ["feedback-review/eslint.config.ts", "eslint.config.ts", "bin/**/*.ts", "schedules/**/*.ts"],
  "exclude": ["node_modules", "beebox", "cardworks", "agent-doctest", "canvas-loop", "beebox-clerk", "browse"]
}
