{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // bin/ runs under tsx / native type stripping, where an explicit `.ts`
    // specifier is the thing that actually resolves (see bin/test-graph.ts
    // importing ./lib/resolve-rules.ts).
    "allowImportingTsExtensions": true,
    "lib": ["ES2023"],
    "types": ["node", "@fastify/cookie"]
  },
  "include": ["feedback-review/**/*.ts", "eslint.config.ts", "bin/**/*.ts", "schedules/**/*.ts", "workstreams-app/src/router/**/*.ts", "research/audio-understanding-bakeoff/*.ts", "research/tts-model-comparison/*.ts"],
  "exclude": ["node_modules", "beebox", "cardworks", "tap-check", "canvas-loop", "beebox-clerk", "browse"]
}
