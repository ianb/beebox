{
  "name": "@ianbicking/personal-vibe-check",
  "version": "0.1.0",
  "description": "Reusable TypeScript/React lint and static analysis preset",
  "type": "module",
  "exports": {
    "./eslint": "./eslint.config.mjs",
    "./plugin": "./plugin.mjs",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./knip-base.json": "./knip-base.json",
    "./prettier": "./prettier.config.mjs"
  },
  "bin": {
    "vibe-check": "./bin/vibe-check.mjs",
    "vibe-init": "./bin/vibe-init.mjs"
  },
  "files": [
    "eslint.config.mjs",
    "plugin.mjs",
    "prettier.config.mjs",
    "tsconfig.base.json",
    "knip-base.json",
    "CONVENTIONS.md",
    "INSTALL.md",
    "bin/",
    "hooks/",
    "rules/"
  ],
  "peerDependencies": {
    "typescript": ">=5"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.39.2",
    "eslint-config-agent": "^1.9.3",
    "eslint-plugin-class-export": "^1.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "prettier": "^3.5.3",
    "typescript": ">=5",
    "typescript-eslint": "^8.55.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "patch-package": "^8.0.0"
  },
  "license": "ISC",
  "author": "Ian Bicking",
  "scripts": {
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "lint:oxlint": "oxlint -A no-unused-vars",
    "lint:knip": "knip",
    "lint:circular": "madge --circular --extensions ts,tsx src/",
    "test": "node --test rules/test/*.test.mjs"
  }
}
