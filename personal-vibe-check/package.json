{
  "name": "@ianbicking/personal-vibe-check",
  "version": "0.6.0",
  "description": "Reusable TypeScript/React lint and static analysis preset",
  "type": "module",
  "exports": {
    "./eslint": {
      "types": "./types.d.ts",
      "default": "./preset.ts"
    },
    "./plugin": "./plugin.ts",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./knip-base.json": "./knip-base.json",
    "./prettier": "./prettier.config.ts"
  },
  "bin": {
    "vibe-check": "./bin/vibe-check.ts",
    "vibe-init": "./bin/vibe-init.ts"
  },
  "files": [
    "preset.ts",
    "preset/",
    "types.d.ts",
    "plugin.ts",
    "prettier.config.ts",
    "tsconfig.base.json",
    "knip-base.json",
    "conventions.md",
    "install.md",
    "bin/",
    "hooks/",
    "rules/"
  ],
  "peerDependencies": {
    "typescript": ">=5"
  },
  "dependencies": {
    "eslint": "^9.39.2",
    "eslint-plugin-default": "^1.1.0",
    "eslint-plugin-error": "^1.3.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.5.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.55.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "license": "MIT",
  "author": "Ian Bicking",
  "scripts": {
    "format": "prettier --write \"**/*.{ts,json}\"",
    "format:check": "prettier --check \"**/*.{ts,json}\"",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
    "lint:oxlint": "oxlint -A no-unused-vars",
    "lint:knip": "knip",
    "lint:circular": "oxlint -f default -c .oxlint-cycles.json preset.ts plugin.ts preset/ rules/ bin/",
    "test": "node --test rules/test/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
