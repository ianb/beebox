    "d3": "^7.9.0",
    "p5": "^2.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-compiler-runtime": "1.0.0",
    "react-dom": "^18.3.1",
    "react-textarea-autosize": "^8.5.9",
