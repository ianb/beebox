    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.2",
    "happy-dom": "20.14.6",
    "madge": "^8.0.0",
    "postcss": "^8.5.0",
