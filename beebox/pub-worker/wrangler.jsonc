{
  // Cloudflare Worker that serves box-managed publications from R2. The box
  // server uploads the bundled Worker directly with its own per-publication or
  // shared-host bindings (`src/services/managed-publication-runtime/worker-deployer.ts`);
  // this config is what the vitest-pool-workers suite runs against (miniflare
  // supplies a local R2). It binds no serving mode, so a request through it
  // exercises the unconfigured fail-closed path.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pub-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-06",
  // Publication content is data in R2, never bundled into the Worker.
  "r2_buckets": [
    {
      "binding": "PUB_STORE",
      "bucket_name": "pub-store",
      "preview_bucket_name": "pub-store"
    }
  ],
  // Empty Access placeholders → account tiers fail closed (404: not configured).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "PUB_WORKER_VERSION": ""
  },
  "preview_urls": false,
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
