# Example env file for a beebox checkout. Copy to `.env` and fill in
# only what you need — every var below is optional; the box runs without any
# of them, with the associated feature degraded (noted per-var).
#
# ANTHROPIC_API_KEY is deliberately NOT listed here and is stripped if set
# (src/cli/bootstrap.ts, src/core/script-env.ts) — this box authenticates
# with Claude via subscription login (`claude auth login`), not an API key.

# OpenAI key for realtime/Whisper transcription and TTS.
# optional — OpenAI transcription and text-to-speech degrade without it.
THINKING_OPENAI_API_KEY=

# Deepgram key + project for voice transcription.
# optional — Deepgram transcription degrades without it.
BBX_DEEPGRAM_API_KEY=
BBX_DEEPGRAM_PROJECT=

# Mistral (Voxtral) key, a transcription fallback.
# optional — Mistral transcription degrades without it.
BBX_MISTRAL_API_KEY=

# Gemini key — optional. Used for audio questions (ask-about-audio) and for
# scan-import's opt-in Gemini backend (BBX_SCAN_VISION=gemini). scan-import
# defaults to Claude via the agent SDK, which needs no extra key.
GEMINI_KEY=

# Web Push (VAPID) keys, for browser/PWA push notifications.
# Generate once with: npx web-push generate-vapid-keys
# optional — push notifications degrade without them.
BBX_VAPID_PUBLIC_KEY=
BBX_VAPID_PRIVATE_KEY=
# VAPID contact URI (mailto: or https:); defaults to PUBLIC_URL.
# optional — push notifications degrade without it.
BBX_VAPID_SUBJECT=

# Google OAuth client, for Google connector auth (Calendar, etc.).
# optional — Google-account auth and connectors degrade without them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Docker install only: skip the start-time convergence pass (bbx migrate
# --sweep + bbx docs refresh) that puts the box on the engine about to serve
# it. Set to 1 to run those yourself instead — see docs/docker-install.md.
# optional — leave unset to converge on every start.
BBX_SKIP_CONVERGE=
