plugin:
  - "!@tapjs/typescript"
node-arg:
  # Node's bundled `punycode` (DEP0040) is hit by transitive deps; the warning
  # fires per subprocess and otherwise spams test output dozens of times.
  - --disable-warning=DEP0040
  - --import=tsx
  # Isolate every home-relative state/config path, including the migration
  # boundary reached by child CLI processes before command dispatch. This is a
  # TypeScript preload, so it must follow the tsx loader.
  - --import=./test/helpers/isolate-user-home.ts
  - --import=agent-doctest/tap
  - --import=agent-doctest/loader
  # Point BBX_SECRETS_FILE at a throwaway path in every test process, so nothing
  # a test resolves or writes can reach the developer's real
  # ~/.config/bbx/secrets.json. See the module for why this is process-level.
  - --import=./test/helpers/isolate-secret-store.ts
  # Same for the machine-level credential store (~/.bbx-auth.json) and the
  # persisted session secret; see the helper's header.
  - --import=./test/helpers/isolate-auth-file.ts
  # Same reason, for the machine's origin id: every husk a test creates records
  # it, so an unisolated run would mint or read ~/.local/share/bbx/origin-id.
  - --import=./test/helpers/isolate-origin-id.ts
  # Same reason, for the machine's Codex state: one test starts a codex-engine
  # chat, and the plugin installer behind it re-points the GLOBAL `beebox`
  # marketplace at whichever checkout is running. See the module.
  - --import=./test/helpers/isolate-codex-home.ts
include:
  - test/**/*.test.ts
  - test/**/*.doctest.md
exclude:
  - test/manual/**
# Cap parallel test files. tap defaults to one job per core (12 here), but route
# doctests can call makeTestServer() dozens of times. Each test process builds
# one initialized template box (scaffoldV2Box() plus one shell that initializes
# and commits its Git repository), then fs.cp()-clones that template per call.
# A 2026-08 loaded-machine probe measured 1.0s cold boot and 0.39s mean warm
# boot. Under full-core parallelism, concurrent app boots and test work have
# historically thrashed the machine into non-deterministic SIGALRM timeouts.
# Half the cores bounds that contention while keeping the suite reasonably fast.
# The loaded-machine probe has now been run (2026-09-15), from the ledger's own
# records: with a second run holding a semaphore slot, a full-mode file takes
# 1.69x longer at the median, 3.05x at p90 and 6.03x at worst, across 805 files.
# This number is right for ONE run and wrong for two — two slots at 6 jobs is
# twelve tap processes on twelve logical cores, leaving nothing for the dev
# router, the hubs, or the agent sessions. Rather than lowering it for everyone
# (642 of 756 recorded runs were solo), `capJobs` in bin/test-tiers.ts halves
# the fan-out for a FULL run that starts while another holds a slot.
jobs: 6
# Per-file timeout. In the 2026-08 sample, routes-api took 6.3s solo and the
# slowest sampled solo file took 24.9s, while loaded timings inflated sharply
# (for example, hub-e2e rose from 8.4s solo to 110.8s). Those measurements do
# not establish a safe lower timeout under contention. Five minutes preserves
# headroom for heavily loaded runs without masking a genuine hang indefinitely.
timeout: 300
# Agent-first output: the consumers of test runs here are coding agents
# reading through a pipe, not humans at a TTY. The plain `tap` reporter with
# color off emits zero ANSI/cursor codes and full YAML failure diagnostics
# (diff, file, line). Interactive reporters (`min`, `terse`, `base`) write
# cursor-control sequences even when piped, which render as garbage.
reporter: tap
color: false
# Don't collect or gate on coverage by default. tap's unconfigured default is to
# enforce 100% line/branch/function coverage, but this repo sets no thresholds
# and many long-standing files sit well below 100% — so `tap` exited non-zero on
# the coverage gate even when all 2231 tests passed, and printed a ~40-line
# coverage table on every run (noise, per the monorepo's "noisy output is a bug"
# rule). Coverage has never actually gated here (the pre-commit hook runs
# typecheck + lint, not `tap`). Disable it by default so a green suite exits 0
# and stays quiet; run `tap --coverage` ad hoc when you want a coverage report.
disable-coverage: true
