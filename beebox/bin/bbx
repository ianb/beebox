#!/usr/bin/env bash
# Bee Box CLI wrapper.
#
# Runs a bundled, single-file build of the CLI (dist/cli.mjs) for fast cold
# starts. The bundle collapses the source module graph into one file, avoiding
# the per-module tsx loader-hook overhead that makes plain `tsx src/cli` slow.
#
# Three modes:
#   - Packed (installed as a dependency, e.g. `node_modules/beebox`):
#     `scripts/` and `src/` aren't shipped (see package.json's `files`
#     allowlist / `docs/implemented-plans/boxes-as-packages-v2.md` Track F) — there is
#     nothing to rebuild from and no tsx fallback to degrade to, so this mode
#     is detected by `scripts/build-cli.ts`'s absence and just runs the
#     bundle unconditionally. A missing bundle here is a broken install, not
#     a staleness problem — error out rather than silently trying a rebuild
#     that can't succeed.
#   - Prod checkout (BBX_CLI_PREBUILT set): trust the bundle, no staleness check.
#   - Dev checkout (default): self-heal — rebuild the bundle when any backend
#     source is newer than it, then run it. If a build ever fails, fall back
#     to tsx so `bbx` always works.

# Resolve symlinks to get the real script location
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  # If $SOURCE was a relative symlink, resolve it relative to the symlink's directory
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

BUNDLE="$PROJECT_DIR/dist/cli.mjs"
# Never inherit another bbx process's artifact identity. Only this invocation's
# dev path may opt the process it execs into reload detection.
unset BBX_DEV_BUNDLE_PATH BBX_DEV_BUNDLE_ID
# V8 compile cache — caches bytecode of the bundle across runs (~20% faster).
export NODE_COMPILE_CACHE="$PROJECT_DIR/dist/.compile-cache"

run_bundle() {
  exec node --disable-warning=DEP0040 --enable-source-maps "$BUNDLE" "$@"
}

stamp_dev_bundle() {
  export BBX_DEV_BUNDLE_PATH="$BUNDLE"
  export BBX_DEV_BUNDLE_ID
  BBX_DEV_BUNDLE_ID="$(node -e 'const fs=require("fs"); const s=fs.statSync(process.argv[1], {bigint:true}); process.stdout.write(`${s.dev}:${s.ino}:${s.size}:${s.mtimeNs}`)' "$BUNDLE")"
}

run_tsx() {
  # Resolve tsx's real install dir rather than assuming it sits in this
  # package's own node_modules. Under the pnpm workspace (node-linker=hoisted)
  # tsx is hoisted to the workspace-root node_modules, not beebox's — so
  # a hardcoded ./node_modules/tsx path is wrong on the server (and anywhere
  # the workspace hoists). require.resolve walks up from PROJECT_DIR and finds
  # it wherever it landed. This is the build-failure fallback only — prod
  # normally runs the bundle (the deploy ships a fresh dist/cli.mjs that's
  # newer than every source, so the staleness scan below is a no-op).
  local tsx_dir
  tsx_dir="$(node -e "process.stdout.write(require('path').dirname(require.resolve('tsx/package.json',{paths:['$PROJECT_DIR']})))")"
  exec node \
    --disable-warning=DEP0040 \
    --import "file://$PROJECT_DIR/tsx-preload.mjs" \
    --require "$tsx_dir/dist/preflight.cjs" \
    --import "file://$tsx_dir/dist/loader.mjs" \
    "$PROJECT_DIR/src/cli/index.ts" "$@"
}

# Packed fast path: no scripts/build-cli.ts means this is an installed
# package (npm/pnpm `files` allowlist excludes scripts/ and src/), not a
# dev checkout — there's no source tree to scan for staleness and no build
# script to fall back to, so just run the bundle. Ahead of the
# BBX_CLI_PREBUILT check because a packed install should behave this way
# regardless of whether that env var happens to be set.
if [ ! -f "$PROJECT_DIR/scripts/build-cli.ts" ]; then
  if [ -f "$BUNDLE" ]; then
    run_bundle "$@"
  fi
  echo "bbx: $BUNDLE is missing from this installed package — the install is broken (try reinstalling beebox)." >&2
  exit 1
fi

# Prod fast path: a deploy built the bundle and source won't change underneath
# us, so skip the staleness scan entirely.
if [ -n "$BBX_CLI_PREBUILT" ] && [ -f "$BUNDLE" ]; then
  run_bundle "$@"
fi

# Dev: rebuild if the bundle is missing or any backend source (.ts, excluding
# the frontend tree, which is spawned separately and not in the bundle) is
# newer than it. Pruning src/frontend keeps this scan ~5ms even on a fresh
# bundle. package.json is checked too so dependency changes trigger a rebuild.
needs_build=0
if [ ! -f "$BUNDLE" ]; then
  needs_build=1
elif [ "$PROJECT_DIR/package.json" -nt "$BUNDLE" ]; then
  needs_build=1
elif [ -n "$(find "$PROJECT_DIR/src" -path "$PROJECT_DIR/src/frontend" -prune -o -name '*.ts' -newer "$BUNDLE" -print -quit 2>/dev/null)" ]; then
  needs_build=1
fi

if [ "$needs_build" = 1 ]; then
  if ! node "$PROJECT_DIR/scripts/build-cli.ts" >/dev/null 2>&1; then
    # Build failed — fall back to running source directly via tsx.
    run_tsx "$@"
  fi
fi

if [ -f "$BUNDLE" ]; then
  # Packed/prod paths returned above. Only a dev invocation identifies the
  # exact artifact it loaded so supervised long-lived processes can notice a
  # replacement (identity, not mtime ordering) at a safe boundary.
  if [ "$1" = "serve" ] || { [ "$1" = "scheduler" ] && [ "$2" = "start" ]; }; then
    stamp_dev_bundle
  fi
  run_bundle "$@"
else
  run_tsx "$@"
fi
