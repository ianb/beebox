# Deploy target — copy to `target.env` (gitignored) to make this checkout a
# machine that deploys with deploy/deploy.sh.
#
# This file is opt-in infrastructure, not the install path. If you are setting
# up a Bee Box, use the container flow in docs/docker-install.md instead; that
# is the supported install-and-update story. deploy.sh is an rsync-to-VPS
# pipeline for a host provisioned by deploy/hetzner/setup-server.sh, and this
# file tells it which host.
#
# With no target.env present, deploy.sh refuses and the root husky
# post-commit/post-merge hooks skip the deploy without comment.

# The server's IP or hostname. Required; everything else has a default.
# Prefer the IP: a proxied domain (Cloudflare) does not resolve to the origin.
BBX_DEPLOY_HOST=203.0.113.10

# SSH user for administration. Deploys chown into place, so this is root on a
# stock setup-server.sh host.
#BBX_DEPLOY_SSH_USER=root

# Where the source tree is rsynced to, and the service account that owns the
# boxes. Both are set by setup-server.sh; override only if you moved them.
#BBX_DEPLOY_INSTALL_DIR=/opt/beebox
#BBX_DEPLOY_SERVICE_USER=beebox
#BBX_DEPLOY_SERVICE_HOME=/home/beebox

# The port `bbx hub` listens on behind nginx, used by the prod-* diagnostics
# when they curl the server's own loopback.
#BBX_DEPLOY_HUB_PORT=3210

# The deployment's public base URL. Only prod-browse needs it (to scope the
# session cookie it sets in the local browser profile).
#BBX_DEPLOY_PUBLIC_URL=https://box.example.com

# Command run on deploy failure, as: <cmd> "<title>" "<message>". Optional —
# unset means no notification. Skipped entirely on an interactive run, where
# you can already see the output.
#BBX_DEPLOY_NOTIFY=beebox/deploy/notify-macos
