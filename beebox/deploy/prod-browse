#!/usr/bin/env bash
#
# prod-browse — open the deployed server as the configured owner in the clean
# browser profile used by bin/browse. The session cookie reaches that local
# profile but must never be persisted in the repository.
#
# IDENTITY BOUNDARY: this authenticates only as BBX_OWNER_EMAIL. Do not alter it
# to mint a session for another identity without the boxholder's express,
# in-the-moment permission. See deploy/README.md.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
. "$SCRIPT_DIR/resolve-server-ip.sh"

SERVER_IP=$(resolve_server_ip "$SCRIPT_DIR")
if ! PUBLIC_URL_FILE=$(resolve_deploy_file "$SCRIPT_DIR" public-url); then
  echo "Error: No production public URL found. Restore deploy/public-url in the main checkout." >&2
  exit 1
fi
PUBLIC_URL=$(cat "$PUBLIC_URL_FILE")

[ $# -ge 1 ] || { echo "usage: prod-browse <path>  (e.g. /box-family/)" >&2; exit 2; }
REQ_PATH="$1"

COOKIE=$(ssh -o ConnectTimeout=12 "root@$SERVER_IP" 'set -a; . /home/beebox/.env; set +a; if [[ -z "${BBX_OWNER_EMAIL:-}" ]]; then echo "Error: BBX_OWNER_EMAIL is unset in /home/beebox/.env." >&2; exit 1; fi; export BBX_SESSION_SECRET=$(cat /home/beebox/.bbx-session-secret); node -e "const c=require(\"crypto\");const e=process.env.BBX_OWNER_EMAIL;const s=process.env.BBX_SESSION_SECRET;const p=JSON.stringify({email:e,name:e,exp:Date.now()+2592000000});const sig=c.createHmac(\"sha256\",s).update(p).digest(\"hex\");process.stdout.write(Buffer.from(p).toString(\"base64url\")+\".\"+sig)"')

"$REPO_ROOT/bin/browse" cookies set bbx_session "$COOKIE" --url "$PUBLIC_URL" --httpOnly --secure --sameSite Lax >/dev/null
echo "opening ${PUBLIC_URL}${REQ_PATH} as owner — follow with: bin/browse screenshot" >&2
exec "$REPO_ROOT/bin/browse" open "${PUBLIC_URL}${REQ_PATH}"
