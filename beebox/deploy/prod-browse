#!/usr/bin/env bash
#
# prod-browse — open the deployed server as the configured owner in the clean
# browser profile used by bin/browse. The session cookie reaches that local
# profile but must never be persisted in the repository.
#
# IDENTITY BOUNDARY: this authenticates only as BBX_OWNER_EMAIL. Do not alter it
# to mint a session for another identity without the boxholder's express,
# in-the-moment permission. See deploy/README.md.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
# shellcheck source=beebox/deploy/deploy-target.sh
. "$SCRIPT_DIR/deploy-target.sh"
require_deploy_target "$SCRIPT_DIR"

if [[ -z "${BBX_DEPLOY_PUBLIC_URL:-}" ]]; then
  echo "Error: BBX_DEPLOY_PUBLIC_URL is unset in $BBX_DEPLOY_TARGET_FILE — prod-browse" >&2
  echo "  scopes the session cookie to it. See deploy/target.env.example." >&2
  exit 1
fi

[ $# -ge 1 ] || { echo "usage: prod-browse <path>  (e.g. /box-family/)" >&2; exit 2; }
REQ_PATH="$1"

COOKIE=$("$SCRIPT_DIR/prod-session-cookie" | node -e 'let d="";process.stdin.on("data",(c)=>d+=c).on("end",()=>process.stdout.write(JSON.parse(d).cookie))')

"$REPO_ROOT/bin/browse" cookies set bbx_session "$COOKIE" --url "$BBX_DEPLOY_PUBLIC_URL" --httpOnly --secure --sameSite Lax >/dev/null
echo "opening ${BBX_DEPLOY_PUBLIC_URL}${REQ_PATH} as owner — follow with: bin/browse screenshot" >&2
exec "$REPO_ROOT/bin/browse" open "${BBX_DEPLOY_PUBLIC_URL}${REQ_PATH}"
