#!/usr/bin/env bash
#
# prod-curl — fetch a deployed-server URL as the configured owner, bypassing
# the OAuth wall for production debugging. The signed cookie is minted and
# consumed on the server and is never written locally.
#
# IDENTITY BOUNDARY: this authenticates only as BBX_OWNER_EMAIL. Do not alter it
# to mint a session for another identity without the boxholder's express,
# in-the-moment permission. See deploy/README.md.
#
# Usage:
#   deploy/prod-curl /box-family/
#   deploy/prod-curl /test1/ -sI
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=beebox/deploy/deploy-target.sh
. "$SCRIPT_DIR/deploy-target.sh"
require_deploy_target "$SCRIPT_DIR"

[ $# -ge 1 ] || { echo "usage: prod-curl <path> [extra curl args...]" >&2; exit 2; }
REQ_PATH="$1"; shift
REMOTE_ARGS=$(printf '%q ' "$BBX_DEPLOY_SERVICE_HOME" "$BBX_DEPLOY_HUB_PORT" "$REQ_PATH" "$@")

ssh -o ConnectTimeout=12 "$BBX_DEPLOY_SSH_TARGET" "bash -s -- $REMOTE_ARGS" <<'REMOTE'
set -euo pipefail
SERVICE_HOME="$1"; shift
HUB_PORT="$1"; shift
REQ_PATH="$1"; shift
set -a; . "$SERVICE_HOME/.env"; set +a
if [[ -z "${BBX_OWNER_EMAIL:-}" ]]; then
  echo "Error: BBX_OWNER_EMAIL is unset in $SERVICE_HOME/.env." >&2
  exit 1
fi
BBX_SESSION_SECRET=$(cat "$SERVICE_HOME/.bbx-session-secret")
export BBX_SESSION_SECRET
COOKIE=$(node -e 'const c=require("crypto");const e=process.env.BBX_OWNER_EMAIL;const s=process.env.BBX_SESSION_SECRET;const p=JSON.stringify({email:e,name:e,exp:Date.now()+2592000000});const sig=c.createHmac("sha256",s).update(p).digest("hex");process.stdout.write(Buffer.from(p).toString("base64url")+"."+sig)')
exec curl -s "$@" -H "Cookie: bbx_session=$COOKIE" "http://127.0.0.1:${HUB_PORT}${REQ_PATH}"
REMOTE
