#!/usr/bin/env bash
# Install and configure the host's TURN relay for chat calls, then prove it relays.
#
#   bbx-turn-install <engine>     (as root; deploy.sh runs it every deploy)
#
# <engine> is the installed beebox package, /opt/beebox/beebox. One coturn
# serves every box on the host (docs/plans/self-hosted-turn.md). Its only input
# is the master secret store's `turn-server` entry, a JSON string
# {"secret": "<64 hex>", "urls": ["turn:<ip>:3478?transport=udp", ...]}: the
# same value boxes are granted to sign credentials (src/core/turn-server-key.ts).
#
#   - No entry: coturn is stopped and disabled if present. The host has no relay.
#   - An entry: install coturn from the distro, render /etc/turnserver.conf from
#     deploy/coturn/turnserver.conf plus the addresses and secret, restart it on
#     a change, and run a two-client allocation through the first IPv4 address.
#
# Refuses (exit 1) a value whose URLs name an address this host does not hold,
# so a moved host fails the deploy instead of handing out a dead relay.
# Idempotent; quiet on success and complete on failure.
set -euo pipefail
# The deploy's remote script runs with /home/beebox/.env's PATH, which omits /usr/sbin.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
if [[ $# -ne 1 ]]; then
  echo "usage: bbx-turn-install <engine>" >&2
  exit 64
fi
engine="$1"
readonly TEMPLATE="$engine/deploy/coturn/turnserver.conf"
readonly CONF=/etc/turnserver.conf
readonly HUB_ENV=/home/beebox/.env

log=$(mktemp)
rendered=$(mktemp)
trap 'rm -f "$log" "$rendered"' EXIT
# Run a command with its output kept back unless it fails.
quietly() {
  if ! "$@" > "$log" 2>&1; then
    echo "  FAILED: $*" >&2
    sed 's/^/    /' "$log" >&2
    return 1
  fi
}

[[ -f "$TEMPLATE" ]] || { echo "  FAILED: $TEMPLATE is missing" >&2; exit 1; }

# The master store, as deploy/add-box.sh finds it.
store=$(grep -E '^BBX_SECRETS_FILE=' "$HUB_ENV" 2> /dev/null | cut -d= -f2- || true)
store="${store:-/home/beebox/.config/beebox/secrets.json}"

installed() { dpkg-query -W -f='${Status}' coturn 2> /dev/null | grep -qx 'install ok installed'; }

# Prints the rendered config on stdout and the check's address, username and
# password on fd 3, or exits 3 when the store has no `turn-server` entry.
render() {
  STORE="$store" TEMPLATE_PATH="$TEMPLATE" ADDRS="$(ip -j addr)" python3 -I - <<'PY'
import base64, hashlib, hmac, ipaddress, json, os, re, sys, time

store_path = os.environ["STORE"]
if not os.path.exists(store_path):
    sys.exit(3)
with open(store_path) as f:
    entry = (json.load(f).get("secrets") or {}).get("turn-server") or {}
raw = entry.get("value")
if raw is None:
    sys.exit(3)

def fail(msg):
    print(f"  FAILED: turn-server: {msg}", file=sys.stderr)
    sys.exit(1)

try:
    value = json.loads(raw)
except json.JSONDecodeError as e:
    fail(f"not JSON ({e})")
secret, urls = value.get("secret"), value.get("urls")
if not isinstance(secret, str) or not re.fullmatch(r"[0-9a-f]{64}", secret):
    fail('"secret" must be 64 lowercase hex characters')
# The same shape src/core/turn-server-key.ts accepts.
url_re = re.compile(r"turn:(\d{1,3}(?:\.\d{1,3}){3}|\[[0-9A-Fa-f:]+\]):3478\?transport=(?:udp|tcp)")
if not isinstance(urls, list) or not urls:
    fail('"urls" must be a non-empty list')
hosts = []
for u in urls:
    m = url_re.fullmatch(u) if isinstance(u, str) else None
    if m is None:
        fail(f"bad URL {u!r}; expected turn:<ip>:3478?transport=udp|tcp")
    ip = ipaddress.ip_address(m.group(1).strip("[]"))
    if ip not in hosts:
        hosts.append(ip)

local = {
    ipaddress.ip_address(a["local"])
    for link in json.loads(os.environ["ADDRS"])
    for a in link.get("addr_info", [])
}
missing = [str(h) for h in hosts if h not in local]
if missing:
    fail(f"{', '.join(missing)} is not an address of this host; update the urls (host moved?)")
v4 = [h for h in hosts if h.version == 4]
if not v4:
    fail("needs at least one IPv4 URL")

with open(os.environ["TEMPLATE_PATH"]) as f:
    out = f.read()
out += "\n# Rendered by bbx-turn-install from the master store's turn-server entry.\n"
for h in hosts:
    out += f"listening-ip={h}\nrelay-ip={h}\n"
out += f"static-auth-secret={secret}\n"
sys.stdout.write(out)
# A ten-minute credential for the check, signed here so the shared secret never
# appears in a process's arguments (src/core/turn-server-key.ts, restCredentials).
username = f"{int(time.time()) + 600}:bbx-deploy-check"
password = base64.b64encode(hmac.new(secret.encode(), username.encode(), hashlib.sha1).digest()).decode()
with os.fdopen(3, "w") as check:
    check.write(f"{v4[0]} {username} {password}\n")
PY
}

set +e
check_line=$(render 3>&1 > "$rendered")
status=$?
set -e
if [[ $status -eq 3 ]]; then
  if installed && { systemctl is-enabled --quiet coturn 2> /dev/null || systemctl is-active --quiet coturn; }; then
    quietly systemctl disable --now coturn
    echo "  coturn stopped: the master store has no turn-server entry"
  fi
  exit 0
fi
[[ $status -eq 0 ]] || exit 1
read -r check_ip check_user check_password <<< "$check_line"

changed=0
if ! cmp -s "$rendered" "$CONF"; then
  # Before the package exists, so its first start already reads this config;
  # --force-confold keeps it over the packaged sample.
  install -o root -g root -m 0600 "$rendered" "$CONF.new"
  mv -f "$CONF.new" "$CONF"
  changed=1
fi
if ! installed; then
  quietly apt-get update -qq
  quietly env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq -o Dpkg::Options::=--force-confold coturn
  echo "  installed coturn"
  changed=1
fi
# coturn runs as turnserver and reads the config itself.
chown root:turnserver "$CONF"
chmod 0640 "$CONF"
quietly systemctl enable coturn
if [[ $changed -eq 1 ]] || ! systemctl is-active --quiet coturn; then
  quietly systemctl restart coturn
  echo "  coturn (re)started"
fi

# Two clients allocate relays and send to each other's relay address (the
# host's own IP), the path two relayed call members take.
check() {
  timeout 30 turnutils_uclient -y -n 2 -m 1 -l 120 -u "$check_user" -w "$check_password" "$check_ip"
}
for _ in 1 2 3 4 5; do
  # Success is the final tally with every sent message received; a run whose
  # allocations or permissions fail sends nothing and loses nothing.
  if check > "$log" 2>&1 && grep -Eq 'start_mclient: tot_send_msgs=([1-9][0-9]*), tot_recv_msgs=\1$' "$log"; then
    exit 0
  fi
  sleep 1
done
echo "  FAILED: coturn did not relay between two clients through $check_ip" >&2
sed 's/^/    /' "$log" >&2
exit 1
