#!/usr/bin/env bash
# Reconcile each package-layout box's node_modules with its manifest.
#
#   bbx-box-install <boxes root> <engine>
#
# A box's package.json declares react/react-dom/typescript (view compilation
# needs a box-owned react; src/webapp/views/compiler/compile.ts) and the engine
# as `"beebox": "link:.beebox/engine"`, a gitignored link this script points at
# <engine> (bin/box-engine-link). Left uninstalled, every view degrades to a
# "Failed to compile" stub with no visible error.
#
# A box is installed when it has no completed install on record, or when its
# package.json or pnpm-lock.yaml is newer than that record. The record is
# node_modules/.bbx-install-stamp, touched only after `pnpm install` exited 0
# and the engine link verified. Comparing against a dependency's own files does
# not work: a no-op `pnpm install` leaves them untouched, so a manifest a
# migration rewrote once looked newer forever and every deploy reinstalled
# every box (issues: per-box reinstall marker, 2026-10-22).
#
# One box's failure prints ERROR and the next box proceeds; the exit status is
# 0 unless the arguments are wrong. Each box is <boxes root>/<slug>/box, and
# installs and verification run as its user, bbx-<slug>, the account that must
# be able to run the result; root passes every permission check.
#
# A box's `.beebox/engine` points at a box-owned shim, <boxes root>/<slug>/
# .beebox-engine-{a,b}, not at <engine> itself. pnpm links the engine's bins
# into the box's node_modules/.bin and then chmods each bin target, and only a
# file's owner may chmod it: with the engine owned by `beebox`, every install
# as bbx-<slug> exited nonzero with EPERM, never wrote its stamp, and was
# retried on every deploy. In the shim every top-level engine entry is a
# symlink to <engine>, except that each bin package.json names is a box-owned
# script that execs the engine's own. The shim is rebuilt each pass in the slot
# the link does not use, then the link moves to it in one step.
#
# Each command runs under `umask 007`, the box unit's own UMask. `bash -l`
# otherwise takes the login umask 002, and node_modules came out 0775, open to
# every account on the host (cross-box-leak-scan, 2026-11-13). The top-level
# node_modules also loses its "other" bits on every pass, which repairs trees
# an older deploy left open. Only the top directory changes: the files under
# .pnpm are hard links into the shared store, and closing the top directory
# already blocks traversal.
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: bbx-box-install <boxes root> <engine>" >&2
  exit 2
fi
boxes_root="$1"
engine="$2"
link_check="$engine/bin/box-engine-link"
verify_as_owner() { sudo -u "$owner" -H bash -lc 'umask 007; "$0" verify "$1"' "$link_check" "$1"; }
close_modules() {
  [[ -d "$1/node_modules" ]] || return 0
  sudo -u "$owner" -H bash -lc 'chmod o-rwx "$0"' "$1/node_modules"
}
STAMP_NAME=".bbx-install-stamp"
# Run as the box owner: build the shim for <engine> beside <box> and print its path.
SHIM_SCRIPT=$(cat <<'SHIM'
set -euo pipefail
umask 007
engine="$1" box="$2"
case "$engine" in *"'"*) echo "engine path contains a quote: $engine" >&2; exit 1 ;; esac
home=$(dirname "$box")
current=$(readlink "$box/.beebox/engine" || true)
slot=a
[[ "$current" == "$home/.beebox-engine-a" ]] && slot=b
shim="$home/.beebox-engine-$slot"
rm -rf "$shim"
mkdir -p "$shim/bin"
bins=$(node -e '
  const path = require("path");
  const pkg = require(process.argv[1]);
  const bin = typeof pkg.bin === "string" ? { [pkg.name]: pkg.bin } : (pkg.bin || {});
  for (const target of Object.values(bin)) {
    const file = path.normalize(target);
    if (path.dirname(file) !== "bin") { console.error("engine bin outside bin/: " + target); process.exit(1); }
    console.log(path.basename(file));
  }
' "$engine/package.json")
shopt -s dotglob nullglob
for entry in "$engine"/*; do
  name=${entry##*/}
  [[ "$name" == bin ]] || ln -s "$entry" "$shim/$name"
done
for entry in "$engine"/bin/*; do
  name=${entry##*/}
  if grep -qxF -- "$name" <<<"$bins"; then
    printf '#!/bin/sh\nexec '"'"'%s'"'"' "$@"\n' "$entry" > "$shim/bin/$name"
    chmod 750 "$shim/bin/$name"
  else
    ln -s "$entry" "$shim/bin/$name"
  fi
done
echo "$shim"
SHIM
)


for box in "$boxes_root"/*/box/; do
  box="${box%/}"
  pj="$box/package.json"
  [[ -f "$pj" ]] || continue   # no manifest yet: nothing to install
  name=$(basename "$(dirname "$box")")
  owner="bbx-$name"

  if ! shim=$(sudo -u "$owner" -H bash -c "$SHIM_SCRIPT" _ "$engine" "$box"); then
    echo "  ERROR $name: could not build its engine shim; skipping its install." >&2
    continue
  fi
  if ! sudo -u "$owner" -H bash -lc 'umask 007; "$0" link "$1" "$2"' "$link_check" "$box" "$shim"; then
    echo "  ERROR $name: could not link .beebox/engine; skipping its install." >&2
    continue
  fi

  stamp="$box/node_modules/$STAMP_NAME"
  lock="$box/pnpm-lock.yaml"
  reason=""
  if [[ ! -e "$stamp" ]]; then
    reason="no completed install on record"
  elif [[ "$pj" -nt "$stamp" ]]; then
    reason="package.json changed since the last install"
  elif [[ "$lock" -nt "$stamp" ]]; then
    reason="pnpm-lock.yaml changed since the last install"
  elif ! verify_as_owner "$box" 2>/dev/null; then
    reason="the recorded install no longer verifies"
  fi
  close_modules "$box" || echo "  WARNING $name: could not remove other-access from node_modules." >&2
  # A box with nothing to do already verified above.
  [[ -n "$reason" ]] || continue
  echo "  $name: installing ($reason)..."
  # CI=true: without it pnpm aborts with no TTY when it decides node_modules
  # must be recreated (after a Node major upgrade, for one), and the box would
  # fail the same way on every deploy. The update banner is noise in a log.
  if ! sudo -u "$owner" -H bash -lc 'umask 007; cd "$0" && CI=true npm_config_update_notifier=false pnpm install' "$box"; then
    echo "  ERROR $name: pnpm install exited nonzero; see its output above." >&2
    continue
  fi
  if ! verify_as_owner "$box"; then
    echo "  ERROR $name: the box has no usable engine after install." >&2
    continue
  fi
  close_modules "$box" || echo "  WARNING $name: could not remove other-access from node_modules." >&2
  sudo -u "$owner" -H bash -lc 'umask 007; touch "$0"' "$stamp"
done
