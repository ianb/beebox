# The scheduler daemon: its own user, beebox-sched, with no box group and one
# sudo grant (bbx-box-run), running each box's pass as that box's user through
# beebox-pass@<slug>.service (docs/plans/per-box-units.md, Track E;
# docs/scheduler.md). Its manifest is ~/.config/beebox/boxes.json under
# /var/lib/beebox-sched. Installed whole by deploy.sh on every deploy.
[Unit]
Description=Bee Box Scheduler
After=network.target

[Service]
Type=simple
User=beebox-sched
Group=beebox-sched
ExecStart=/usr/local/bin/bbx engine scheduler start
WorkingDirectory=/var/lib/beebox-sched
EnvironmentFile=/etc/beebox/box.env
KillMode=mixed
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
