# One scheduler pass for one box, as the box's user, inside the box sandbox.
# Started by `bbx-box-run <slug> scheduler-pass` (deploy/server-bin/bbx-box-run),
# the one root path the scheduler user may call; `systemctl start --wait` makes
# the caller block until the pass ends. Type=oneshot: there is nothing to keep
# running and nothing to restart. The sandbox is the box-sandbox.conf drop-in,
# shared with beebox-box@.service.
[Unit]
Description=Bee Box %i scheduler pass
RequiresMountsFor=/var/lib/beebox/%i

[Service]
Type=oneshot
User=bbx-%i
Group=bbx-%i
WorkingDirectory=/var/lib/beebox/%i/box
EnvironmentFile=/etc/beebox/box.env
ExecStart=/usr/local/bin/bbx engine scheduler pass /var/lib/beebox/%i/box
# A pass that outlives this is stuck, not slow: the tick's own budgets are far shorter.
TimeoutStartSec=1800
