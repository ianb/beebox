<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.beebox.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BBX_EXECUTABLE__</string>
    <string>engine</string>
    <string>backup</string>
    <string>run</string>
    <string>__BOX_ROOT__</string>
    <string>--scheduled</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__LOCAL_BIN__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIRECTORY__/backup.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIRECTORY__/backup.stderr.log</string>
</dict>
</plist>
