{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // No .d.ts emit: the backend runs via tsx and the frontend type-checks
    // against backend *source* (the @backend/* path alias), so nothing consumes
    // dist/*.d.ts. Declaration emit also makes tRPC subscription routers fail to
    // type-check (TS2742 — their inferred type references tRPC's internal
    // `unstable-core-do-not-import` and can't be portably named for a .d.ts).
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2023"],
    "types": ["node"],
    // The doctest runner (tap + tsx) uses THIS tsconfig, so a frontend module
    // it exercises can only be imported if every alias that module uses
    // resolves here. `@shared/*` is the one alias that's safe to mirror: it
    // points at src/shared, which is already in this program (rootDir src,
    // and only src/frontend is excluded) and is by definition isomorphic.
    // @backend/@core/@schemas stay unresolvable on purpose — a frontend module
    // reaching for those in a doctest is a boundary violation, not a config gap
    // (see src/frontend/tsconfig.json's note on the same aliases).
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    // `src/scripts/build-cli/build/bundle.ts` runs under plain `node` (native
    // type stripping, which resolves `./x.ts` literally and never remaps
    // `./x.js`), so it imports its TypeScript siblings with the `.ts`
    // extension; tsc rewrites those to `.js` on emit.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*"],
  // `src/schemas/*/list-entry.tsx` is a card type's LIST COMPONENT: frontend
  // code that lives beside its schema. It belongs to the frontend program (DOM
  // lib, JSX runtime, the frontend's own modules), not this one, and nothing
  // here may import it — see src/schemas/image/list-entry.tsx and
  // eslint.config.ts. `src/plugins/*/view.tsx` is a plugin's browser view
  // module, excluded for the same reason: the frontend program and
  // tsconfig.declarations.json (which emits its `.d.ts`) cover it.
  "exclude": ["node_modules", "dist", "src/frontend", "src/schemas/*/list-entry.tsx", "src/plugins/*/view.tsx"]
}
