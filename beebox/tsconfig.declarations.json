{
  // Declaration-only build for the public export surface (beebox/cards,
  // /schema, the plugin entries). /server has its own program,
  // tsconfig.declarations.server.json, because this one adds the DOM lib.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    // Plugin view modules (`src/plugins/*/view.tsx`) are browser code and may
    // use DOM types; the backend tsconfig excludes them, this one emits their
    // `view.d.ts`. The extra libs are additive for the other entries.
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  // `files` takes no globs: every plugin's `plugin.ts` and `view.tsx` emit to
  // dist/plugins/<name>/{plugin,view}.d.ts, the `types` targets of the
  // `./plugins/*` and `./plugins/*/view` exports. `src/types/view-widgets.d.ts`
  // is the ambient `beebox/view-widgets` a view imports.
  "include": ["src/plugins/*/plugin.ts", "src/plugins/*/view.tsx", "src/types/view-widgets.d.ts"],
  // `exclude` is inherited from tsconfig.json unless restated; the base
  // excludes `src/plugins/*/view.tsx`, which this program emits.
  "exclude": ["node_modules", "dist", "src/frontend", "src/schemas/*/list-entry.tsx"],
  "files": ["src/exports/cards.ts", "src/exports/schema.ts", "src/cards/plugin-definition.ts"]
}
